# Example compose for AEON-7 Qwen3.6 27B XS + DFlash on DGX Spark.
#
# Attribution:
#   Adapted from AEON-7/Qwen3.6-27B-AEON-Ultimate-Uncensored-DFlash
#   commit 67be1e0e8450a8f1ba68793563a1266ab7197363 (Apache-2.0).
#   Upstream source of truth:
#   https://github.com/AEON-7/Qwen3.6-27B-AEON-Ultimate-Uncensored-DFlash
#
# This file is an example for local ds4_on_spark experiments. Review upstream
# before production use, keep model downloads outside git, and do not put tokens
# or secrets in this file.
#
# Required local model paths:
#   AEON_TARGET_MODEL_PATH=/var/lib/ds4/models/aeon-qwen36-mmtp-xs
#   AEON_DFLASH_DRAFTER_PATH=/var/lib/ds4/models/qwen36-dflash

services:
  vllm:
    image: ${AEON_VLLM_IMAGE:-ghcr.io/aeon-7/vllm-aeon-ultimate-dflash:qwen36-v4}
    container_name: ${AEON_CONTAINER_NAME:-aeon-qwen36-dflash}
    restart: unless-stopped
    network_mode: host
    ipc: host
    ulimits:
      memlock: -1
    environment:
      VLLM_ALLOW_LONG_MAX_MODEL_LEN: "1"
      TORCH_CUDA_ARCH_LIST: "12.1a"
      PYTORCH_CUDA_ALLOC_CONF: "expandable_segments:True"
      TORCH_MATMUL_PRECISION: "high"
      NVIDIA_FORWARD_COMPAT: "1"
      NVIDIA_DISABLE_REQUIRE: "1"
      ENABLE_NVFP4_SM100: "0"
      VLLM_USE_FLASHINFER_MOE_FP4: "0"
      VLLM_TEST_FORCE_FP8_MARLIN: "0"
      VLLM_USE_FLASHINFER_SAMPLER: "1"
      VLLM_NVFP4_GEMM_BACKEND: "flashinfer-cutlass"
    volumes:
      - ${AEON_TARGET_MODEL_PATH:-/var/lib/ds4/models/aeon-qwen36-mmtp-xs}:/models/target:ro
      - ${AEON_DFLASH_DRAFTER_PATH:-/var/lib/ds4/models/qwen36-dflash}:/models/dflash-drafter:ro
    command:
      - vllm
      - serve
      - /models/target
      - --served-model-name
      - aeon-ultimate
      - qwen36-ultimate
      - aeon-fast
      - aeon-deep
      - aeon-ultimate-xs
      - --host
      - 0.0.0.0
      - --port
      - "8000"
      - --tensor-parallel-size
      - "1"
      - --dtype
      - auto
      - --quantization
      - modelopt
      - --kv-cache-dtype
      - auto
      - --max-model-len
      - ${AEON_MAX_MODEL_LEN:-256000}
      - --max-num-seqs
      - ${AEON_MAX_NUM_SEQS:-64}
      - --max-num-batched-tokens
      - ${AEON_MAX_NUM_BATCHED_TOKENS:-32768}
      - --gpu-memory-utilization
      - ${AEON_GPU_MEMORY_UTILIZATION:-0.75}
      - --enable-chunked-prefill
      - --enable-prefix-caching
      - --generation-config
      - vllm
      - --load-format
      - safetensors
      - --trust-remote-code
      - --enable-auto-tool-choice
      - --tool-call-parser
      - qwen3_coder
      - --reasoning-parser
      - qwen3
      - --attention-backend
      - flash_attn
      - --limit-mm-per-prompt
      - '{"image":4,"video":2}'
      - --mm-encoder-tp-mode
      - data
      - --mm-processor-cache-type
      - shm
      - --mm-shm-cache-max-object-size-mb
      - "256"
      - --speculative-config
      - '{"method":"dflash","model":"/models/dflash-drafter","num_speculative_tokens":15}'
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities:
                - gpu
