[Unit]
Description=Spark standalone worker (%i) (user)
Wants=network-online.target
After=network-online.target
ConditionPathExists=%h/.config/ds4/spark-%i.env

[Service]
Type=simple
WorkingDirectory=/
SyslogIdentifier=spark-user-worker-%i
EnvironmentFile=%h/.config/ds4/spark-%i.env

# Example unit for a Spark standalone worker (user-service). Review + adjust for your Spark install.
ExecStart=${SPARK_HOME}/bin/spark-class org.apache.spark.deploy.worker.Worker --webui-port ${SPARK_WORKER_WEBUI_PORT} ${SPARK_MASTER_URL}

Restart=on-failure
RestartSec=2
TimeoutStartSec=30
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal

# Keep user units minimal; add hardening once the runtime interface stabilizes.
NoNewPrivileges=true
PrivateTmp=true

UMask=0027
LimitNOFILE=1048576

[Install]
WantedBy=default.target

