[Unit]
Description=DS4 user strict TP=2+TP=3 preflight checks (%i)
Wants=network-online.target
After=network-online.target
OnFailure=ds4-support-bundle@%i.service
ConditionPathIsExecutable=%h/ds4/scripts/ops_ds4_env_check.sh
ConditionPathIsExecutable=%h/ds4/scripts/ops_tp23_readiness.sh

[Service]
Type=oneshot
WorkingDirectory=%h/ds4
SyslogIdentifier=ds4-user-preflight-tp23-strict-%i
Environment=DS4_INSTANCE=%i
EnvironmentFile=-%h/.config/ds4/ds4.env
EnvironmentFile=-%h/.config/ds4/ds4-%i.env

ExecStartPre=%h/ds4/scripts/ops_ds4_env_check.sh -%h/.config/ds4/ds4.env %h/.config/ds4/ds4-%i.env
ExecStart=%h/ds4/scripts/ops_tp23_readiness.sh --strict --self %i --env -%h/.config/ds4/ds4.env --env %h/.config/ds4/ds4-%i.env

StandardOutput=journal
StandardError=journal

RemainAfterExit=yes
TimeoutStartSec=240

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target

