[Unit]
Description=DS4 user preflight checks (%i)
Wants=network-online.target
After=network-online.target
ConditionPathIsExecutable=%h/ds4/scripts/ops_ds4_env_check.sh
ConditionPathIsExecutable=%h/ds4/scripts/ops_tp2_readiness.sh

[Service]
Type=oneshot
WorkingDirectory=%h/ds4
SyslogIdentifier=ds4-user-preflight-%i
Environment=DS4_INSTANCE=%i
Environment=DS4_CONFIG_PATH=%h/.config/ds4/ds4-%i.conf
EnvironmentFile=-%h/.config/ds4/ds4.env
EnvironmentFile=-%h/.config/ds4/ds4-%i.env

ExecStartPre=%h/ds4/scripts/ops_ds4_env_check.sh -%h/.config/ds4/ds4.env %h/.config/ds4/ds4-%i.env
ExecStart=%h/ds4/scripts/ops_tp2_readiness.sh --self %i --env -%h/.config/ds4/ds4.env --env %h/.config/ds4/ds4-%i.env

StandardOutput=journal
StandardError=journal

RemainAfterExit=yes
TimeoutStartSec=120

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target

