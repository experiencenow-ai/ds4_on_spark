[Unit]
Description=DS4 user support bundle collector (%i)
Wants=network-online.target
After=network-online.target
ConditionPathIsExecutable=%h/ds4/scripts/ops_collect_support_bundle.sh

[Service]
Type=oneshot
WorkingDirectory=%h/ds4
SyslogIdentifier=ds4-user-support-bundle-%i
Environment=DS4_INSTANCE=%i
Environment=DS4_CONFIG_PATH=%h/.config/ds4/ds4-%i.conf
EnvironmentFile=-%h/.config/ds4/ds4.env
EnvironmentFile=-%h/.config/ds4/ds4-%i.env

ExecStart=%h/ds4/scripts/ops_collect_support_bundle.sh --instance %i --env -%h/.config/ds4/ds4.env --env -%h/.config/ds4/ds4-%i.env

StandardOutput=journal
StandardError=journal

TimeoutStartSec=300

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
