<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ds4.spark-telemetry-collector</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/mac/.local/share/ds4_telemetry/spark_telemetry_collect.py</string>
    <string>--nodes</string>
    <string>spark0=spark0,spark1=spark1,spark2=spark2,spark3=spark3,spark4=spark4,spark5=spark5,spark6=spark6,spark7=spark7,spark8=spark8,spark9=spark9,sparka=sparka,sparkb=sparkb,sparkc=sparkc</string>
    <string>--out-dir</string>
    <string>/tmp/ds4_telemetry/mac</string>
    <string>--tail-lines</string>
    <string>720</string>
    <string>--ssh-timeout</string>
    <string>8</string>
    <string>--loop-interval</string>
    <string>5</string>
    <string>--ssh-control-dir</string>
    <string>/tmp/ds4mux</string>
    <string>--ssh-control-persist</string>
    <string>600</string>
    <string>--fetch-workers</string>
    <string>13</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/mac/.local/share/ds4_telemetry</string>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/ds4_telemetry/mac/telemetry-collector.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/ds4_telemetry/mac/telemetry-collector.err.log</string>
</dict>
</plist>
