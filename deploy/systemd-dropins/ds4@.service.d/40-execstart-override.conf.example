# Example: override ExecStart without editing the base unit.
#
# WARNING:
# - This is a template; do not guess flags. Verify `ds4_server --help` on your build.
# - When overriding ExecStart, you must first clear the inherited ExecStart line.
#
# Install as:
#   /etc/systemd/system/ds4@.service.d/40-execstart-override.conf
#
# Then:
#   sudo systemctl daemon-reload
#   sudo systemctl restart ds4@<instance>.service

[Service]
ExecStart=
ExecStart=/opt/ds4/bin/ds4_server --config ${DS4_CONFIG_PATH}

