[Unit]
Description=DS4 preflight checks (%i)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ds4
Group=ds4
WorkingDirectory=/opt/ds4
EnvironmentFile=/etc/ds4/ds4-%i.env

# Provide the script on-host at /opt/ds4/scripts/ops_tp2_readiness.sh.
ExecStart=/opt/ds4/scripts/ops_tp2_readiness.sh --self ${DS4_INSTANCE} --peer ${DS4_PEER_HOST} --peer-ssh ${DS4_PEER_SSH}

StandardOutput=journal
StandardError=journal

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
