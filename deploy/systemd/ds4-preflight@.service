[Unit]
Description=DS4 preflight checks (%i)
Wants=network-online.target
After=network-online.target
OnFailure=ds4-support-bundle@%i.service
ConditionPathIsExecutable=/opt/ds4/scripts/ops_ds4_env_check.sh
ConditionPathIsExecutable=/opt/ds4/scripts/ops_tp2_readiness.sh

[Service]
Type=oneshot
User=ds4
Group=ds4
WorkingDirectory=/opt/ds4
Environment=DS4_INSTANCE=%i
EnvironmentFile=-/etc/ds4/ds4.env
EnvironmentFile=/etc/ds4/ds4-%i.env

# Provide the script on-host at /opt/ds4/scripts/ops_ds4_env_check.sh.
ExecStartPre=/opt/ds4/scripts/ops_ds4_env_check.sh -/etc/ds4/ds4.env /etc/ds4/ds4-%i.env

# Provide the script on-host at /opt/ds4/scripts/ops_tp2_readiness.sh.
ExecStart=/opt/ds4/scripts/ops_tp2_readiness.sh --self %i

StandardOutput=journal
StandardError=journal

RemainAfterExit=yes
TimeoutStartSec=120

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true

StateDirectory=ds4 ds4/ssh

[Install]
WantedBy=multi-user.target
