# Copy to: /etc/ds4/ds4-spark1.env
DS4_INSTANCE=spark1
DS4_NODE_ID=1
DS4_HOME=/opt/ds4
DS4_STATE_DIR=/var/lib/ds4
DS4_LOG_DIR=/var/log/ds4
DS4_LOG_LEVEL=info
DS4_LOG_FORMAT=jsonl
DS4_METRICS_ADDR=0.0.0.0
DS4_METRICS_PORT=9090
DS4_CONFIG_PATH=/etc/ds4/ds4-spark1.yaml
DS4_WORLD_SIZE=2
DS4_RANK=1
DS4_MASTER_ADDR=aitopatom-9ab9.local
DS4_MASTER_PORT=29500
DS4_PEER_HOST=aitopatom-9ab9.local
DS4_PEER_SSH=ds4@aitopatom-9ab9.local
DS4_MODEL_DIR=/var/lib/ds4/models
DS4_CACHE_DIR=/var/lib/ds4/cache
