# Copy to ~/.config/ds4/model-gateway.env on spark0, spark1, spark2, spark3, or spark6.
FRONT_HOST=127.0.0.1
FRONT_PORT=8000
BACKEND_HOST=127.0.0.1
BACKEND_PORT=18000
VLLM_HOME=~/ds4-vllm-local
DS4_RESIDENT_BACKEND_BASE_PORT=18100
DS4_RESIDENT_START=1
START_TIMEOUT=3600
IDLE_TIMEOUT=1800
DS4_RESIDENT_MODELS_JSON=[{"model":"Qwen/Qwen3.6-27B-FP8","port":18100,"tuning":{"gpu_memory_utilization":"0.50","max_num_seqs":"12","max_num_batched_tokens":"32768"}}]
DS4_REMOTE_MODELS_JSON={}
