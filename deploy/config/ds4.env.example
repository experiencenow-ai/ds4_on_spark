# DS4 environment file example.
#
# Copy to: /etc/ds4/ds4.env (optional shared defaults loaded before `ds4-<instance>.env`)
# or use as a starting point for per-instance env files (spark0, spark1, etc.).

# Identity
DS4_INSTANCE=spark0
DS4_NODE_ID=0

# Paths
DS4_HOME=/opt/ds4
DS4_STATE_DIR=/var/lib/ds4
DS4_LOG_DIR=/var/log/ds4

# Logging + metrics conventions (docs/ops*.md defines details)
DS4_LOG_LEVEL=info
DS4_LOG_FORMAT=jsonl
DS4_METRICS_ADDR=0.0.0.0
DS4_METRICS_PORT=9090

# Optional runtime config file (key=value; see src/ds4_config.c)
DS4_CONFIG_PATH=/etc/ds4/ds4-spark0.conf

# Distributed defaults (TP=2 placeholders; set only when dual-Spark is live)
DS4_WORLD_SIZE=1
DS4_RANK=0
DS4_EXPERT_OWNER_TABLE_PATH=
DS4_EXPERT_MANIFEST_PATH=
DS4_MASTER_ADDR=127.0.0.1
DS4_MASTER_PORT=29500
DS4_PEER_HOST=
DS4_PEER_SSH=

# Optional: distributed/network debug knobs (leave unset unless you know you need them)
#DS4_EXPECT_IFACE=<wired-ifname>
#NCCL_DEBUG=INFO
#NCCL_SOCKET_IFNAME=<wired-ifname>

# Model locations (examples; adjust to your local layout)
DS4_MODEL_DIR=/var/lib/ds4/models
DS4_CACHE_DIR=/var/lib/ds4/cache
