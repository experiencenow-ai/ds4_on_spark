# Prometheus alerting example snippet for DS4.
#
# This file intentionally sticks to:
# - universal Prometheus metrics (`up`)
# - low-cardinality DS4 counters/gauges described in `docs/ops-logging-metrics.md`
#
# If a DS4 metric does not exist yet, the alert simply never fires (safe).

groups:
  - name: ds4
    rules:
      - alert: DS4TargetDown
        expr: up{job="ds4"} == 0
        for: 2m
        labels:
          severity: page
        annotations:
          summary: "DS4 scrape target is down"
          description: "Prometheus cannot scrape DS4 for {{ $labels.ds4_instance }} (target {{ $labels.instance }})."

      - alert: DS4OOMDetected
        expr: increase(ds4_cuda_oom_total[10m]) > 0
        for: 0m
        labels:
          severity: ticket
        annotations:
          summary: "DS4 reported CUDA OOM"
          description: "CUDA OOM counter increased on {{ $labels.ds4_instance }} (target {{ $labels.instance }})."

      - alert: DS4RequestsStuckHigh
        expr: ds4_requests_inflight > 64
        for: 10m
        labels:
          severity: ticket
        annotations:
          summary: "DS4 inflight requests remain high"
          description: "Potential backpressure/deadlock; ds4_requests_inflight={{ $value }} on {{ $labels.ds4_instance }}."

