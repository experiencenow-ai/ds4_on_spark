# Example sysctl drop-in for DS4 (Spark0/Spark1).
#
# WARNING: sysctl settings affect the entire host. Review with human approval.
#
# Copy to (human-run on Spark):
#   /etc/sysctl.d/99-ds4.conf
#
# Apply (human-run on Spark; distro-dependent):
#   sudo sysctl --system
#
# Inspect current values:
#   sysctl net.core.rmem_max net.core.wmem_max net.core.netdev_max_backlog net.core.somaxconn
#
# Roll back:
#   sudo rm /etc/sysctl.d/99-ds4.conf
#   sudo sysctl --system
#
# Notes:
# - Prefer starting with minimal, reversible changes.
# - Keep a copy of the prior `sysctl -a` (or the specific keys) in your run notes.

# Max socket buffers (helps high-throughput TCP streams on fast wired links).
net.core.rmem_max = 268435456
net.core.wmem_max = 268435456

# Receive-side packet backlog (avoid drops under bursty RX load).
net.core.netdev_max_backlog = 250000

# Listen backlog (does not change DS4 semantics; mostly harmless).
net.core.somaxconn = 4096
