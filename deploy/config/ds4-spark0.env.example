# Copy to: /etc/ds4/ds4-spark0.env
# Optional shared defaults: /etc/ds4/ds4.env (see deploy/config/ds4.env.example)
DS4_INSTANCE=spark0
DS4_NODE_ID=0
DS4_HOME=/opt/ds4
DS4_STATE_DIR=/var/lib/ds4
DS4_LOG_DIR=/var/log/ds4
DS4_LOG_LEVEL=info
DS4_LOG_FORMAT=jsonl
DS4_METRICS_ADDR=0.0.0.0
DS4_METRICS_PORT=9090
DS4_CONFIG_PATH=/etc/ds4/ds4-spark0.yaml
DS4_WORLD_SIZE=2
DS4_RANK=0
DS4_MASTER_ADDR=spark0.local
DS4_MASTER_PORT=29500
DS4_PEER_HOST=spark1.local
# Optional peer SSH target for `ops_tp2_readiness.sh` (leave blank to skip).
# Use a login-capable account; the `ds4` service user is typically `/usr/sbin/nologin`.
# When set, `ops_tp2_readiness.sh` also runs a peer→master backcheck via SSH using
# `DS4_MASTER_ADDR`/`DS4_MASTER_PORT` (and an optional metrics HTTP probe).
DS4_PEER_SSH=
# Optional: override SSH options (identity + known_hosts) for the peer SSH check.
#SSH_OPTS=-o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=/var/lib/ds4/ssh/known_hosts -i /var/lib/ds4/ssh/id_ed25519

# Optional: distributed/network debug knobs (leave unset unless you know you need them)
#NCCL_DEBUG=INFO
#NCCL_SOCKET_IFNAME=<wired-ifname>

DS4_MODEL_DIR=/var/lib/ds4/models
DS4_CACHE_DIR=/var/lib/ds4/cache
