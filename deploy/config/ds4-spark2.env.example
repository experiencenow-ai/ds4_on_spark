# Copy to: /etc/ds4/ds4-spark2.env
# Optional shared defaults: /etc/ds4/ds4.env (see deploy/config/ds4.env.example)
#
# Note: this file is a generic placeholder. For topology-specific starting points, prefer:
# - TP=3 (Spark0/Spark1/Spark2): deploy/config/ds4-spark2.tp3.env.example
# - TP=4 (Spark0..Spark3):       deploy/config/ds4-spark2.tp4.env.example
DS4_INSTANCE=spark2
DS4_NODE_ID=2
DS4_HOME=/opt/ds4
DS4_STATE_DIR=/var/lib/ds4
DS4_LOG_DIR=/var/log/ds4
DS4_LOG_LEVEL=info
DS4_LOG_FORMAT=jsonl
DS4_METRICS_ADDR=0.0.0.0
DS4_METRICS_PORT=9090
DS4_CONFIG_PATH=/etc/ds4/ds4-spark2.conf

# TP=4 placeholder defaults (Spark0..Spark3 ring bring-up).
# If you're only doing TP=2, keep DS4_WORLD_SIZE=2 on Spark0/Spark1 and leave
# Spark2/Spark3 unused.
DS4_WORLD_SIZE=4
DS4_RANK=2
DS4_MASTER_ADDR=spark0.local
DS4_MASTER_PORT=29500

# For TP=4, prefer `DS4_RING_HOSTS` + `ops_tp4_readiness.sh` rather than the
# TP=2-only peer checks. `DS4_PEER_HOST` is still used as a best-effort "smoke
# peer" for TP=2 preflight units that run `ops_tp2_readiness.sh`.
DS4_PEER_HOST=spark3.local
DS4_RING_HOSTS=spark0.local,spark1.local,spark2.local,spark3.local

# Optional peer SSH target for `ops_tp2_readiness.sh` / `ops_tp4_readiness.sh`
# (leave blank to skip).
# Use a login-capable account; the `ds4` service user is typically `/usr/sbin/nologin`.
DS4_PEER_SSH=

# Optional: override SSH options (identity + known_hosts) for the peer SSH check.
#SSH_OPTS=-o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=/var/lib/ds4/ssh/known_hosts -i /var/lib/ds4/ssh/id_ed25519

# Optional: distributed/network debug knobs (leave unset unless you know you need them)
#DS4_EXPECT_IFACE=<wired-ifname>
#NCCL_DEBUG=INFO
#NCCL_SOCKET_IFNAME=<wired-ifname>

DS4_MODEL_DIR=/var/lib/ds4/models
DS4_CACHE_DIR=/var/lib/ds4/cache
