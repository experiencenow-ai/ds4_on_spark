# DS4 runtime config example for Spark2 (key=value).
#
# Copy to: /etc/ds4/ds4-spark2.conf
#
# Parser notes (src/ds4_config.c):
# - Blank lines are allowed.
# - Comment lines starting with '#' are allowed.
# - Non-empty, non-comment lines must be `key=value`.
#
# Supported keys today:
#   - log_level   (error|warn|info|debug or 0..3)
#   - enable_cuda (0/1, true/false, yes/no, on/off)
#   - cuda_device (-1=auto, >=0 fixed)
#   - arena_size (bytes; supports K/M/G suffix; non-negative)
#   - cuda_arena_size (bytes; supports K/M/G suffix; non-negative; requires enable_cuda=1 when >0)
#   - log_ring_entries (count; supports K/M/G suffix; non-negative)
#   - rank (-1 unset, or >=0 distributed rank)
#   - world_size (>=1 distributed rank count)
#   - expert_owner_table_path (path to generated owner table JSON)
#   - expert_manifest_path (path to this rank's generated manifest JSON)
#
#log_level=info
#enable_cuda=1
#cuda_device=-1
#arena_size=0
#cuda_arena_size=0
#log_ring_entries=0
#rank=2
#world_size=3
#expert_owner_table_path=/tmp/ds4-owned-experts-sparks3/expert_owner_table_sparks3.json
#expert_manifest_path=/tmp/ds4-owned-experts-sparks3/rank-002.json
