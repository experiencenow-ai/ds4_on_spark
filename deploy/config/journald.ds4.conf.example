# Optional journald tuning for DS4 debugging.
#
# Copy to: /etc/systemd/journald.conf.d/ds4.conf
# Then (human-run): sudo systemctl restart systemd-journald
#
# Review `man journald.conf` on the target OS before applying.
[Journal]
Storage=persistent
SystemMaxUse=2G
RuntimeMaxUse=1G
MaxRetentionSec=7day

