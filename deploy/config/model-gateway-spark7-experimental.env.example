# Copy to ~/.config/ds4/model-gateway.env on spark7.
# Spark7 stays on-demand for experiments; no default production model is pinned.
FRONT_HOST=127.0.0.1
FRONT_PORT=8000
BACKEND_HOST=127.0.0.1
BACKEND_PORT=18000
DS4_RESIDENT_BACKEND_BASE_PORT=18100
DS4_RESIDENT_START=1
START_TIMEOUT=1800
IDLE_TIMEOUT=1800
DS4_RESIDENT_MODELS_JSON=[]
