# DS4 ordered Spark inventory example (Spark0/Spark1/Spark2/Spark3)
#
# One target per line. Format matches the Mac-side ops helpers:
#   <user>@<host>
#
# Notes:
# - Order matters: first line => spark0, second => spark1, third => spark2, fourth => spark3.
# - Blank lines and lines starting with `#` are ignored.
#
# Usage examples:
#   ./scripts/ops_spark_ring_mesh_check.sh --topology ring --inventory-file deploy/config/inventory.ds4.spark_ring.example
#   ./scripts/ops_stage_spark_ring.sh --mesh-check --topology ring --inventory-file deploy/config/inventory.ds4.spark_ring.example
#   ./scripts/ops_spark_ring_status.sh --preflight tp4 --strict --inventory-file deploy/config/inventory.ds4.spark_ring.example
#   ./scripts/ops_spark_ring_ops_check.sh --preflight tp4 --strict --journal --lines 120 --inventory-file deploy/config/inventory.ds4.spark_ring.example
spark0@<spark0-host>
spark1@<spark1-host>
spark2@<spark2-host>
spark3@<spark3-host>
