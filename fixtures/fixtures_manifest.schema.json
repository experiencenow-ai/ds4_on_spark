{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "entries": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "archive_path": {
            "type": "string"
          },
          "archived_at": {
            "type": "string"
          },
          "file_count": {
            "minimum": 1,
            "type": "integer"
          },
          "files": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string"
                },
                "sha256": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                "size_bytes": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "path",
                "sha256",
                "size_bytes"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "kind": {
            "enum": [
              "file",
              "directory"
            ]
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "size_bytes": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "archive_path",
          "archived_at",
          "file_count",
          "files",
          "kind",
          "path",
          "sha256",
          "size_bytes"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "format": {
      "const": "centaur-fixtures-manifest-v1"
    }
  },
  "required": [
    "format",
    "entries"
  ],
  "type": "object"
}
