{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ds4_judge_elo_bundle_v1",
  "description": "bundle.json emitted by scripts/judge_elo_update.py: meta + budget + quality_map + leaderboard in one object.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "meta",
    "budget",
    "quality_map",
    "leaderboard"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "ds4_judge_elo_bundle_v1"
    },
    "meta": {
      "type": "object"
    },
    "budget": {
      "type": "object"
    },
    "quality_map": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0.0,
        "maximum": 100.0
      }
    },
    "leaderboard": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
