     if (input_file) {
-        if (!read_f32_binary_file(input_file, host_hc, hc_floats)) return false;
+        char path[1024];
+        if (!cuda_stack_probe_format_boundary_path(input_file, iter, path, sizeof(path))) return false;
+        const uint32_t wait_ms = cuda_stack_probe_input_wait_ms();
+        uint32_t waited = 0;
+        while (waited <= wait_ms) {
+            struct stat st;
+            if (stat(path, &st) == 0 && st.st_size >= 0 && (uint64_t)st.st_size == hc_floats * sizeof(host_hc[0])) break;
+            if (waited >= wait_ms) break;
+            usleep(10000);
+            waited += 10;
+        }
+        if (!read_f32_binary_file(path, host_hc, hc_floats)) return false;
         return ds4_gpu_tensor_write(g->batch_cur_hc, 0, host_hc, hc_floats * sizeof(host_hc[0])) != 0;
     }
