@@
+static uint32_t cuda_stack_probe_input_wait_ms(void) {
+    const char *env = getenv("DS4_CUDA_STACK_PROBE_INPUT_WAIT_MS");
+    if (!env || !env[0]) return 0;
+    char *end = NULL;
+    unsigned long v = strtoul(env, &end, 10);
+    if (end == env || v > 3600000ul) return 0;
+    return (uint32_t)v;
+}
+
+static bool cuda_stack_probe_format_boundary_path(
+        const char *pattern,
+        uint32_t    iter,
+        char       *buf,
+        size_t      buflen) {
+    if (!pattern || !buf || buflen == 0) return false;
+    if (strchr(pattern, '%')) {
+        int n = snprintf(buf, buflen, pattern, iter);
+        return n > 0 && (size_t)n < buflen;
+    }
+    int n = snprintf(buf, buflen, "%s", pattern);
+    return n > 0 && (size_t)n < buflen;
+}
@@
-        const char       *input_file) {
+        const char       *input_file,
