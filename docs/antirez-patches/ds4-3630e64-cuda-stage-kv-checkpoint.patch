+#define DS4_PIPELINE_STAGE_KV_MAGIC UINT32_C(0x4b563450)
+#define DS4_PIPELINE_STAGE_KV_VERSION UINT32_C(1)
+#define DS4_PIPELINE_STAGE_KV_IO_CHUNK (8u * 1024u * 1024u)
+
+typedef struct {
+    uint32_t magic;
+    uint32_t version;
+    uint32_t stage_id;
+    uint32_t layer_begin;
+    uint32_t layer_end;
+    uint32_t raw_cap;
+    uint32_t raw_window;
+    uint32_t comp_cap;
+    uint32_t token_count;
+    uint32_t raw_live_rows;
+    uint32_t hc_dim;
+    uint32_t has_last_hc;
+    uint64_t payload_bytes;
+} ds4_pipeline_stage_kv_header;
+
+static uint32_t pipeline_stage_kv_raw_live_rows(const ds4_gpu_graph *g, uint32_t token_count) {
+    uint32_t rows = g->raw_window ? g->raw_window : DS4_N_SWA;
+    if (rows > g->raw_cap) rows = g->raw_cap;
+    if (rows > token_count) rows = token_count;
+    return rows;
+}
+
+static uint64_t pipeline_stage_kv_payload_bytes(const ds4_gpu_graph *g, uint32_t layer_begin, uint32_t layer_end, uint32_t token_count) {
+    uint64_t bytes = (uint64_t)DS4_N_HC * DS4_N_EMBD * sizeof(float);
+    const uint32_t raw_live = pipeline_stage_kv_raw_live_rows(g, token_count);
+    for (uint32_t il = layer_begin; il < layer_end; il++) {
+        bytes += sizeof(uint32_t) * 2u;
+        bytes += (uint64_t)raw_live * DS4_N_HEAD_DIM * sizeof(float);
+        const uint32_t ratio = ds4_layer_compress_ratio(il);
+        if (ratio == 0) continue;
+        bytes += (uint64_t)g->layer_n_comp[il] * DS4_N_HEAD_DIM * sizeof(float);
+        bytes += ds4_gpu_tensor_bytes(g->layer_attn_state_kv[il]);
+        bytes += ds4_gpu_tensor_bytes(g->layer_attn_state_score[il]);
+        if (ratio == 4) {
+            bytes += (uint64_t)g->layer_n_index_comp[il] * DS4_N_INDEXER_HEAD_DIM * sizeof(float);
+            bytes += ds4_gpu_tensor_bytes(g->layer_index_state_kv[il]);
+            bytes += ds4_gpu_tensor_bytes(g->layer_index_state_score[il]);
+        }
+    }
+    return bytes;
+}
+
+static bool pipeline_stage_kv_write_tensor(FILE *fp, const ds4_gpu_tensor *tensor, uint64_t off, uint64_t bytes, uint8_t *buf, uint64_t cap) {
+    uint64_t done = 0;
+    while (done < bytes) {
+        const uint64_t want = bytes - done;
+        const size_t n = (size_t)(want > cap ? cap : want);
+        if (ds4_gpu_tensor_read(tensor, off + done, buf, n) == 0) return false;
+        if (fwrite(buf, 1, n, fp) != n) return false;
+        done += n;
+    }
+    return true;
+}
+
+static bool pipeline_stage_kv_read_tensor(FILE *fp, ds4_gpu_tensor *tensor, uint64_t off, uint64_t bytes, uint8_t *buf, uint64_t cap) {
+    uint64_t done = 0;
+    while (done < bytes) {
+        const uint64_t want = bytes - done;
+        const size_t n = (size_t)(want > cap ? cap : want);
+        if (fread(buf, 1, n, fp) != n) return false;
+        if (ds4_gpu_tensor_write(tensor, off + done, buf, n) == 0) return false;
+        done += n;
+    }
+    return true;
+}
+
+static bool pipeline_stage_kv_save(ds4_gpu_graph *g, uint32_t stage_id, uint32_t layer_begin, uint32_t layer_end, uint32_t token_count, const char *path) {
+    if (!g || !path || !path[0] || token_count == 0 || layer_begin >= layer_end || layer_end > DS4_N_LAYER) return false;
+    if (ds4_gpu_synchronize() == 0) return false;
+    FILE *fp = fopen(path, "wb");
+    if (!fp) return false;
+    const uint32_t raw_live = pipeline_stage_kv_raw_live_rows(g, token_count);
+    const uint64_t hc_dim = (uint64_t)DS4_N_HC * DS4_N_EMBD;
+    ds4_pipeline_stage_kv_header h = {
+        DS4_PIPELINE_STAGE_KV_MAGIC,
+        DS4_PIPELINE_STAGE_KV_VERSION,
+        stage_id,
+        layer_begin,
+        layer_end,
+        g->raw_cap,
+        g->raw_window,
+        g->comp_cap,
+        token_count,
+        raw_live,
+        (uint32_t)hc_dim,
+        1u,
+        pipeline_stage_kv_payload_bytes(g, layer_begin, layer_end, token_count),
+    };
+    bool ok = fwrite(&h, 1, sizeof(h), fp) == sizeof(h);
+    uint8_t *buf = xmalloc(DS4_PIPELINE_STAGE_KV_IO_CHUNK);
+    const uint64_t hc_bytes = hc_dim * sizeof(float);
+    if (ok) ok = pipeline_stage_kv_write_tensor(fp, g->batch_cur_hc, (uint64_t)(token_count - 1u) * hc_bytes, hc_bytes, buf, DS4_PIPELINE_STAGE_KV_IO_CHUNK);
+    const uint32_t raw_first = token_count - raw_live;
+    for (uint32_t il = layer_begin; ok && il < layer_end; il++) {
+        if (fwrite(&g->layer_n_comp[il], 1, sizeof(uint32_t), fp) != sizeof(uint32_t)) ok = false;
+        if (ok && fwrite(&g->layer_n_index_comp[il], 1, sizeof(uint32_t), fp) != sizeof(uint32_t)) ok = false;
+        for (uint32_t r = 0; ok && r < raw_live; r++) {
+            const uint32_t phys = (raw_first + r) % g->raw_cap;
+            ok = pipeline_stage_kv_write_tensor(fp, g->layer_raw_cache[il], (uint64_t)phys * DS4_N_HEAD_DIM * sizeof(float), (uint64_t)DS4_N_HEAD_DIM * sizeof(float), buf, DS4_PIPELINE_STAGE_KV_IO_CHUNK);
+        }
+        const uint32_t ratio = ds4_layer_compress_ratio(il);
+        if (ok && ratio != 0) ok = pipeline_stage_kv_write_tensor(fp, g->layer_attn_comp_cache[il], 0, (uint64_t)g->layer_n_comp[il] * DS4_N_HEAD_DIM * sizeof(float), buf, DS4_PIPELINE_STAGE_KV_IO_CHUNK);
+        if (ok && ratio != 0) ok = pipeline_stage_kv_write_tensor(fp, g->layer_attn_state_kv[il], 0, ds4_gpu_tensor_bytes(g->layer_attn_state_kv[il]), buf, DS4_PIPELINE_STAGE_KV_IO_CHUNK);
+        if (ok && ratio != 0) ok = pipeline_stage_kv_write_tensor(fp, g->layer_attn_state_score[il], 0, ds4_gpu_tensor_bytes(g->layer_attn_state_score[il]), buf, DS4_PIPELINE_STAGE_KV_IO_CHUNK);
+        if (ok && ratio == 4) ok = pipeline_stage_kv_write_tensor(fp, g->layer_index_comp_cache[il], 0, (uint64_t)g->layer_n_index_comp[il] * DS4_N_INDEXER_HEAD_DIM * sizeof(float), buf, DS4_PIPELINE_STAGE_KV_IO_CHUNK);
+        if (ok && ratio == 4) ok = pipeline_stage_kv_write_tensor(fp, g->layer_index_state_kv[il], 0, ds4_gpu_tensor_bytes(g->layer_index_state_kv[il]), buf, DS4_PIPELINE_STAGE_KV_IO_CHUNK);
+        if (ok && ratio == 4) ok = pipeline_stage_kv_write_tensor(fp, g->layer_index_state_score[il], 0, ds4_gpu_tensor_bytes(g->layer_index_state_score[il]), buf, DS4_PIPELINE_STAGE_KV_IO_CHUNK);
+    }
+    free(buf);
+    if (fclose(fp) != 0) ok = false;
+    return ok;
+}
