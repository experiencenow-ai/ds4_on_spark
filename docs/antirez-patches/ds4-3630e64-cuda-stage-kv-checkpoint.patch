+static bool pipeline_stage_kv_restore(ds4_gpu_graph *g, uint32_t stage_id, uint32_t layer_begin, uint32_t layer_end, uint32_t token_count, const char *path) {
+    if (!g || !path || !path[0] || layer_begin >= layer_end || layer_end > DS4_N_LAYER) return false;
+    FILE *fp = fopen(path, "rb");
+    if (!fp) return false;
+    ds4_pipeline_stage_kv_header h;
+    bool ok = fread(&h, 1, sizeof(h), fp) == sizeof(h);
+    if (ok && (h.magic != DS4_PIPELINE_STAGE_KV_MAGIC || h.version != DS4_PIPELINE_STAGE_KV_VERSION)) ok = false;
+    if (ok && (h.stage_id != stage_id || h.layer_begin != layer_begin || h.layer_end != layer_end || h.token_count != token_count || h.hc_dim != (uint32_t)((uint64_t)DS4_N_HC * DS4_N_EMBD))) ok = false;
+    if (ok && (h.raw_cap > g->raw_cap || h.raw_live_rows > g->raw_cap || h.raw_live_rows > h.token_count || h.comp_cap > g->comp_cap)) ok = false;
+    uint8_t *buf = xmalloc(DS4_PIPELINE_STAGE_KV_IO_CHUNK);
+    const uint64_t hc_bytes = (uint64_t)DS4_N_HC * DS4_N_EMBD * sizeof(float);
+    if (ok) ok = pipeline_stage_kv_read_tensor(fp, g->cur_hc, 0, hc_bytes, buf, DS4_PIPELINE_STAGE_KV_IO_CHUNK);
+    const uint32_t raw_first = h.token_count - h.raw_live_rows;
+    for (uint32_t il = layer_begin; ok && il < layer_end; il++) {
+        uint32_t n_comp = 0;
+        uint32_t n_index_comp = 0;
+        if (fread(&n_comp, 1, sizeof(uint32_t), fp) != sizeof(uint32_t)) ok = false;
+        if (ok && fread(&n_index_comp, 1, sizeof(uint32_t), fp) != sizeof(uint32_t)) ok = false;
+        if (ok && (n_comp > g->layer_comp_cap[il] || n_index_comp > g->layer_comp_cap[il])) ok = false;
+        for (uint32_t r = 0; ok && r < h.raw_live_rows; r++) {
+            const uint32_t phys = (raw_first + r) % g->raw_cap;
+            ok = pipeline_stage_kv_read_tensor(fp, g->layer_raw_cache[il], (uint64_t)phys * DS4_N_HEAD_DIM * sizeof(float), (uint64_t)DS4_N_HEAD_DIM * sizeof(float), buf, DS4_PIPELINE_STAGE_KV_IO_CHUNK);
+        }
+        const uint32_t ratio = ds4_layer_compress_ratio(il);
+        if (ok && ratio != 0) ok = pipeline_stage_kv_read_tensor(fp, g->layer_attn_comp_cache[il], 0, (uint64_t)n_comp * DS4_N_HEAD_DIM * sizeof(float), buf, DS4_PIPELINE_STAGE_KV_IO_CHUNK);
+        if (ok && ratio != 0) ok = pipeline_stage_kv_read_tensor(fp, g->layer_attn_state_kv[il], 0, ds4_gpu_tensor_bytes(g->layer_attn_state_kv[il]), buf, DS4_PIPELINE_STAGE_KV_IO_CHUNK);
+        if (ok && ratio != 0) ok = pipeline_stage_kv_read_tensor(fp, g->layer_attn_state_score[il], 0, ds4_gpu_tensor_bytes(g->layer_attn_state_score[il]), buf, DS4_PIPELINE_STAGE_KV_IO_CHUNK);
+        if (ok && ratio == 4) ok = pipeline_stage_kv_read_tensor(fp, g->layer_index_comp_cache[il], 0, (uint64_t)n_index_comp * DS4_N_INDEXER_HEAD_DIM * sizeof(float), buf, DS4_PIPELINE_STAGE_KV_IO_CHUNK);
+        if (ok && ratio == 4) ok = pipeline_stage_kv_read_tensor(fp, g->layer_index_state_kv[il], 0, ds4_gpu_tensor_bytes(g->layer_index_state_kv[il]), buf, DS4_PIPELINE_STAGE_KV_IO_CHUNK);
+        if (ok && ratio == 4) ok = pipeline_stage_kv_read_tensor(fp, g->layer_index_state_score[il], 0, ds4_gpu_tensor_bytes(g->layer_index_state_score[il]), buf, DS4_PIPELINE_STAGE_KV_IO_CHUNK);
+        if (ok) {
+            g->layer_n_comp[il] = n_comp;
+            g->layer_n_index_comp[il] = n_index_comp;
+        }
+    }
+    free(buf);
+    if (fclose(fp) != 0) ok = false;
+    if (ok) ok = ds4_gpu_synchronize() != 0;
+    return ok;
 }

+static bool pipeline_hash_hc_tensor(ds4_gpu_tensor *tensor, float *host, uint64_t hc_dim, uint64_t *hash_out, uint64_t *nonfinite_out) {
+    if (!tensor || !host) return false;
+    if (ds4_gpu_tensor_read(tensor, 0, host, hc_dim * sizeof(host[0])) == 0) return false;
+    if (hash_out) *hash_out = hash_bytes((const uint8_t *)host, hc_dim * sizeof(host[0]));
+    if (nonfinite_out) *nonfinite_out = pipeline_nonfinite_count(host, hc_dim);
+    return true;
+}
