+
+static int pipeline_stage_parse_token_ids(const char *csv, int32_t *out, uint32_t cap, uint32_t *count, char *err, size_t errlen) {
+    const char *p;
+    uint32_t n = 0;
+    if (!csv || !csv[0] || !out || !count) {
+        pipeline_stage_set_err(err, errlen, "missing DS4_PIPELINE_KV_TOKEN_IDS");
+        return 1;
+    }
+    p = csv;
+    while (*p) {
+        char *end = NULL;
+        long v;
+        if (n >= cap) {
+            pipeline_stage_set_err(err, errlen, "too many pipeline KV token ids");
+            return 1;
+        }
+        errno = 0;
+        v = strtol(p, &end, 10);
+        if (errno != 0 || end == p || v < INT32_MIN || v > INT32_MAX) {
+            pipeline_stage_set_err(err, errlen, "invalid pipeline KV token id");
+            return 1;
+        }
+        out[n++] = (int32_t)v;
+        if (*end == ',') p = end + 1;
+        else if (*end == '\0') p = end;
+        else {
+            pipeline_stage_set_err(err, errlen, "invalid pipeline KV token id separator");
+            return 1;
+        }
+    }
+    *count = n;
+    return 0;
+}
+
+static uint32_t pipeline_stage_env_u32(const char *name, uint32_t fallback) {
+    const char *env = getenv(name);
+    char *end = NULL;
+    long v;
+    if (!env || !env[0]) return fallback;
+    errno = 0;
+    v = strtol(env, &end, 10);
+    if (errno != 0 || end == env || *end != '\0' || v < 0 || v > UINT32_MAX) return fallback;
+    return (uint32_t)v;
+}
+
+static int pipeline_stage_save_kv(ds4_pipeline_stage *p, const char *path, char *err, size_t errlen) {
+    FILE *fp;
+    int rc;
+    if (!p || !p->session || !path || !path[0]) {
+        pipeline_stage_set_err(err, errlen, "invalid save_kv request");
+        return 1;
+    }
+    fp = fopen(path, "wb");
+    if (!fp) {
+        pipeline_stage_set_err(err, errlen, "failed to open save_kv file");
+        return 1;
+    }
+    rc = ds4_session_save_payload(p->session, fp, err, errlen);
+    if (fclose(fp) != 0 && rc == 0) {
+        pipeline_stage_set_err(err, errlen, "failed to close save_kv file");
+        return 1;
+    }
+    return rc;
+}
+
+static int pipeline_stage_restore_kv(ds4_pipeline_stage *p, const char *path, char *err, size_t errlen) {
+    struct stat st;
+    FILE *fp;
+    const ds4_tokens *tokens;
+    int rc;
+    if (!p || !p->session || !path || !path[0]) {
+        pipeline_stage_set_err(err, errlen, "invalid restore_kv request");
+        return 1;
+    }
+    if (stat(path, &st) != 0 || st.st_size <= 0) {
+        pipeline_stage_set_err(err, errlen, "restore_kv file is missing or empty");
+        return 1;
+    }
+    fp = fopen(path, "rb");
+    if (!fp) {
+        pipeline_stage_set_err(err, errlen, "failed to open restore_kv file");
+        return 1;
+    }
+    rc = ds4_session_load_payload(p->session, fp, (uint64_t)st.st_size, err, errlen);
+    if (fclose(fp) != 0 && rc == 0) {
+        pipeline_stage_set_err(err, errlen, "failed to close restore_kv file");
+        return 1;
+    }
+    if (rc != 0) return rc;
+    tokens = ds4_session_tokens(p->session);
+    p->prompt.len = 0;
+    if (tokens) {
+        for (int i = 0; i < tokens->len; i++) token_vec_push(&p->prompt, tokens->v[i]);
+    }
+    return 0;
+}
+
+static int pipeline_stage_decode_argmax_tokens(ds4_pipeline_stage *p, uint32_t n, int32_t *out, char *err, size_t errlen) {
+    int32_t token;
+    if (!p || !p->session || !out || n == 0) {
+        pipeline_stage_set_err(err, errlen, "invalid decode_argmax request");
+        return 1;
+    }
+    token = ds4_session_argmax(p->session);
+    for (uint32_t i = 0; i < n; i++) {
+        out[i] = token;
+        token_vec_push(&p->prompt, token);
+        if (i + 1u == n) break;
+        if (ds4_session_eval(p->session, token, err, errlen) != 0) return 1;
+        token = ds4_session_argmax(p->session);
+    }
     return 0;
+}
+
+static void pipeline_stage_print_i32_array(const int32_t *v, uint32_t n) {
+    printf("[");
+    for (uint32_t i = 0; i < n; i++) printf("%s%d", i ? "," : "", v[i]);
+    printf("]");
+}
+
+static int pipeline_stage_kv_smoke(ds4_pipeline_stage *stage) {
+    const char *mode = getenv("DS4_PIPELINE_KV_MODE");
+    const char *path = getenv("DS4_PIPELINE_KV_PATH");
+    const uint32_t n_decode = pipeline_stage_env_u32("DS4_PIPELINE_KV_DECODE_TOKENS", 5);
+    int32_t prompt_ids[4096];
+    int32_t decoded[256];
+    uint32_t prompt_count = 0;
+    char err[256] = {0};
+    struct stat st;
+    if (!mode || !mode[0]) return 0;
+    if (n_decode == 0 || n_decode > 256) {
+        fprintf(stderr, "ds4: invalid DS4_PIPELINE_KV_DECODE_TOKENS=%u\n", n_decode);
+        return 1;
+    }
+    if (!strcmp(mode, "live") || !strcmp(mode, "save")) {
+        if (pipeline_stage_parse_token_ids(getenv("DS4_PIPELINE_KV_TOKEN_IDS"), prompt_ids, 4096, &prompt_count, err, sizeof(err)) != 0) {
+            fprintf(stderr, "ds4: pipeline KV token parse failed: %s\n", err);
+            return 1;
+        }
+        if (ds4_pipeline_stage_prefill_chunk(stage, prompt_ids, prompt_count, err, sizeof(err)) != 0) {
+            fprintf(stderr, "ds4: pipeline KV prefill failed: %s\n", err);
+            return 1;
+        }
+    }
+    if (!strcmp(mode, "save")) {
+        if (pipeline_stage_save_kv(stage, path, err, sizeof(err)) != 0) {
+            fprintf(stderr, "ds4: pipeline save_kv failed: %s\n", err);
+            return 1;
+        }
+        if (stat(path, &st) != 0) memset(&st, 0, sizeof(st));
+        printf("{\"event\":\"save_kv\",\"stage_id\":%u,\"token_count\":%u,\"path\":\"%s\",\"bytes\":%llu}\n",
+               stage->cfg.stage_id,
+               prompt_count,
+               path ? path : "",
+               (unsigned long long)st.st_size);
+        fflush(stdout);
+        if (getenv("DS4_PIPELINE_KV_WAIT_AFTER_SAVE") != NULL) {
+            printf("{\"event\":\"save_kv_waiting\",\"stage_id\":%u,\"pid\":%ld}\n", stage->cfg.stage_id, (long)getpid());
+            fflush(stdout);
+            for (;;) pause();
+        }
+        return 0;
+    }
+    if (!strcmp(mode, "restore")) {
+        if (pipeline_stage_restore_kv(stage, path, err, sizeof(err)) != 0) {
+            fprintf(stderr, "ds4: pipeline restore_kv failed: %s\n", err);
+            return 1;
+        }
+        if (stat(path, &st) != 0) memset(&st, 0, sizeof(st));
+        if (pipeline_stage_decode_argmax_tokens(stage, n_decode, decoded, err, sizeof(err)) != 0) {
+            fprintf(stderr, "ds4: pipeline restore decode failed: %s\n", err);
+            return 1;
+        }
+        printf("{\"event\":\"restore_decode\",\"stage_id\":%u,\"path\":\"%s\",\"bytes\":%llu,\"decode_token_ids\":",
+               stage->cfg.stage_id,
+               path ? path : "",
+               (unsigned long long)st.st_size);
+        pipeline_stage_print_i32_array(decoded, n_decode);
+        printf("}\n");
+        fflush(stdout);
+        return 0;
+    }
+    if (!strcmp(mode, "live")) {
+        if (pipeline_stage_decode_argmax_tokens(stage, n_decode, decoded, err, sizeof(err)) != 0) {
+            fprintf(stderr, "ds4: pipeline live decode failed: %s\n", err);
+            return 1;
+        }
+        printf("{\"event\":\"live_decode\",\"stage_id\":%u,\"token_count\":%u,\"decode_token_ids\":",
+               stage->cfg.stage_id,
+               prompt_count);
+        pipeline_stage_print_i32_array(decoded, n_decode);
+        printf("}\n");
+        fflush(stdout);
+        return 0;
+    }
+    fprintf(stderr, "ds4: unknown DS4_PIPELINE_KV_MODE=%s\n", mode);
+    return 1;
 }
