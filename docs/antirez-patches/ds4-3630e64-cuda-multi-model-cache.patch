+static int cuda_model_set_fd_state(cuda_model_file_state *state, int fd) {
+    if (!state) return 0;
+    state->fd = fd;
+    state->file_size = 0;
+    if (state->direct_fd >= 0) {
+        (void)close(state->direct_fd);
+        state->direct_fd = -1;
+    }
+    state->direct_align = 1;
+    if (fd >= 0) {
+        struct stat st;
+        if (fstat(fd, &st) == 0 && st.st_size > 0) {
+            state->file_size = (uint64_t)st.st_size;
+            if (st.st_blksize > 1) state->direct_align = (uint64_t)st.st_blksize;
+        }
+#if defined(__linux__) && defined(O_DIRECT)
+        if (getenv("DS4_CUDA_NO_DIRECT_IO") == NULL) {
+            char proc_path[64];
+            snprintf(proc_path, sizeof(proc_path), "/proc/self/fd/%d", fd);
+            int direct_fd = open(proc_path, O_RDONLY | O_DIRECT);
+            if (direct_fd >= 0) {
+                state->direct_fd = direct_fd;
+                if (state->direct_align < 512) state->direct_align = 512;
+                if (getenv("DS4_CUDA_WEIGHT_CACHE_VERBOSE")) {
+                    fprintf(stderr, "ds4: CUDA model direct I/O enabled (align=%llu)\n",
+                            (unsigned long long)state->direct_align);
+                }
+            } else if (getenv("DS4_CUDA_WEIGHT_CACHE_VERBOSE")) {
+                fprintf(stderr, "ds4: CUDA model direct I/O unavailable: %s\n", strerror(errno));
+            }
+        }
+#endif
+    }
+    return 1;
+}
+
+extern "C" int ds4_gpu_set_model_fd_for_map(const void *model_map, int fd) {
+    if (!model_map) return 0;
+    cuda_model_file_state &state = g_model_file_state_by_base[model_map];
+    return cuda_model_set_fd_state(&state, fd);
