+__device__ __forceinline__ static uint32_t dev_u32le_load(const uint8_t *p) {
+    return ((uint32_t)p[0]) |
+           ((uint32_t)p[1] << 8) |
+           ((uint32_t)p[2] << 16) |
+           ((uint32_t)p[3] << 24);
+}
+
+__device__ __forceinline__ static uint8_t dev_u32_byte(uint32_t v, uint32_t i) {
+    return (uint8_t)((v >> (8u * i)) & 0xffu);
+}
+
+__device__ static float dev_q4_K_dot_f32(const cuda_block_q4_K *row, const float *x, uint32_t nb) {
+    float acc = 0.0f;
+    for (uint32_t b = 0; b < nb; b++) {
+        const cuda_block_q4_K *xb = row + b;
+        const float d = dev_f16_to_f32(xb->d);
+        const float dmin = dev_f16_to_f32(xb->dmin);
+        const uint32_t u0 = dev_u32le_load(xb->scales + 0);
+        const uint32_t u1 = dev_u32le_load(xb->scales + 4);
+        const uint32_t u2 = dev_u32le_load(xb->scales + 8);
+        const uint32_t kmask1 = 0x3f3f3f3fu;
+        const uint32_t kmask2 = 0x0f0f0f0fu;
+        const uint32_t kmask3 = 0x03030303u;
+        const uint32_t sc0 = u0 & kmask1;
+        const uint32_t sc1 = (u2 & kmask2) | (((u0 >> 6) & kmask3) << 4);
+        const uint32_t mn0 = u1 & kmask1;
+        const uint32_t mn1 = ((u2 >> 4) & kmask2) | (((u1 >> 6) & kmask3) << 4);
+        const float *xf = x + (uint64_t)b * CUDA_QK_K;
+        for (uint32_t g = 0; g < 8u; g++) {
+            const uint32_t base = (g >> 1) * 32u;
+            const float scale = d * (float)dev_u32_byte(g < 4u ? sc0 : sc1, g & 3u);
+            const float minv = dmin * (float)dev_u32_byte(g < 4u ? mn0 : mn1, g & 3u);
+            for (uint32_t i = 0; i < 32u; i++) {
+                const uint8_t packed = xb->qs[base + i];
+                const float q = (float)((g & 1u) ? (packed >> 4) : (packed & 0x0fu));
+                acc += ((scale * q) - minv) * xf[g * 32u + i];
+            }
+        }
+    }
+    return acc;
+}
