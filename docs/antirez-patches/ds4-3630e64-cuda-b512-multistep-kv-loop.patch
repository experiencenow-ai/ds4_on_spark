diff --git a/ds4.c b/ds4.c
--- a/ds4.c
+++ b/ds4.c
@@
+static uint32_t cuda_stack_probe_decode_steps(void) {
+    const char *env = getenv("DS4_CUDA_STACK_PROBE_DECODE_STEPS");
+    if (env && env[0]) {
+        char *end = NULL;
+        unsigned long v = strtoul(env, &end, 10);
+        if (end != env && v > 0 && v <= 16) return (uint32_t)v;
+    }
+    return 1u;
+}
+
+static bool cuda_stack_probe_seed_committed_tokens(
+        ds4_gpu_graph    *g,
+        const ds4_model  *model,
+        const ds4_weights *weights,
+        const int32_t    *host_committed,
+        uint32_t          n_tokens) {
+    if (!g || !model || !weights || !host_committed || n_tokens == 0 || n_tokens > g->prefill_cap) return false;
+    if (ds4_gpu_tensor_write(g->prefill_tokens,
+                             0,
+                             host_committed,
+                             (uint64_t)n_tokens * sizeof(host_committed[0])) == 0) return false;
+    return ds4_gpu_embed_tokens_hc_tensor(g->batch_cur_hc,
+                                          g->prefill_tokens,
+                                          model->map,
+                                          model->size,
+                                          weights->token_embd->abs_offset,
+                                          (uint32_t)weights->token_embd->dim[1],
+                                          n_tokens,
+                                          DS4_N_EMBD,
+                                          DS4_N_HC) != 0;
+}
@@
-    double *iter_ms = xmalloc((size_t)iterations * sizeof(iter_ms[0]));
-    double *token_commit_ms = xmalloc((size_t)iterations * sizeof(token_commit_ms[0]));
+    const uint32_t decode_steps = cuda_stack_probe_decode_steps();
+    double *iter_ms = xmalloc((size_t)iterations * (size_t)decode_steps * sizeof(iter_ms[0]));
+    double *token_commit_ms = xmalloc((size_t)iterations * (size_t)decode_steps * sizeof(token_commit_ms[0]));
+    double *kv_update_ms = xmalloc((size_t)iterations * (size_t)decode_steps * sizeof(kv_update_ms[0]));
+    uint64_t *step_token_hashes = xmalloc((size_t)iterations * (size_t)decode_steps * sizeof(step_token_hashes[0]));
@@
-    for (uint32_t it = 0; ok && it < iterations; it++) {
+    for (uint32_t it = 0; ok && it < iterations; it++) {
         if (ok) ok = cuda_stack_probe_reset_compressor_state(&g);
         if (ok) ok = cuda_batch_stack_probe_seed_input(&g, model, weights, host_tokens, host_hc, n_tokens, hc_dim, input_file, it);
         if (ok) ok = ds4_gpu_synchronize() != 0;
-        const double t0 = now_sec();
-        ok = cuda_batch_stack_probe_run(&g, model, weights, n_tokens, &token_profiles[it]);
-        const double t1 = now_sec();
-        const double ms = (t1 - t0) * 1000.0;
-        const double tc0 = now_sec();
+        for (uint32_t step = 0; ok && step < decode_steps; step++) {
+            const uint32_t slot = (it * decode_steps) + step;
+            const double t0 = now_sec();
+            ok = cuda_batch_stack_probe_run(&g, model, weights, n_tokens, &token_profiles[slot]);
+            const double t1 = now_sec();
+            iter_ms[slot] = (t1 - t0) * 1000.0;
+            const double tc0 = now_sec();
+            /*
+             * Existing batch-head/constrained-token commit code fills
+             * host_committed for every row here and records token_commit_ms.
+             */
+            step_token_hashes[slot] = hash_bytes(host_committed,
+                                                 (uint64_t)n_tokens * sizeof(host_committed[0]));
+            const double tc1 = now_sec();
+            token_commit_ms[slot] = (tc1 - tc0) * 1000.0;
+            if (ok && step + 1u < decode_steps) {
+                const double kv0 = now_sec();
+                ok = cuda_stack_probe_seed_committed_tokens(&g, model, weights, host_committed, n_tokens);
+                if (ok) ok = ds4_gpu_synchronize() != 0;
+                kv_update_ms[slot] = (now_sec() - kv0) * 1000.0;
+            }
+        }
@@
-        printf("],\"token_commit_ms\":[");
-        for (uint32_t i = 0; i < iterations; i++) printf("%s%.3f", i ? "," : "", token_commit_ms[i]);
+        printf("],\"decode_steps\":%u,\"kv_update_success\":%s", decode_steps, ok ? "true" : "false");
+        printf(",\"per_step_decode_ms\":[");
+        for (uint32_t i = 0; i < iterations * decode_steps; i++) printf("%s%.3f", i ? "," : "", iter_ms[i]);
+        printf("],\"per_step_token_commit_ms\":[");
+        for (uint32_t i = 0; i < iterations * decode_steps; i++) printf("%s%.3f", i ? "," : "", token_commit_ms[i]);
+        printf("],\"kv_update_ms\":[");
+        for (uint32_t i = 0; i < iterations * decode_steps; i++) printf("%s%.3f", i ? "," : "", kv_update_ms[i]);
+        printf("],\"per_step_token_hashes\":[");
+        for (uint32_t i = 0; i < iterations * decode_steps; i++) printf("%s\"%016" PRIx64 "\"", i ? "," : "", step_token_hashes[i]);
+        printf("],\"token_commit_ms\":[");
+        for (uint32_t i = 0; i < iterations * decode_steps; i++) printf("%s%.3f", i ? "," : "", token_commit_ms[i]);
@@
+    free(step_token_hashes);
+    free(kv_update_ms);
     free(token_commit_ms);
     free(iter_ms);
