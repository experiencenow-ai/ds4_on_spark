@@ -16793,6 +16793,140 @@ static bool cuda_stack_probe_include_head(void) {
     return getenv("DS4_CUDA_STACK_PROBE_NO_HEAD") == NULL;
 }
 
+static uint32_t cuda_stack_probe_layer_bound(const char *name, uint32_t fallback) {
+    const char *env = getenv(name);
+    if (!env || !env[0]) return fallback;
+    char *end = NULL;
+    unsigned long v = strtoul(env, &end, 10);
+    if (end == env || v > DS4_N_LAYER) return fallback;
+    return (uint32_t)v;
+}
+
+static uint32_t cuda_stack_probe_layer_begin(void) {
+    return cuda_stack_probe_layer_bound("DS4_CUDA_STACK_PROBE_LAYER_BEGIN", 0u);
+}
+
+static uint32_t cuda_stack_probe_layer_end(void) {
+    const uint32_t begin = cuda_stack_probe_layer_begin();
+    uint32_t end = cuda_stack_probe_layer_bound("DS4_CUDA_STACK_PROBE_LAYER_END", DS4_N_LAYER);
+    if (end < begin) end = begin;
+    return end;
+}
+
+static bool cuda_stack_probe_stage_has_head(void) {
+    return cuda_stack_probe_include_head() && cuda_stack_probe_layer_end() == DS4_N_LAYER;
+}
+
+static bool cuda_stack_probe_preload_stage_enabled(void) {
+    return getenv("DS4_CUDA_STACK_PROBE_PRELOAD_STAGE") != NULL;
+}
+
+static uint64_t cuda_stack_probe_preload_chunk_bytes(void) {
+    const char *env = getenv("DS4_CUDA_STACK_PROBE_PRELOAD_CHUNK_MB");
+    uint64_t mb = 64;
+    if (env && env[0]) {
+        char *end = NULL;
+        unsigned long long v = strtoull(env, &end, 10);
+        if (end != env && v > 0) mb = (uint64_t)v;
+    }
+    if (mb < 4) mb = 4;
+    if (mb > 512) mb = 512;
+    return mb * 1048576ull;
+}
+
+static void cuda_stack_probe_preload_pause(void) {
+    const char *env = getenv("DS4_CUDA_STACK_PROBE_PRELOAD_SLEEP_US");
+    if (!env || !env[0]) return;
+    char *end = NULL;
+    unsigned long v = strtoul(env, &end, 10);
+    if (end == env || v == 0 || v > 1000000ul) return;
+    usleep((useconds_t)v);
+}
+
+static bool cuda_stack_probe_cache_tensor(
+        const ds4_model  *model,
+        const ds4_tensor *t,
+        const char       *label,
+        uint64_t         *bytes_out,
+        uint32_t         *tensors_out) {
+    const uint64_t chunk_bytes = cuda_stack_probe_preload_chunk_bytes();
+    uint64_t done = 0;
+    uint32_t chunk = 0;
+    char chunk_label[128];
+    if (!t || t->bytes == 0) return true;
+    if (t->abs_offset > model->size || t->bytes > model->size - t->abs_offset) return false;
+    while (done < t->bytes) {
+        uint64_t n = t->bytes - done;
+        if (n > chunk_bytes) n = chunk_bytes;
+        snprintf(chunk_label, sizeof(chunk_label), "%s_c%u", label, chunk);
+        if (ds4_gpu_cache_model_range(model->map, model->size, t->abs_offset + done, n, chunk_label) == 0) return false;
+        done += n;
+        chunk++;
+        cuda_stack_probe_preload_pause();
+    }
+    if (bytes_out) *bytes_out += t->bytes;
+    if (tensors_out) (*tensors_out)++;
+    return true;
+}
+
+static bool cuda_stack_probe_preload_layer(
+        const ds4_model         *model,
+        const ds4_layer_weights *layer,
+        uint32_t                 il,
+        uint64_t                *bytes_out,
+        uint32_t                *tensors_out) {
+    const ds4_tensor *tensors[] = {
+        layer->hc_attn_fn, layer->hc_attn_scale, layer->hc_attn_base,
+        layer->attn_norm, layer->attn_q_a, layer->attn_q_a_norm,
+        layer->attn_q_b, layer->attn_kv, layer->attn_kv_a_norm,
+        layer->attn_sinks, layer->attn_output_a, layer->attn_output_b,
+        layer->attn_compressor_ape, layer->attn_compressor_kv,
+        layer->attn_compressor_gate, layer->attn_compressor_norm,
+        layer->indexer_attn_q_b, layer->indexer_proj,
+        layer->indexer_compressor_ape, layer->indexer_compressor_kv,
+        layer->indexer_compressor_gate, layer->indexer_compressor_norm,
+        layer->hc_ffn_fn, layer->hc_ffn_scale, layer->hc_ffn_base,
+        layer->ffn_norm, layer->ffn_gate_tid2eid, layer->ffn_gate_inp,
+        layer->ffn_exp_probs_b, layer->ffn_gate_exps, layer->ffn_up_exps,
+        layer->ffn_down_exps, layer->ffn_gate_shexp, layer->ffn_up_shexp,
+        layer->ffn_down_shexp,
+    };
+    char label[96];
+    for (uint32_t i = 0; i < sizeof(tensors) / sizeof(tensors[0]); i++) {
+        snprintf(label, sizeof(label), "stack_stage_l%u_t%u", il, i);
+        if (!cuda_stack_probe_cache_tensor(model, tensors[i], label, bytes_out, tensors_out)) return false;
+    }
+    return true;
+}
+
+static bool cuda_stack_probe_preload_stage(
+        const ds4_model   *model,
+        const ds4_weights *weights) {
+    const uint32_t begin = cuda_stack_probe_layer_begin();
+    const uint32_t end = cuda_stack_probe_layer_end();
+    uint64_t bytes = 0;
+    uint32_t tensors = 0;
+    if (begin >= end || end > DS4_N_LAYER) return false;
+    for (uint32_t il = begin; il < end; il++) {
+        if (!cuda_stack_probe_preload_layer(model, &weights->layer[il], il, &bytes, &tensors)) return false;
+    }
+    if (cuda_stack_probe_stage_has_head()) {
+        if (!cuda_stack_probe_cache_tensor(model, weights->output_hc_base, "stack_stage_output_hc_base", &bytes, &tensors)) return false;
+        if (!cuda_stack_probe_cache_tensor(model, weights->output_hc_fn, "stack_stage_output_hc_fn", &bytes, &tensors)) return false;
+        if (!cuda_stack_probe_cache_tensor(model, weights->output_hc_scale, "stack_stage_output_hc_scale", &bytes, &tensors)) return false;
+        if (!cuda_stack_probe_cache_tensor(model, weights->output_norm, "stack_stage_output_norm", &bytes, &tensors)) return false;
+        if (!cuda_stack_probe_cache_tensor(model, weights->output, "stack_stage_output", &bytes, &tensors)) return false;
+    }
+    if (ds4_gpu_synchronize() == 0) return false;
+    fprintf(stderr,
+            "ds4: CUDA stack stage preload cached layers [%u,%u) %u tensors %.2f GiB including routed experts\n",
+            begin,
+            end,
+            tensors,
+            (double)bytes / 1073741824.0);
+    return true;
+}
