+static int cuda_moe_prepare_decode_expert_slices(
+        const void *model_map,
+        uint64_t model_size,
+        uint64_t gate_offset,
+        uint64_t up_offset,
+        uint64_t down_offset,
+        uint64_t gate_expert_bytes,
+        uint64_t down_expert_bytes,
+        const ds4_gpu_tensor *selected,
+        uint32_t n_expert,
+        const char ***gate_slices_out,
+        const char ***up_slices_out,
+        const char ***down_slices_out) {
+    if (!model_map || !selected || !gate_slices_out || !up_slices_out || !down_slices_out ||
+        n_expert == 0u || n_expert > 8u ||
+        gate_expert_bytes == 0u || down_expert_bytes == 0u ||
+        selected->bytes < (uint64_t)n_expert * sizeof(int32_t)) {
+        return 0;
+    }
+    int32_t expert_ids[8] = {0};
+    const char *host_ptrs[24] = {NULL};
+    if (!cuda_ok(cudaMemcpy(expert_ids, selected->ptr, (size_t)n_expert * sizeof(int32_t), cudaMemcpyDeviceToHost),
+                 "routed_moe expert ids copy")) {
+        return 0;
+    }
+    for (uint32_t slot = 0; slot < n_expert; slot++) {
+        int32_t expert_i = expert_ids[slot];
+        if (expert_i < 0) expert_i = 0;
+        if (expert_i >= 256) return 0;
+        const uint64_t expert = (uint64_t)(uint32_t)expert_i;
+        const uint64_t gate_slice_offset = gate_offset + expert * gate_expert_bytes;
+        const uint64_t up_slice_offset = up_offset + expert * gate_expert_bytes;
+        const uint64_t down_slice_offset = down_offset + expert * down_expert_bytes;
+        if (gate_slice_offset < gate_offset ||
+            up_slice_offset < up_offset ||
+            down_slice_offset < down_offset ||
+            gate_slice_offset > model_size || gate_expert_bytes > model_size - gate_slice_offset ||
+            up_slice_offset > model_size || gate_expert_bytes > model_size - up_slice_offset ||
+            down_slice_offset > model_size || down_expert_bytes > model_size - down_slice_offset) {
+            return 0;
+        }
+        host_ptrs[slot] = cuda_model_range_ptr(model_map, gate_slice_offset, gate_expert_bytes, "moe_gate_expert");
+        host_ptrs[n_expert + slot] = cuda_model_range_ptr(model_map, up_slice_offset, gate_expert_bytes, "moe_up_expert");
+        host_ptrs[2u * n_expert + slot] = cuda_model_range_ptr(model_map, down_slice_offset, down_expert_bytes, "moe_down_expert");
+        if (!host_ptrs[slot] || !host_ptrs[n_expert + slot] || !host_ptrs[2u * n_expert + slot]) return 0;
+    }
+    const uint64_t ptr_count = 3ull * n_expert;
+    const uint64_t ptr_bytes = ptr_count * sizeof(const char *);
+    const char **dev_ptrs = (const char **)cuda_tmp_alloc(ptr_bytes, "routed_moe expert slice pointers");
+    if (!dev_ptrs) return 0;
+    if (!cuda_ok(cudaMemcpy(dev_ptrs, host_ptrs, (size_t)ptr_bytes, cudaMemcpyHostToDevice),
+                 "routed_moe expert slice pointer copy")) {
+        return 0;
+    }
+    *gate_slices_out = dev_ptrs;
+    *up_slices_out = dev_ptrs + n_expert;
+    *down_slices_out = dev_ptrs + 2u * n_expert;
+    if (getenv("DS4_CUDA_MOE_EXPERT_SLICE_VERBOSE") != NULL) {
+        fprintf(stderr, "ds4: CUDA MoE expert slice cache prepared %u selected experts (%.2f MiB)\n",
+                n_expert,
+                (double)(n_expert * (2ull * gate_expert_bytes + down_expert_bytes)) / 1048576.0);
+    }
+    return 1;
+}
