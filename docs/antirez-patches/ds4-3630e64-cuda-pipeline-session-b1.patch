+typedef struct
+{
+    const ds4_tensor *tensor;
+    const char *name;
+} cuda_stack_probe_tensor_entry;
+
+static bool cuda_stack_probe_preload_layer(
+        const ds4_model         *model,
+        const ds4_layer_weights *layer,
+        uint32_t                 il,
+        uint64_t                *bytes_out,
+        uint32_t                *tensors_out) {
+    const cuda_stack_probe_tensor_entry tensors[] = {
+        {layer->hc_attn_fn, "hc_attn_fn"}, {layer->hc_attn_scale, "hc_attn_scale"}, {layer->hc_attn_base, "hc_attn_base"},
+        {layer->attn_norm, "attn_norm"}, {layer->attn_q_a, "attn_q_a"}, {layer->attn_q_a_norm, "attn_q_a_norm"},
+        {layer->attn_q_b, "attn_q_b"}, {layer->attn_kv, "attn_kv"}, {layer->attn_kv_a_norm, "attn_kv_a_norm"},
+        {layer->attn_sinks, "attn_sinks"}, {layer->attn_output_a, "attn_output_a"}, {layer->attn_output_b, "attn_output_b"},
+        {layer->attn_compressor_ape, "attn_compressor_ape"}, {layer->attn_compressor_kv, "attn_compressor_kv"},
+        {layer->attn_compressor_gate, "attn_compressor_gate"}, {layer->attn_compressor_norm, "attn_compressor_norm"},
+        {layer->indexer_attn_q_b, "indexer_attn_q_b"}, {layer->indexer_proj, "indexer_proj"},
+        {layer->indexer_compressor_ape, "indexer_compressor_ape"}, {layer->indexer_compressor_kv, "indexer_compressor_kv"},
+        {layer->indexer_compressor_gate, "indexer_compressor_gate"}, {layer->indexer_compressor_norm, "indexer_compressor_norm"},
+        {layer->hc_ffn_fn, "hc_ffn_fn"}, {layer->hc_ffn_scale, "hc_ffn_scale"}, {layer->hc_ffn_base, "hc_ffn_base"},
+        {layer->ffn_norm, "ffn_norm"}, {layer->ffn_gate_tid2eid, "ffn_gate_tid2eid"}, {layer->ffn_gate_inp, "ffn_gate_inp"},
+        {layer->ffn_exp_probs_b, "ffn_exp_probs_b"}, {layer->ffn_gate_exps, "ffn_gate_exps"}, {layer->ffn_up_exps, "ffn_up_exps"},
+        {layer->ffn_down_exps, "ffn_down_exps"}, {layer->ffn_gate_shexp, "ffn_gate_shexp"}, {layer->ffn_up_shexp, "ffn_up_shexp"},
+        {layer->ffn_down_shexp, "ffn_down_shexp"},
+    };
+    char label[96];
+    for (uint32_t i = 0; i < sizeof(tensors) / sizeof(tensors[0]); i++) {
+        snprintf(label, sizeof(label), "stack_stage_l%u_%s", il, tensors[i].name);
+        if (!cuda_stack_probe_cache_tensor(model, tensors[i].tensor, label, bytes_out, tensors_out)) return false;
+    }
+    return true;
+}
