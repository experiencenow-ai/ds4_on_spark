+int ds4_engine_cuda_output_head_probe(ds4_engine *e, uint32_t iterations) {
+#ifdef DS4_NO_GPU
+    (void)e;
+    (void)iterations;
+    fprintf(stderr, "ds4: CUDA output head probe requested but this build has no graph backend support\n");
+    return 1;
+#else
+    if (!e || e->backend != DS4_BACKEND_CUDA || !e->metal_ready) {
+        fprintf(stderr, "ds4: CUDA output head probe requires an initialized CUDA backend\n");
+        return 1;
+    }
+    if (iterations == 0) {
+        fprintf(stderr, "ds4: invalid CUDA output head probe iterations=%u\n", iterations);
+        return 1;
+    }
+    const ds4_model *model = &e->model;
+    const ds4_weights *weights = &e->weights;
+    const uint64_t hc_dim = (uint64_t)DS4_N_HC * DS4_N_EMBD;
+    const uint64_t logits_bytes = (uint64_t)weights->output->dim[1] * sizeof(float);
+    uint8_t *host_logits = xmalloc((size_t)logits_bytes);
+    ds4_gpu_graph g;
+    bool ok = metal_graph_alloc_raw_cap(&g, weights, &weights->layer[0], DS4_N_SWA, DS4_N_SWA, 1, false);
+    double total_ms = 0.0;
+    double best_ms = 0.0;
+    for (uint32_t it = 0; ok && it < iterations; it++) {
+        if (ok) ok = cuda_probe_seed_tensor(g.cur_hc, hc_dim, 0x7100u + it);
+        if (ok) ok = ds4_gpu_synchronize() != 0;
+        const double t0 = now_sec();
+        if (ok) ok = ds4_gpu_begin_commands() != 0;
+        if (ok) ok = metal_graph_encode_output_head(&g, model, weights, weights->output->dim[1]);
+        if (ok) ok = ds4_gpu_end_commands() != 0;
+        if (ok) ok = ds4_gpu_synchronize() != 0;
+        const double t1 = now_sec();
+        const double ms = (t1 - t0) * 1000.0;
+        if (ok) {
+            total_ms += ms;
+            if (it == 0 || ms < best_ms) best_ms = ms;
+            fprintf(stderr, "ds4: CUDA output head probe iter=%u ms=%.3f\n", it, ms);
+        }
+    }
+    uint64_t logits_hash = 0;
+    uint64_t logits_nonfinite = 0;
+    if (ok) {
+        ok = ds4_gpu_tensor_read(g.logits, 0, host_logits, logits_bytes) != 0;
+        if (ok) {
+            logits_hash = hash_bytes(host_logits, logits_bytes);
+            logits_nonfinite = cuda_probe_nonfinite_count(host_logits, logits_bytes);
+        }
+    }
+    if (ok) {
+        const double avg_ms = total_ms / (double)iterations;
+        printf("{\"cuda_output_head_probe\":true,\"iterations\":%u,\"avg_ms\":%.3f,\"best_ms\":%.3f,\"best_heads_per_s\":%.3f,\"logits_fnv64\":\"%016" PRIx64 "\",\"logits_nonfinite\":%" PRIu64 "}\n",
+               iterations,
+               avg_ms,
+               best_ms,
+               best_ms > 0.0 ? 1000.0 / best_ms : 0.0,
+               logits_hash,
+               logits_nonfinite);
+    }
+    metal_graph_free(&g);
+    free(host_logits);
+    if (!ok) {
+        fprintf(stderr, "ds4: CUDA output head probe failed\n");
+        return 1;
+    }
+    return 0;
+#endif
+}
