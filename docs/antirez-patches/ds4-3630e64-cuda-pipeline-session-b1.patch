+    const uint64_t ptr_bytes = ptr_count * sizeof(const char *);
+    const char **dev_ptrs = (const char **)cuda_tmp_alloc(ptr_bytes, "routed_moe expert slice pointers");
+    if (!dev_ptrs) return 0;
+    if (!cuda_ok(cudaMemcpy(dev_ptrs, host_ptrs, (size_t)ptr_bytes, cudaMemcpyHostToDevice),
+                 "routed_moe expert slice pointer copy")) {
+        return 0;
+    }
+    *gate_slices_out = dev_ptrs;
+    *up_slices_out = dev_ptrs + n_expert;
+    *down_slices_out = dev_ptrs + 2u * n_expert;
+    if (getenv("DS4_CUDA_MOE_EXPERT_SLICE_VERBOSE") != NULL) {
+        fprintf(stderr, "ds4: CUDA MoE expert slice cache prepared %u selected experts (%.2f MiB)\n",
+                n_expert,
