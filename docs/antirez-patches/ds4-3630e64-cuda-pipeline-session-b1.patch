+static bool cuda_batch_stack_probe_seed_input(
+        ds4_gpu_graph    *g,
+        const ds4_model  *model,
+        const ds4_weights *weights,
+        const int32_t    *host_tokens,
+        float            *host_hc,
+        uint32_t          n_tokens,
+        uint64_t          hc_dim,
+        const char       *input_file,
+        uint32_t          iter) {
+    const uint64_t hc_floats = (uint64_t)n_tokens * hc_dim;
+    if (input_file) {
+        char path[1024];
+        if (!cuda_stack_probe_format_boundary_path(input_file, iter, path, sizeof(path))) return false;
+        const uint32_t wait_ms = cuda_stack_probe_input_wait_ms();
+        uint32_t waited = 0;
+        while (waited <= wait_ms) {
+            struct stat st;
+            if (stat(path, &st) == 0 && st.st_size >= 0 && (uint64_t)st.st_size == hc_floats * sizeof(host_hc[0])) break;
+            if (waited >= wait_ms) break;
+            usleep(10000);
+            waited += 10;
+        }
+        if (!read_f32_binary_file(path, host_hc, hc_floats)) return false;
+        return ds4_gpu_tensor_write(g->batch_cur_hc, 0, host_hc, hc_floats * sizeof(host_hc[0])) != 0;
+    }
+    if (cuda_stack_probe_use_embedding_input() && cuda_stack_probe_layer_begin() == 0) {
+        token_vec prompt = {0};
+        bool ok = true;
+        for (uint32_t i = 0; ok && i < n_tokens; i++) token_vec_push(&prompt, host_tokens[i]);
+        if (ok) ok = metal_graph_upload_prompt_embeddings_hc(g->batch_cur_hc,
+                                                             g->prefill_tokens,
+                                                             model,
+                                                             weights,
+                                                             &prompt,
+                                                             0,
+                                                             n_tokens);
+        token_vec_free(&prompt);
+        return ok;
+    }
+    return ds4_gpu_tensor_write(g->batch_cur_hc, 0, host_hc, hc_floats * sizeof(host_hc[0])) != 0;
+}
+
+static bool cuda_batch_stack_probe_write_output(
+        const char *output_file,
+        uint32_t    iter,
+        const float *host_out,
+        uint64_t    hc_floats) {
+    if (!output_file) return true;
+    char path[1024];
+    if (!cuda_stack_probe_format_boundary_path(output_file, iter, path, sizeof(path))) return false;
+    return write_f32_binary_file(path, host_out, hc_floats);
+}
+
+static bool cuda_stack_probe_commit_constrained_tokens(
+        const ds4_model  *model,
+        const ds4_tensor *output,
+        const float      *host_norm,
+        uint32_t          n_tokens,
+        const int32_t    *candidate_ids,
+        uint32_t          candidate_count,
+        int8_t           *xq,
+        float            *xscale,
+        int32_t          *host_committed) {
+    if (!model || !output || !host_norm || !candidate_ids || !xq || !xscale || !host_committed) return false;
+    if (output->type != DS4_TENSOR_Q8_0 || output->ndim != 2 || output->dim[0] != DS4_N_EMBD) return false;
+    const uint64_t blocks = (DS4_N_EMBD + 31u) / 32u;
+    const uint64_t vocab_dim = output->dim[1];
+    const uint8_t *data = tensor_data(model, output);
+    for (uint32_t t = 0; t < n_tokens; t++) {
+        quantize_q8_0_activation(host_norm + (uint64_t)t * DS4_N_EMBD,
+                                 xq + (uint64_t)t * blocks * 32u,
+                                 xscale + (uint64_t)t * blocks,
+                                 DS4_N_EMBD);
+        float best = -INFINITY;
+        int32_t best_id = -1;
+        for (uint32_t i = 0; i < candidate_count; i++) {
+            const int32_t id = candidate_ids[i];
+            if (id < 0 || (uint64_t)id >= vocab_dim) return false;
+            const uint8_t *row = data + (uint64_t)id * blocks * 34u;
+            const float score = dot_q8_0_row(row,
+                                             xq + (uint64_t)t * blocks * 32u,
+                                             xscale + (uint64_t)t * blocks,
+                                             DS4_N_EMBD,
+                                             blocks);
+            if (i == 0 || score > best) {
+                best = score;
+                best_id = id;
+            }
+        }
+        host_committed[t] = best_id;
+    }
+    return true;
+}
