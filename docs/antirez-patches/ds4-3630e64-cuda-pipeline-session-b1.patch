+static bool cuda_decode_stack_probe_run(
+        ds4_gpu_graph       *g,
+        const ds4_model     *model,
+        const ds4_weights   *weights,
+        uint32_t             pos,
+        const uint32_t      *n_comp_base,
+        const uint32_t      *n_index_base) {
+    cuda_decode_stack_probe_set_counts(g, n_comp_base, n_index_base);
+    const uint32_t raw_row = pos % g->raw_cap;
+    const uint32_t n_raw = metal_graph_raw_span_for_batch(g, pos, 1);
+    const uint32_t split_layers = cuda_stack_probe_split_layers();
+    const uint32_t begin = cuda_stack_probe_layer_begin();
+    const uint32_t end = cuda_stack_probe_layer_end();
+    bool ok = ds4_gpu_begin_commands() != 0;
+    for (uint32_t il = begin; ok && il < end; il++) {
+        ok = metal_graph_encode_decode_layer(g,
+                                             model,
+                                             &weights->layer[il],
+                                             il,
+                                             pos,
+                                             g->layer_raw_cache[il],
+                                             g->raw_cap,
+                                             raw_row,
+                                             n_raw,
+                                             17);
+        ds4_gpu_tensor *tmp = g->cur_hc;
+        g->cur_hc = g->after_ffn_hc;
+        g->after_ffn_hc = tmp;
+        if (ok && split_layers != 0 && il + 1u < DS4_N_LAYER &&
+            ((il + 1u) % split_layers) == 0u) {
+            ok = ds4_gpu_flush_commands() != 0;
+        }
+    }
+    if (ok && cuda_stack_probe_stage_has_head()) {
+        ok = metal_graph_encode_output_head(g, model, weights, weights->output->dim[1]);
+    }
+    if (ok) {
+        ok = ds4_gpu_end_commands() != 0;
+    } else {
+        (void)ds4_gpu_synchronize();
+    }
+    if (ok) ok = ds4_gpu_synchronize() != 0;
+    return ok;
+}
+
+typedef struct
+{
+    double final_hidden_ms;
+    double output_head_ms;
+    double top1_argmax_ms;
+    double sync_wait_ms;
+} cuda_stack_probe_token_profile;
+
+static bool cuda_batch_stack_probe_run(
+        ds4_gpu_graph       *g,
+        const ds4_model     *model,
+        const ds4_weights   *weights,
+        uint32_t             n_tokens,
+        cuda_stack_probe_token_profile *profile) {
+    const uint32_t split_layers = cuda_stack_probe_split_layers();
+    const uint32_t begin = cuda_stack_probe_layer_begin();
+    const uint32_t end = cuda_stack_probe_layer_end();
+    const bool profile_enabled = profile && cuda_stack_probe_token_profile_enabled() && cuda_stack_probe_stage_has_head();
+    const bool constrained_commit = cuda_stack_probe_constrained_commit();
+    const double run_start = now_sec();
+    if (profile) memset(profile, 0, sizeof(*profile));
+    bool ok = ds4_gpu_begin_commands() != 0;
+    bool commands_open = ok;
+    for (uint32_t il = begin; ok && il < end; il++) {
+        ok = metal_graph_encode_layer_batch(g, model, &weights->layer[il], il, 0, n_tokens);
+        if (ok && split_layers != 0 && il + 1u < DS4_N_LAYER &&
+            ((il + 1u) % split_layers) == 0u) {
+            ok = ds4_gpu_flush_commands() != 0;
+        }
+    }
+    if (ok && profile_enabled) {
+        ok = ds4_gpu_end_commands() != 0;
+        commands_open = false;
+        const double sync0 = now_sec();
+        if (ok) ok = ds4_gpu_synchronize() != 0;
+        const double sync1 = now_sec();
+        profile->final_hidden_ms = (sync1 - run_start) * 1000.0;
+        profile->sync_wait_ms += (sync1 - sync0) * 1000.0;
+        if (ok) ok = ds4_gpu_begin_commands() != 0;
+        commands_open = ok;
+    }
+    ds4_gpu_tensor *last_hc = NULL;
+    ds4_gpu_tensor *saved_cur = g->cur_hc;
+    const bool batch_head = cuda_stack_probe_batch_head();
+    if (ok && cuda_stack_probe_stage_has_head() && batch_head && constrained_commit) {
+        const double head0 = now_sec();
+        ok = metal_graph_encode_output_head_batch_norm_only(g, model, weights, n_tokens);
+        if (ok) {
+            const uint64_t hc_dim = (uint64_t)DS4_N_HC * DS4_N_EMBD;
+            last_hc = metal_graph_tensor_row_view(g->batch_cur_hc, n_tokens - 1u, hc_dim);
+            ok = last_hc != NULL;
+        }
+        if (ok) {
+            g->cur_hc = last_hc;
+            ok = metal_graph_encode_output_head(g, model, weights, weights->output->dim[1]);
+            g->cur_hc = saved_cur;
+        }
+        if (ok && profile_enabled) {
+            ok = ds4_gpu_end_commands() != 0;
+            commands_open = false;
+            const double sync0 = now_sec();
+            if (ok) ok = ds4_gpu_synchronize() != 0;
+            const double sync1 = now_sec();
+            profile->output_head_ms = (sync1 - head0) * 1000.0;
+            profile->sync_wait_ms += (sync1 - sync0) * 1000.0;
+        }
+    } else if (ok && cuda_stack_probe_stage_has_head() && batch_head) {
+        const double head0 = now_sec();
+        ok = metal_graph_encode_output_head_batch(g, model, weights, n_tokens, weights->output->dim[1]);
+        if (ok && profile_enabled) {
+            ok = ds4_gpu_end_commands() != 0;
+            commands_open = false;
+            const double sync0 = now_sec();
+            if (ok) ok = ds4_gpu_synchronize() != 0;
+            const double sync1 = now_sec();
+            profile->output_head_ms = (sync1 - head0) * 1000.0;
+            profile->sync_wait_ms += (sync1 - sync0) * 1000.0;
+            if (ok) ok = ds4_gpu_begin_commands() != 0;
+            commands_open = ok;
+        }
+        const double top0 = now_sec();
+        if (ok) ok = ds4_gpu_indexer_topk_tensor(g->comp_selected,
+                                                   g->spec_logits,
+                                                   DS4_N_VOCAB,
+                                                   1,
+                                                   n_tokens) != 0;
+        if (ok && profile_enabled) {
+            ok = ds4_gpu_end_commands() != 0;
+            commands_open = false;
+            const double sync0 = now_sec();
+            if (ok) ok = ds4_gpu_synchronize() != 0;
+            const double sync1 = now_sec();
+            profile->top1_argmax_ms = (sync1 - top0) * 1000.0;
+            profile->sync_wait_ms += (sync1 - sync0) * 1000.0;
+        }
+    } else if (ok && cuda_stack_probe_stage_has_head()) {
+        const uint64_t hc_dim = (uint64_t)DS4_N_HC * DS4_N_EMBD;
+        last_hc = metal_graph_tensor_row_view(g->batch_cur_hc, n_tokens - 1u, hc_dim);
+        ok = last_hc != NULL;
+        if (ok) {
+            g->cur_hc = last_hc;
+            ok = metal_graph_encode_output_head(g, model, weights, weights->output->dim[1]);
+            g->cur_hc = saved_cur;
+        }
+    }
+    if (ok && commands_open) {
+        ok = ds4_gpu_end_commands() != 0;
+    } else {
+        g->cur_hc = saved_cur;
+        if (!ok) (void)ds4_gpu_synchronize();
+    }
+    g->cur_hc = saved_cur;
+    if (last_hc) ds4_gpu_tensor_free(last_hc);
+    if (ok && !profile_enabled) ok = ds4_gpu_synchronize() != 0;
+    return ok;
