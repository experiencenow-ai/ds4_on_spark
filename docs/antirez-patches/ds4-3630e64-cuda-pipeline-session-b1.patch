+#ifndef DS4_NO_GPU
+static bool cuda_stack_probe_preload_stage(const ds4_model *model, const ds4_weights *weights);
+#endif
+
+static uint32_t pipeline_env_u32(const char *name, uint32_t fallback) {
+    const char *env = getenv(name);
+    if (!env || !env[0]) return fallback;
+    char *end = NULL;
+    unsigned long v = strtoul(env, &end, 10);
+    if (end == env || v > UINT32_MAX) return fallback;
+    return (uint32_t)v;
+}
+
+static const char *pipeline_env_path(const char *name) {
+    const char *env = getenv(name);
+    return (env && env[0]) ? env : NULL;
+}
+
+static bool pipeline_format_step_path(const char *pattern, uint32_t step, char *buf, size_t buflen) {
+    if (!pattern || !buf || buflen == 0) return false;
+    int n = strchr(pattern, '%') ?
+        snprintf(buf, buflen, pattern, step) :
+        snprintf(buf, buflen, "%s", pattern);
+    return n > 0 && (size_t)n < buflen;
+}
+
+static bool pipeline_wait_path(const char *path, uint64_t bytes, uint32_t wait_ms) {
+    uint32_t waited = 0;
+    while (waited <= wait_ms) {
+        struct stat st;
+        if (stat(path, &st) == 0 && st.st_size >= 0 && (uint64_t)st.st_size == bytes) return true;
+        if (waited >= wait_ms) break;
+        usleep(10000);
+        waited += 10;
+    }
+    return false;
+}
+
+static uint32_t pipeline_read_i32_file(const char *path, int32_t *ids, uint32_t cap) {
+    if (!path || !ids || cap == 0) return 0;
+    FILE *fp = fopen(path, "rb");
+    uint32_t n = 0;
+    if (!fp) return 0;
+    while (n < cap && fread(&ids[n], sizeof(ids[n]), 1, fp) == 1) {
+        if (ids[n] < 0) break;
+        n++;
+    }
+    fclose(fp);
+    return n;
+}
+
+static uint64_t pipeline_nonfinite_count(const float *x, uint64_t n) {
+    uint64_t count = 0;
+    if (!x) return 0;
+    for (uint64_t i = 0; i < n; i++) {
+        if (!isfinite(x[i])) count++;
+    }
+    return count;
+}
+
+#ifndef DS4_NO_GPU
+static bool pipeline_read_hc_file(ds4_gpu_tensor *dst, const char *pattern, uint32_t step, float *host, uint64_t hc_floats, uint32_t wait_ms) {
+    char path[1024];
+    if (!pipeline_format_step_path(pattern, step, path, sizeof(path))) return false;
+    if (!pipeline_wait_path(path, hc_floats * sizeof(host[0]), wait_ms)) return false;
+    if (!read_f32_binary_file(path, host, hc_floats)) return false;
+    return ds4_gpu_tensor_write(dst, 0, host, hc_floats * sizeof(host[0])) != 0;
+}
+
+static bool pipeline_write_hc_file(ds4_gpu_tensor *src, const char *pattern, uint32_t step, float *host, uint64_t hc_floats, uint64_t *hash_out, uint64_t *nonfinite_out) {
+    char path[1024];
+    if (!pipeline_format_step_path(pattern, step, path, sizeof(path))) return false;
+    if (ds4_gpu_tensor_read(src, 0, host, hc_floats * sizeof(host[0])) == 0) return false;
+    if (hash_out) *hash_out = hash_bytes(host, hc_floats * sizeof(host[0]));
+    if (nonfinite_out) *nonfinite_out = pipeline_nonfinite_count(host, hc_floats);
+    return write_f32_binary_file(path, host, hc_floats);
+}
+
+static bool pipeline_write_token_file(const char *pattern, uint32_t step, int32_t token) {
+    char path[1024];
+    if (!pipeline_format_step_path(pattern, step, path, sizeof(path))) return false;
+    FILE *fp = fopen(path, "wb");
+    if (!fp) return false;
+    bool ok = fwrite(&token, sizeof(token), 1, fp) == 1;
+    fclose(fp);
+    return ok;
+}
+
+static bool pipeline_read_token_step(const char *pattern, uint32_t step, uint32_t wait_ms, int32_t *token) {
+    char path[1024];
+    if (!token || !pipeline_format_step_path(pattern, step, path, sizeof(path))) return false;
+    if (!pipeline_wait_path(path, sizeof(*token), wait_ms)) return false;
+    return pipeline_read_i32_file(path, token, 1) == 1;
+}
+
+static bool pipeline_encode_prefill_range(ds4_gpu_graph *g, const ds4_model *model, const ds4_weights *weights, uint32_t begin, uint32_t end, uint32_t n_tokens) {
+    bool ok = ds4_gpu_begin_commands() != 0;
+    for (uint32_t il = begin; ok && il < end; il++) {
+        ok = metal_graph_encode_layer_batch(g, model, &weights->layer[il], il, 0, n_tokens);
+    }
+    if (ok) ok = ds4_gpu_end_commands() != 0;
+    else (void)ds4_gpu_synchronize();
+    if (ok) ok = ds4_gpu_synchronize() != 0;
+    return ok;
+}
+
+static bool pipeline_encode_decode_range(ds4_gpu_graph *g, const ds4_model *model, const ds4_weights *weights, uint32_t begin, uint32_t end, uint32_t pos, int32_t token) {
+    const uint32_t raw_row = pos % g->raw_cap;
+    const uint32_t n_raw = metal_graph_raw_span_for_batch(g, pos, 1);
+    bool ok = ds4_gpu_begin_commands() != 0;
+    for (uint32_t il = begin; ok && il < end; il++) {
+        ok = metal_graph_encode_decode_layer(g, model, &weights->layer[il], il, pos, g->layer_raw_cache[il], g->raw_cap, raw_row, n_raw, token);
+        ds4_gpu_tensor *tmp = g->cur_hc;
+        g->cur_hc = g->after_ffn_hc;
+        g->after_ffn_hc = tmp;
+    }
+    if (ok) ok = ds4_gpu_end_commands() != 0;
+    else (void)ds4_gpu_synchronize();
+    if (ok) ok = ds4_gpu_synchronize() != 0;
+    return ok;
+}
+
+static bool pipeline_emit_output_head(ds4_gpu_graph *g, const ds4_model *model, const ds4_weights *weights, float *logits, int32_t *token, uint64_t *hash_out, uint64_t *nonfinite_out) {
+    bool ok = ds4_gpu_begin_commands() != 0;
+    if (ok) ok = metal_graph_encode_output_head(g, model, weights, weights->output->dim[1]);
+    if (ok) ok = ds4_gpu_end_commands() != 0;
+    else (void)ds4_gpu_synchronize();
+    if (ok) ok = ds4_gpu_tensor_read(g->logits, 0, logits, (uint64_t)DS4_N_VOCAB * sizeof(logits[0])) != 0;
+    if (ok) {
+        *token = sample_argmax(logits, DS4_N_VOCAB);
+        if (hash_out) *hash_out = hash_bytes(logits, (uint64_t)DS4_N_VOCAB * sizeof(logits[0]));
+        if (nonfinite_out) *nonfinite_out = pipeline_nonfinite_count(logits, DS4_N_VOCAB);
+    }
+    return ok;
+}
+
+static void pipeline_print_token_bytes(ds4_engine *e, int32_t token) {
+    size_t len = 0;
+    char *text = ds4_token_text(e, token, &len);
+    printf(",\"token_bytes\":[");
+    for (size_t i = 0; i < len; i++) {
+        printf("%s%u", i ? "," : "", (unsigned int)(uint8_t)text[i]);
+    }
+    printf("]");
+    free(text);
+}
+#endif
