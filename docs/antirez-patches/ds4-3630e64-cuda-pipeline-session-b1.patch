+    return 1;
+#else
+    if (!e || e->backend != DS4_BACKEND_CUDA || !e->metal_ready) {
+        fprintf(stderr, "ds4: CUDA decode probe requires an initialized CUDA backend\n");
+        return 1;
+    }
+    if (il >= DS4_N_LAYER || iterations == 0 || pos > 1048576u) {
+        fprintf(stderr, "ds4: invalid CUDA decode probe arguments layer=%u pos=%u iterations=%u\n",
+                il, pos, iterations);
+        return 1;
+    }
+    const ds4_model *model = &e->model;
+    const ds4_weights *weights = &e->weights;
+    const ds4_layer_weights *layer = &weights->layer[il];
+    if (!layer->attn_q_a || !layer->attn_q_b || !layer->attn_kv ||
+        !layer->attn_output_a || !layer->attn_output_b ||
+        !layer->ffn_gate_inp || !layer->ffn_gate_exps || !layer->ffn_up_exps ||
+        !layer->ffn_down_exps || !layer->ffn_gate_shexp || !layer->ffn_up_shexp ||
+        !layer->ffn_down_shexp) {
+        fprintf(stderr, "ds4: CUDA decode probe layer %u is missing decode tensors\n", il);
+        return 1;
+    }
+    const uint32_t ctx_size = pos + 1u;
+    const uint32_t raw_cap = DS4_N_SWA;
+    const uint32_t n_raw = ctx_size < raw_cap ? ctx_size : raw_cap;
+    const uint64_t hc_dim = (uint64_t)DS4_N_HC * DS4_N_EMBD;
+    const uint64_t hc_bytes = hc_dim * sizeof(float);
+    uint8_t *host_out = xmalloc((size_t)hc_bytes);
+    ds4_gpu_graph g;
+    bool ok = metal_graph_alloc_raw_cap(&g, weights, layer, raw_cap, ctx_size, 1, false);
+    uint32_t n_comp = 0;
+    uint32_t n_index_comp = 0;
+    if (ok) {
+        n_comp = cuda_decode_probe_comp_before(il, pos, g.layer_comp_cap[il]);
+        n_index_comp = ds4_layer_compress_ratio(il) == 4 ? n_comp : 0;
+        ok = cuda_probe_seed_tensor(g.cur_hc, hc_dim, 0x1000u + il);
+    }
+    if (ok) ok = cuda_probe_seed_tensor(g.layer_raw_cache[il],
+                                        (uint64_t)raw_cap * DS4_N_HEAD_DIM,
+                                        0x2000u + il);
+    if (ok && n_comp != 0) {
+        ok = cuda_probe_seed_tensor(g.layer_attn_comp_cache[il],
+                                    (uint64_t)n_comp * DS4_N_HEAD_DIM,
+                                    0x3000u + il);
+    }
+    if (ok && n_index_comp != 0) {
+        ok = cuda_probe_seed_tensor(g.layer_index_comp_cache[il],
+                                    (uint64_t)n_index_comp * DS4_N_INDEXER_HEAD_DIM,
+                                    0x4000u + il);
+    }
+    if (ok) ok = ds4_gpu_synchronize() != 0;
+    double total_ms = 0.0;
+    double best_ms = 0.0;
+    for (uint32_t it = 0; ok && it < iterations; it++) {
+        const double t0 = now_sec();
+        ok = cuda_decode_probe_run(&g, model, layer, il, pos, n_comp, n_index_comp);
+        const double t1 = now_sec();
+        const double ms = (t1 - t0) * 1000.0;
+        if (ok) {
+            total_ms += ms;
+            if (it == 0 || ms < best_ms) best_ms = ms;
+            fprintf(stderr, "ds4: CUDA decode probe iter=%u ms=%.3f\n", it, ms);
+        }
+    }
+    uint64_t out_hash = 0;
+    uint64_t out_nonfinite = 0;
+    if (ok) {
+        ok = ds4_gpu_tensor_read(g.after_ffn_hc, 0, host_out, hc_bytes) != 0;
+        if (ok) {
+            out_hash = hash_bytes(host_out, hc_bytes);
+            out_nonfinite = cuda_probe_nonfinite_count(host_out, hc_bytes);
+        }
+    }
+    if (ok) {
+        const double avg_ms = total_ms / (double)iterations;
+        printf("{\"cuda_decode_probe\":true,\"layer\":%u,\"pos\":%u,\"iterations\":%u,\"raw_cap\":%u,\"n_raw\":%u,\"n_comp\":%u,\"n_index_comp\":%u,\"compress_ratio\":%u,\"avg_ms\":%.3f,\"best_ms\":%.3f,\"best_layer_tokens_per_s\":%.3f,\"out_fnv64\":\"%016" PRIx64 "\",\"out_nonfinite\":%" PRIu64 "}\n",
+               il,
+               pos,
+               iterations,
+               raw_cap,
+               n_raw,
+               n_comp,
+               n_index_comp,
+               ds4_layer_compress_ratio(il),
+               avg_ms,
+               best_ms,
+               best_ms > 0.0 ? 1000.0 / best_ms : 0.0,
+               out_hash,
+               out_nonfinite);
+    }
+    metal_graph_free(&g);
+    free(host_out);
+    if (!ok) {
+        fprintf(stderr, "ds4: CUDA decode probe failed\n");
+        return 1;
+    }
+    return 0;
+#endif
+}
