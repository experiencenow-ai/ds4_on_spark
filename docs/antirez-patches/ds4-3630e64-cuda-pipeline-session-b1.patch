+    const char *path = getenv("DS4_CUDA_STACK_PROBE_ROW_TOKEN_IDS_FILE");
+    uint32_t n = 0;
+    if (!ids || cap == 0) return 0;
+    if ((!env || !env[0]) && path && path[0]) {
+        FILE *fp = fopen(path, "rb");
+        if (!fp) return 0;
+        while (n < cap && fread(&ids[n], sizeof(ids[n]), 1, fp) == 1) {
+            if (ids[n] < 0) break;
+            n++;
+        }
+        fclose(fp);
+        return n;
+    }
+    if (!env || !env[0]) return 0;
+    while (*env && n < cap) {
+        while (*env == ',' || *env == ' ' || *env == '\t') env++;
+        if (!*env) break;
+        char *end = NULL;
+        long v = strtol(env, &end, 10);
+        if (end == env || v < 0 || v > INT32_MAX) break;
+        ids[n++] = (int32_t)v;
+        env = end;
+    }
+    return n;
+}
