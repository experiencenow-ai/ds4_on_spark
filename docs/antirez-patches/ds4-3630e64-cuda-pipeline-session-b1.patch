+        fprintf(stderr, "ds4: CUDA layer probe layer %u is missing attention tensors\n", il);
+        return 1;
+    }
+    const uint32_t ctx_size = n_tokens > DS4_N_SWA ? n_tokens : DS4_N_SWA;
+    const uint32_t raw_cap = ffn_only ? DS4_N_SWA : metal_graph_raw_cap_for_context((int)ctx_size, n_tokens);
+    const uint64_t hc_dim = (uint64_t)DS4_N_HC * DS4_N_EMBD;
+    const uint64_t hc_bytes = (uint64_t)n_tokens * hc_dim * sizeof(float);
+    float *host_hc = xmalloc((size_t)hc_bytes);
+    int32_t *host_tokens = xmalloc((size_t)n_tokens * sizeof(host_tokens[0]));
+    uint8_t *host_out = xmalloc((size_t)hc_bytes);
+    cuda_moe_probe_fill(host_hc, host_tokens, n_tokens, (uint32_t)hc_dim);
+    ds4_gpu_graph g;
+    bool ok = metal_graph_alloc_raw_cap(&g, weights, layer, raw_cap, ctx_size, n_tokens, false);
+    if (ok) ok = ds4_gpu_tensor_write(g.batch_cur_hc, 0, host_hc, hc_bytes) != 0;
+    if (ok) ok = ds4_gpu_tensor_write(g.batch_after_attn_hc, 0, host_hc, hc_bytes) != 0;
+    if (ok) ok = ds4_gpu_tensor_write(g.prefill_tokens, 0, host_tokens, (uint64_t)n_tokens * sizeof(int32_t)) != 0;
+    if (ok) ok = ds4_gpu_synchronize() != 0;
+    double total_ms = 0.0;
+    double best_ms = 0.0;
+    for (uint32_t it = 0; ok && it < iterations; it++) {
+        const double t0 = now_sec();
+        ok = cuda_layer_probe_run(&g, model, layer, il, n_tokens, ffn_only);
+        const double t1 = now_sec();
+        const double ms = (t1 - t0) * 1000.0;
+        if (ok) {
+            total_ms += ms;
+            if (it == 0 || ms < best_ms) best_ms = ms;
+            fprintf(stderr,
+                    "ds4: CUDA %s probe iter=%u ms=%.3f\n",
+                    ffn_only ? "ffn" : "layer",
+                    it,
+                    ms);
+        }
+    }
+    uint64_t out_hash = 0;
+    uint64_t out_nonfinite = 0;
+    if (ok) {
+        ok = ds4_gpu_tensor_read(g.batch_next_hc, 0, host_out, hc_bytes) != 0;
+        if (ok) {
+            out_hash = hash_bytes(host_out, hc_bytes);
+            out_nonfinite = cuda_probe_nonfinite_count(host_out, hc_bytes);
+        }
+    }
+    if (ok) {
