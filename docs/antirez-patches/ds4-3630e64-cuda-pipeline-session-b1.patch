+        const float dmin = dev_f16_to_f32(xb->dmin);
+        const uint32_t u0 = dev_u32le_load(xb->scales + 0);
+        const uint32_t u1 = dev_u32le_load(xb->scales + 4);
+        const uint32_t u2 = dev_u32le_load(xb->scales + 8);
+        const uint32_t kmask1 = 0x3f3f3f3fu;
+        const uint32_t kmask2 = 0x0f0f0f0fu;
+        const uint32_t kmask3 = 0x03030303u;
+        const uint32_t sc0 = u0 & kmask1;
+        const uint32_t sc1 = (u2 & kmask2) | (((u0 >> 6) & kmask3) << 4);
