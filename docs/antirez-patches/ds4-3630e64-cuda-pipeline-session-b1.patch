+static uint64_t cuda_probe_nonfinite_count(const uint8_t *buf, uint64_t bytes) {
+    const float *x = (const float *)buf;
+    const uint64_t n = bytes / sizeof(float);
+    uint64_t count = 0;
+    for (uint64_t i = 0; i < n; i++) {
+        if (!isfinite(x[i])) count++;
+    }
+    return count;
+}
