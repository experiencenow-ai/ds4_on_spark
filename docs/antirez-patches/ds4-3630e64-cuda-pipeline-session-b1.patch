+        printf("{\"cuda_batch_stack_probe\":true,\"layers\":%u,\"tokens\":%u,\"iterations\":%u,\"raw_cap\":%u,\"ctx_size\":%u,\"includes_one_output_head\":%s,\"boundary_layout\":\"batch,hc,hidden\",\"boundary_dtype\":\"f32\",\"boundary_bytes\":%" PRIu64 ",\"boundary_input_file\":%s,\"boundary_output_file\":%s,\"embedding_input\":%s,\"avg_ms\":%.3f,\"best_ms\":%.3f,\"best_rows_per_s\":%.3f,\"out_fnv64\":\"%016" PRIx64 "\",\"out_nonfinite\":%" PRIu64 ",\"logits_fnv64\":\"%016" PRIx64 "\",\"logits_nonfinite\":%" PRIu64 ",",
