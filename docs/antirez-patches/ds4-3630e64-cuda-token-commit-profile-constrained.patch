+static bool cuda_stack_probe_commit_constrained_tokens(
+        const ds4_model  *model,
+        const ds4_tensor *output,
+        const float      *host_norm,
+        uint32_t          n_tokens,
+        const int32_t    *candidate_ids,
+        uint32_t          candidate_count,
+        int8_t           *xq,
+        float            *xscale,
+        int32_t          *host_committed) {
+    if (!model || !output || !host_norm || !candidate_ids || !xq || !xscale || !host_committed) return false;
+    if (output->type != DS4_TENSOR_Q8_0 || output->ndim != 2 || output->dim[0] != DS4_N_EMBD) return false;
+    const uint64_t blocks = (DS4_N_EMBD + 31u) / 32u;
+    const uint64_t vocab_dim = output->dim[1];
+    const uint8_t *data = tensor_data(model, output);
+    for (uint32_t t = 0; t < n_tokens; t++) {
+        quantize_q8_0_activation(host_norm + (uint64_t)t * DS4_N_EMBD,
+                                 xq + (uint64_t)t * blocks * 32u,
+                                 xscale + (uint64_t)t * blocks,
+                                 DS4_N_EMBD);
+        float best = -INFINITY;
+        int32_t best_id = -1;
+        for (uint32_t i = 0; i < candidate_count; i++) {
+            const int32_t id = candidate_ids[i];
+            if (id < 0 || (uint64_t)id >= vocab_dim) return false;
+            const uint8_t *row = data + (uint64_t)id * blocks * 34u;
+            const float score = dot_q8_0_row(row,
+                                             xq + (uint64_t)t * blocks * 32u,
+                                             xscale + (uint64_t)t * blocks,
+                                             DS4_N_EMBD,
+                                             blocks);
+            if (i == 0 || score > best) {
+                best = score;
+                best_id = id;
+            }
+        }
+        host_committed[t] = best_id;
+    }
+    return true;
 }
 
