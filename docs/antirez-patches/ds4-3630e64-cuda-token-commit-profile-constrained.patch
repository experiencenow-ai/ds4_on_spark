+static uint32_t cuda_stack_probe_parse_constrained_ids(
+        int32_t *ids,
+        uint32_t cap) {
+    const char *env = getenv("DS4_CUDA_STACK_PROBE_CONSTRAINED_TOKEN_IDS");
+    uint32_t n = 0;
+    if (!env || !env[0] || !ids || cap == 0) return 0;
+    while (*env && n < cap) {
+        while (*env == ',' || *env == ' ' || *env == '\t') env++;
+        if (!*env) break;
+        char *end = NULL;
+        long v = strtol(env, &end, 10);
+        if (end == env || v < 0 || v > INT32_MAX) break;
+        ids[n++] = (int32_t)v;
+        env = end;
+    }
+    return n;
+}
