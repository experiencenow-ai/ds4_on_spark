+#ifndef DS4_NO_GPU
+static uint64_t mtp_probe_fnv1a64(const void *ptr, uint64_t nbytes) {
+    const uint8_t *p = (const uint8_t *)ptr;
+    uint64_t h = 14695981039346656037ull;
+    for (uint64_t i = 0; i < nbytes; i++) {
+        h ^= (uint64_t)p[i];
+        h *= 1099511628211ull;
+    }
+    return h;
+}
+
+static int mtp_probe_capture_tensor(
+        ds4_tensor_fingerprint *out,
+        ds4_gpu_tensor *t,
+        uint64_t nbytes,
+        uint32_t ndim,
+        uint32_t s0,
+        uint32_t s1,
+        char *err,
+        size_t errlen) {
+    if (!out || !t || nbytes == 0) {
+        if (errlen) snprintf(err, errlen, "mtp one-token probe: missing tensor capture");
+        return 1;
+    }
+    if (ds4_gpu_synchronize() == 0) {
+        if (errlen) snprintf(err, errlen, "mtp one-token probe: failed to synchronize before capture");
+        return 1;
+    }
+    uint8_t *buf = xmalloc((size_t)nbytes);
+    if (ds4_gpu_tensor_read(t, 0, buf, nbytes) == 0) {
+        free(buf);
+        if (errlen) snprintf(err, errlen, "mtp one-token probe: failed to read tensor capture");
+        return 1;
+    }
+    out->fnv64 = mtp_probe_fnv1a64(buf, nbytes);
+    out->nbytes = nbytes;
+    out->ndim = ndim;
+    out->shape[0] = s0;
+    out->shape[1] = s1;
+    free(buf);
+    return 0;
+}
+#endif
+
+int ds4_engine_mtp_one_token_probe(
+        ds4_engine *e,
+        const ds4_tokens *prompt,
+        int ctx_size,
+        ds4_mtp_one_token_probe *out,
+        char *err,
+        size_t errlen) {
+    if (!e || !prompt || !out || ctx_size <= 0) return 1;
+    if (!e->mtp_ready) {
+        if (errlen) snprintf(err, errlen, "mtp one-token probe requires --mtp sidecar");
+        return 1;
+    }
+    if (!ds4_backend_uses_graph(e->backend) || !e->metal_ready) {
+        if (errlen) snprintf(err, errlen, "mtp one-token probe requires a graph backend (metal/cuda)");
+        return 1;
+    }
+#ifdef DS4_NO_GPU
+    (void)err;
+    (void)errlen;
+    return 1;
+#else
+    memset(out, 0, sizeof(*out));
+
+    ds4_session *session = NULL;
+    if (ds4_session_create(&session, e, ctx_size) != 0) {
+        if (errlen) snprintf(err, errlen, "mtp one-token probe: failed to create session");
+        return 1;
+    }
+
+    char sync_err[160];
+    sync_err[0] = '\0';
+    if (ds4_session_sync(session, prompt, sync_err, sizeof(sync_err)) != 0) {
+        ds4_session_free(session);
+        if (errlen) snprintf(err, errlen, "mtp one-token probe: prompt processing failed: %s", sync_err);
+        return 1;
+    }
+
+    const int base_next = ds4_session_argmax(session);
+    out->base_next_token_id = base_next;
+    if (base_next < 0) {
+        ds4_session_free(session);
+        if (errlen) snprintf(err, errlen, "mtp one-token probe: failed to select base next token");
+        return 1;
+    }
+
+    char eval_err[160];
+    eval_err[0] = '\0';
+    if (ds4_session_eval(session, base_next, eval_err, sizeof(eval_err)) != 0) {
+        ds4_session_free(session);
+        if (errlen) snprintf(err, errlen, "mtp one-token probe: base eval failed: %s", eval_err);
+        return 1;
+    }
+
+    if (!session->mtp_draft_valid || session->mtp_draft_token < 0) {
+        ds4_session_free(session);
+        if (errlen) snprintf(err, errlen, "mtp one-token probe: mtp draft token not available after base eval");
+        return 1;
+    }
+    out->mtp_draft_token_id = session->mtp_draft_token;
+
+    const uint32_t hc_dim = (uint32_t)(DS4_N_HC * DS4_N_EMBD);
+    const uint64_t hc_bytes = (uint64_t)hc_dim * sizeof(float);
+    const uint64_t embd_bytes = (uint64_t)DS4_N_EMBD * sizeof(float);
+
+    int cap_err = 0;
+    cap_err |= mtp_probe_capture_tensor(&out->trunk_token_embd, session->graph.mtp_embed, embd_bytes, 1, DS4_N_EMBD, 0, err, errlen);
+    cap_err |= mtp_probe_capture_tensor(&out->trunk_pre_hc_head, session->graph.cur_hc, hc_bytes, 2, DS4_N_HC, DS4_N_EMBD, err, errlen);
+    cap_err |= mtp_probe_capture_tensor(&out->mtp_input_hc, session->graph.mtp_input_hc, hc_bytes, 2, DS4_N_HC, DS4_N_EMBD, err, errlen);
+    cap_err |= mtp_probe_capture_tensor(&out->mtp_block_out_hc, session->graph.mtp_state_hc, hc_bytes, 2, DS4_N_HC, DS4_N_EMBD, err, errlen);
+    cap_err |= mtp_probe_capture_tensor(&out->mtp_head_norm, session->graph.output_norm, embd_bytes, 1, DS4_N_EMBD, 0, err, errlen);
+
+    ds4_session_free(session);
+    return cap_err != 0 ? 1 : 0;
+#endif
+}
