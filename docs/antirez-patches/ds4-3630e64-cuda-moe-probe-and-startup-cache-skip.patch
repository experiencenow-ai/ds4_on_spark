+#ifndef DS4_NO_GPU
+static uint32_t cuda_decode_probe_comp_before(uint32_t il, uint32_t pos, uint32_t comp_cap) {
+    const uint32_t ratio = ds4_layer_compress_ratio(il);
+    uint32_t n_comp = ratio != 0 ? pos / ratio : 0;
+    if (comp_cap != 0 && n_comp >= comp_cap) n_comp = comp_cap - 1u;
+    return n_comp;
+}
+
+static bool cuda_stack_probe_reset_compressor_state(ds4_gpu_graph *g) {
+    bool ok = true;
+    for (uint32_t il = 0; ok && il < DS4_N_LAYER; il++) {
+        const uint32_t ratio = ds4_layer_compress_ratio(il);
+        g->layer_n_comp[il] = 0;
+        g->layer_n_index_comp[il] = 0;
+        if (ratio == 0) continue;
+        const uint32_t coff = ratio == 4 ? 2u : 1u;
+        const uint64_t attn_width = (uint64_t)coff * DS4_N_HEAD_DIM;
+        const uint64_t attn_rows = (uint64_t)coff * ratio;
+        if (g->layer_attn_state_kv[il]) {
+            ok = metal_tensor_fill_f32(g->layer_attn_state_kv[il], 0.0f, attn_width * attn_rows);
+        }
+        if (ok && g->layer_attn_state_score[il]) {
+            ok = metal_tensor_fill_f32(g->layer_attn_state_score[il], DS4_NEG_INF, attn_width * attn_rows);
+        }
+        if (ok && ratio == 4) {
+            const uint64_t index_width = (uint64_t)coff * DS4_N_INDEXER_HEAD_DIM;
+            const uint64_t index_rows = (uint64_t)coff * ratio;
+            if (g->layer_index_state_kv[il]) {
+                ok = metal_tensor_fill_f32(g->layer_index_state_kv[il], 0.0f, index_width * index_rows);
+            }
+            if (ok && g->layer_index_state_score[il]) {
+                ok = metal_tensor_fill_f32(g->layer_index_state_score[il], DS4_NEG_INF, index_width * index_rows);
+            }
+        }
+    }
+    return ok;
+}
+
+static bool cuda_decode_stack_probe_seed(
+        ds4_gpu_graph *g,
+        uint32_t       pos,
+        uint32_t      *n_comp_base,
+        uint32_t      *n_index_base) {
+    const uint64_t hc_dim = (uint64_t)DS4_N_HC * DS4_N_EMBD;
+    bool ok = cuda_probe_seed_tensor(g->cur_hc, hc_dim, 0x5100u);
+    for (uint32_t il = 0; ok && il < DS4_N_LAYER; il++) {
+        const uint32_t ratio = ds4_layer_compress_ratio(il);
+        n_comp_base[il] = cuda_decode_probe_comp_before(il, pos, g->layer_comp_cap[il]);
+        n_index_base[il] = ratio == 4 ? n_comp_base[il] : 0;
+        ok = cuda_probe_seed_tensor(g->layer_raw_cache[il],
+                                    (uint64_t)g->raw_cap * DS4_N_HEAD_DIM,
+                                    0x5200u + il);
+        if (ok && n_comp_base[il] != 0) {
+            ok = cuda_probe_seed_tensor(g->layer_attn_comp_cache[il],
+                                        (uint64_t)n_comp_base[il] * DS4_N_HEAD_DIM,
+                                        0x5300u + il);
+        }
+        if (ok && n_index_base[il] != 0) {
+            ok = cuda_probe_seed_tensor(g->layer_index_comp_cache[il],
+                                        (uint64_t)n_index_base[il] * DS4_N_INDEXER_HEAD_DIM,
+                                        0x5400u + il);
+        }
+    }
+    return ok;
+}
+
+static void cuda_decode_stack_probe_set_counts(
+        ds4_gpu_graph *g,
+        const uint32_t *n_comp_base,
+        const uint32_t *n_index_base) {
+    for (uint32_t il = 0; il < DS4_N_LAYER; il++) {
+        g->layer_n_comp[il] = n_comp_base[il];
+        g->layer_n_index_comp[il] = n_index_base[il];
+    }
+}
+
+static uint32_t cuda_stack_probe_split_layers(void) {
+    const char *env = getenv("DS4_CUDA_STACK_PROBE_SPLIT_LAYERS");
+    if (!env || !env[0]) return 4u;
+    char *end = NULL;
+    unsigned long v = strtoul(env, &end, 10);
+    if (end == env || v > DS4_N_LAYER) return 4u;
+    return (uint32_t)v;
+}
+
+static bool cuda_stack_probe_include_head(void) {
+    return getenv("DS4_CUDA_STACK_PROBE_NO_HEAD") == NULL;
+}
+
+static bool cuda_decode_stack_probe_run(
+        ds4_gpu_graph       *g,
+        const ds4_model     *model,
+        const ds4_weights   *weights,
+        uint32_t             pos,
+        const uint32_t      *n_comp_base,
+        const uint32_t      *n_index_base) {
+    cuda_decode_stack_probe_set_counts(g, n_comp_base, n_index_base);
+    const uint32_t raw_row = pos % g->raw_cap;
+    const uint32_t n_raw = metal_graph_raw_span_for_batch(g, pos, 1);
+    const uint32_t split_layers = cuda_stack_probe_split_layers();
+    bool ok = ds4_gpu_begin_commands() != 0;
+    for (uint32_t il = 0; ok && il < DS4_N_LAYER; il++) {
+        ok = metal_graph_encode_decode_layer(g,
+                                             model,
+                                             &weights->layer[il],
+                                             il,
+                                             pos,
+                                             g->layer_raw_cache[il],
+                                             g->raw_cap,
+                                             raw_row,
+                                             n_raw,
+                                             17);
+        ds4_gpu_tensor *tmp = g->cur_hc;
+        g->cur_hc = g->after_ffn_hc;
+        g->after_ffn_hc = tmp;
+        if (ok && split_layers != 0 && il + 1u < DS4_N_LAYER &&
+            ((il + 1u) % split_layers) == 0u) {
+            ok = ds4_gpu_flush_commands() != 0;
+        }
+    }
+    if (ok && cuda_stack_probe_include_head()) {
+        ok = metal_graph_encode_output_head(g, model, weights, weights->output->dim[1]);
+    }
+    if (ok) {
+        ok = ds4_gpu_end_commands() != 0;
+    } else {
+        (void)ds4_gpu_synchronize();
+    }
+    if (ok) ok = ds4_gpu_synchronize() != 0;
+    return ok;
+}
