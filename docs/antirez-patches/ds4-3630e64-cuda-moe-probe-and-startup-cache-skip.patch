+static void cuda_moe_probe_fill(float *x, int32_t *tokens, uint32_t n_tokens, uint32_t n_dim) {
+    for (uint32_t t = 0; t < n_tokens; t++) {
+        tokens[t] = (int32_t)(17u + ((t * 131u) % 32000u));
+        for (uint32_t i = 0; i < n_dim; i++) {
+            uint32_t v = (t * 1103515245u) ^ (i * 2654435761u) ^ 0x9e3779b9u;
+            x[(uint64_t)t * n_dim + i] = ((float)(int32_t)(v & 1023u) - 511.5f) * (1.0f / 8192.0f);
+        }
+    }
+}
+
+int ds4_engine_cuda_moe_probe(ds4_engine *e, uint32_t il, uint32_t n_tokens, uint32_t iterations) {
+#ifdef DS4_NO_GPU
+    (void)e;
+    (void)il;
+    (void)n_tokens;
+    (void)iterations;
+    fprintf(stderr, "ds4: CUDA MoE probe requested but this build has no graph backend support\n");
+    return 1;
+#else
+    if (!e || e->backend != DS4_BACKEND_CUDA || !e->metal_ready) {
+        fprintf(stderr, "ds4: CUDA MoE probe requires an initialized CUDA backend\n");
+        return 1;
+    }
+    if (il >= DS4_N_LAYER || n_tokens == 0 || iterations == 0 || n_tokens > 8192u) {
+        fprintf(stderr, "ds4: invalid CUDA MoE probe arguments layer=%u tokens=%u iterations=%u\n",
+                il, n_tokens, iterations);
+        return 1;
+    }
+    const ds4_model *model = &e->model;
+    const ds4_layer_weights *layer = &e->weights.layer[il];
+    if (!layer->ffn_gate_inp || !layer->ffn_gate_exps || !layer->ffn_up_exps || !layer->ffn_down_exps) {
+        fprintf(stderr, "ds4: CUDA MoE probe layer %u is missing routed MoE tensors\n", il);
+        return 1;
+    }
+    const uint32_t expert_in_dim = (uint32_t)layer->ffn_gate_exps->dim[0];
+    const uint32_t expert_mid_dim = (uint32_t)layer->ffn_gate_exps->dim[1];
+    const uint32_t out_dim = (uint32_t)layer->ffn_down_exps->dim[1];
+    if (expert_in_dim == 0 || expert_mid_dim == 0 || out_dim == 0) {
+        fprintf(stderr, "ds4: CUDA MoE probe layer %u has invalid routed MoE dimensions\n", il);
+        return 1;
+    }
+    const uint64_t gate_row_bytes = routed_expert_row_bytes(layer->ffn_gate_exps);
+    const uint64_t gate_expert_bytes = (uint64_t)expert_mid_dim * gate_row_bytes;
+    const uint64_t down_row_bytes = routed_expert_row_bytes(layer->ffn_down_exps);
+    const uint64_t down_expert_bytes = (uint64_t)out_dim * down_row_bytes;
+    const uint64_t x_bytes = (uint64_t)n_tokens * expert_in_dim * sizeof(float);
+    const uint64_t selected_bytes = (uint64_t)n_tokens * DS4_N_EXPERT_USED * sizeof(int32_t);
+    const uint64_t weights_bytes = (uint64_t)n_tokens * DS4_N_EXPERT_USED * sizeof(float);
+    const uint64_t probs_bytes = (uint64_t)n_tokens * DS4_N_EXPERT * sizeof(float);
+    const uint64_t router_bytes = (uint64_t)n_tokens * DS4_N_EXPERT * sizeof(float);
+    const uint64_t mid_bytes = (uint64_t)n_tokens * DS4_N_EXPERT_USED * expert_mid_dim * sizeof(float);
+    const uint64_t down_bytes = (uint64_t)n_tokens * DS4_N_EXPERT_USED * out_dim * sizeof(float);
+    const uint64_t out_bytes = (uint64_t)n_tokens * out_dim * sizeof(float);
+    float *host_x = xmalloc((size_t)x_bytes);
+    int32_t *host_tokens = xmalloc((size_t)n_tokens * sizeof(host_tokens[0]));
+    int32_t *host_selected = xmalloc((size_t)selected_bytes);
+    uint8_t *host_out = xmalloc((size_t)out_bytes);
+    cuda_moe_probe_fill(host_x, host_tokens, n_tokens, expert_in_dim);
+    ds4_gpu_tensor *x = ds4_gpu_tensor_alloc(x_bytes);
+    ds4_gpu_tensor *tokens = ds4_gpu_tensor_alloc((uint64_t)n_tokens * sizeof(int32_t));
+    ds4_gpu_tensor *router = ds4_gpu_tensor_alloc(router_bytes);
+    ds4_gpu_tensor *selected = ds4_gpu_tensor_alloc(selected_bytes);
+    ds4_gpu_tensor *weights = ds4_gpu_tensor_alloc(weights_bytes);
+    ds4_gpu_tensor *probs = ds4_gpu_tensor_alloc(probs_bytes);
+    ds4_gpu_tensor *out = ds4_gpu_tensor_alloc(out_bytes);
+    ds4_gpu_tensor *gate = ds4_gpu_tensor_alloc(mid_bytes);
+    ds4_gpu_tensor *up = ds4_gpu_tensor_alloc(mid_bytes);
+    ds4_gpu_tensor *mid = ds4_gpu_tensor_alloc(mid_bytes);
+    ds4_gpu_tensor *down = ds4_gpu_tensor_alloc(down_bytes);
+    bool ok = x && tokens && router && selected && weights && probs && out && gate && up && mid && down;
+    if (ok) ok = ds4_gpu_tensor_write(x, 0, host_x, x_bytes) != 0;
+    if (ok) ok = ds4_gpu_tensor_write(tokens, 0, host_tokens, (uint64_t)n_tokens * sizeof(int32_t)) != 0;
+    if (ok) ok = ds4_gpu_matmul_f16_tensor(router,
+                                             model->map,
+                                             model->size,
+                                             layer->ffn_gate_inp->abs_offset,
+                                             DS4_N_EMBD,
+                                             DS4_N_EXPERT,
+                                             x,
+                                             n_tokens) != 0;
+    if (ok) ok = ds4_gpu_router_select_batch_tensor(selected,
+                                                      weights,
+                                                      probs,
+                                                      model->map,
+                                                      model->size,
+                                                      layer->ffn_exp_probs_b ? layer->ffn_exp_probs_b->abs_offset : 0,
+                                                      layer->ffn_gate_tid2eid ? layer->ffn_gate_tid2eid->abs_offset : 0,
+                                                      layer->ffn_gate_tid2eid ? (uint32_t)layer->ffn_gate_tid2eid->dim[1] : 0,
+                                                      0,
+                                                      0,
+                                                      layer->ffn_exp_probs_b != NULL,
+                                                      layer->ffn_gate_tid2eid != NULL,
+                                                      router,
+                                                      tokens,
+                                                      n_tokens) != 0;
+    if (ok) ok = ds4_gpu_synchronize() != 0;
+    if (ok) ok = ds4_gpu_tensor_read(selected, 0, host_selected, selected_bytes) != 0;
+    uint32_t counts[256] = {0};
+    uint32_t active = 0;
+    uint32_t max_depth = 0;
+    if (ok) {
+        for (uint32_t i = 0; i < n_tokens * DS4_N_EXPERT_USED; i++) {
+            int32_t expert_i = host_selected[i];
+            if (expert_i < 0) expert_i = 0;
+            uint32_t expert = (uint32_t)expert_i;
+            if (expert >= 256u) {
+                fprintf(stderr, "ds4: CUDA MoE probe selected out-of-range expert %u\n", expert);
+                ok = false;
+                break;
+            }
+            counts[expert]++;
+        }
+        for (uint32_t eidx = 0; eidx < 256u; eidx++) {
+            if (counts[eidx] != 0) {
+                active++;
+                if (counts[eidx] > max_depth) max_depth = counts[eidx];
+            }
+        }
+    }
+    double total_ms = 0.0;
+    double best_ms = 0.0;
+    for (uint32_t it = 0; ok && it < iterations; it++) {
+        const double t0 = now_sec();
+        ok = ds4_gpu_routed_moe_batch_tensor(out, gate, up, mid, down,
+                                             model->map,
+                                             model->size,
+                                             layer->ffn_gate_exps->abs_offset,
+                                             layer->ffn_up_exps->abs_offset,
+                                             layer->ffn_down_exps->abs_offset,
+                                             layer->ffn_gate_exps->type,
+                                             layer->ffn_down_exps->type,
+                                             gate_expert_bytes,
+                                             gate_row_bytes,
+                                             down_expert_bytes,
+                                             down_row_bytes,
+                                             expert_in_dim,
+                                             expert_mid_dim,
+                                             out_dim,
+                                             selected,
+                                             weights,
+                                             DS4_N_EXPERT_USED,
+                                             DS4_SWIGLU_CLAMP_EXP,
+                                             x,
+                                             n_tokens) != 0;
+        if (ok) ok = ds4_gpu_synchronize() != 0;
+        const double t1 = now_sec();
+        const double ms = (t1 - t0) * 1000.0;
+        if (ok) {
+            total_ms += ms;
+            if (it == 0 || ms < best_ms) best_ms = ms;
+            fprintf(stderr, "ds4: CUDA MoE probe iter=%u ms=%.3f\n", it, ms);
+        }
+    }
+    uint64_t out_hash = 0;
+    if (ok) {
+        ok = ds4_gpu_tensor_read(out, 0, host_out, out_bytes) != 0;
+        if (ok) out_hash = hash_bytes(host_out, out_bytes);
+    }
+    const char *slice_env = getenv("DS4_CUDA_MOE_BATCHED_EXPERT_SLICE_CACHE");
+    const bool compare_full = slice_env != NULL && getenv("DS4_CUDA_MOE_PROBE_COMPARE_FULL") != NULL;
+    uint64_t full_hash = 0;
+    double max_abs_diff = 0.0;
+    double mean_abs_diff = 0.0;
+    uint64_t out_nonfinite = 0;
+    uint64_t full_nonfinite = 0;
+    bool compared_full = false;
+    if (ok) {
+        const float *a = (const float *)host_out;
+        const uint64_t n = out_bytes / sizeof(float);
+        for (uint64_t i = 0; i < n; i++) {
+            if (!isfinite(a[i])) out_nonfinite++;
+        }
+    }
+    if (ok && compare_full) {
+        char *saved_slice_env = ds4_strdup(slice_env);
+        uint8_t *host_full = xmalloc((size_t)out_bytes);
+        unsetenv("DS4_CUDA_MOE_BATCHED_EXPERT_SLICE_CACHE");
+        ok = ds4_gpu_routed_moe_batch_tensor(out, gate, up, mid, down,
+                                             model->map,
+                                             model->size,
+                                             layer->ffn_gate_exps->abs_offset,
+                                             layer->ffn_up_exps->abs_offset,
+                                             layer->ffn_down_exps->abs_offset,
+                                             layer->ffn_gate_exps->type,
+                                             layer->ffn_down_exps->type,
+                                             gate_expert_bytes,
+                                             gate_row_bytes,
+                                             down_expert_bytes,
+                                             down_row_bytes,
+                                             expert_in_dim,
+                                             expert_mid_dim,
+                                             out_dim,
+                                             selected,
+                                             weights,
+                                             DS4_N_EXPERT_USED,
+                                             DS4_SWIGLU_CLAMP_EXP,
+                                             x,
+                                             n_tokens) != 0;
+        if (ok) ok = ds4_gpu_synchronize() != 0;
+        if (ok) ok = ds4_gpu_tensor_read(out, 0, host_full, out_bytes) != 0;
+        if (ok) {
+            const float *a = (const float *)host_out;
+            const float *b = (const float *)host_full;
+            const uint64_t n = out_bytes / sizeof(float);
+            double sum = 0.0;
+            for (uint64_t i = 0; i < n; i++) {
+                if (!isfinite(b[i])) full_nonfinite++;
+                const double d = fabs((double)a[i] - (double)b[i]);
+                if (d > max_abs_diff) max_abs_diff = d;
+                sum += d;
+            }
+            mean_abs_diff = n != 0 ? sum / (double)n : 0.0;
+            full_hash = hash_bytes(host_full, out_bytes);
+            compared_full = true;
+        }
+        setenv("DS4_CUDA_MOE_BATCHED_EXPERT_SLICE_CACHE", saved_slice_env, 1);
+        free(host_full);
+        free(saved_slice_env);
+    }
+    if (ok) {
+        const double avg_ms = total_ms / (double)iterations;
+        const double pairs = (double)n_tokens * (double)DS4_N_EXPERT_USED;
+        if (compared_full) {
+            printf("{\"cuda_moe_probe\":true,\"layer\":%u,\"tokens\":%u,\"pairs\":%.0f,\"iterations\":%u,\"active_experts\":%u,\"mean_queue_depth\":%.3f,\"max_queue_depth\":%u,\"avg_ms\":%.3f,\"best_ms\":%.3f,\"best_pairs_per_s\":%.3f,\"out_fnv64\":\"%016" PRIx64 "\",\"out_nonfinite\":%" PRIu64 ",\"full_slab_fnv64\":\"%016" PRIx64 "\",\"full_slab_nonfinite\":%" PRIu64 ",\"full_slab_max_abs_diff\":%.9g,\"full_slab_mean_abs_diff\":%.9g}\n",
+                   il,
+                   n_tokens,
+                   pairs,
+                   iterations,
+                   active,
+                   active != 0 ? pairs / (double)active : 0.0,
+                   max_depth,
+                   avg_ms,
+                   best_ms,
+                   best_ms > 0.0 ? pairs * 1000.0 / best_ms : 0.0,
+                   out_hash,
+                   out_nonfinite,
+                   full_hash,
+                   full_nonfinite,
+                   max_abs_diff,
+                   mean_abs_diff);
+        } else {
+            printf("{\"cuda_moe_probe\":true,\"layer\":%u,\"tokens\":%u,\"pairs\":%.0f,\"iterations\":%u,\"active_experts\":%u,\"mean_queue_depth\":%.3f,\"max_queue_depth\":%u,\"avg_ms\":%.3f,\"best_ms\":%.3f,\"best_pairs_per_s\":%.3f,\"out_fnv64\":\"%016" PRIx64 "\",\"out_nonfinite\":%" PRIu64 "}\n",
+                   il,
+                   n_tokens,
+                   pairs,
+                   iterations,
+                   active,
+                   active != 0 ? pairs / (double)active : 0.0,
+                   max_depth,
+                   avg_ms,
+                   best_ms,
+                   best_ms > 0.0 ? pairs * 1000.0 / best_ms : 0.0,
+                   out_hash,
+                   out_nonfinite);
+        }
+    }
+    ds4_gpu_tensor_free(down);
+    ds4_gpu_tensor_free(mid);
+    ds4_gpu_tensor_free(up);
+    ds4_gpu_tensor_free(gate);
+    ds4_gpu_tensor_free(out);
+    ds4_gpu_tensor_free(probs);
+    ds4_gpu_tensor_free(weights);
+    ds4_gpu_tensor_free(selected);
+    ds4_gpu_tensor_free(router);
+    ds4_gpu_tensor_free(tokens);
+    ds4_gpu_tensor_free(x);
+    free(host_out);
+    free(host_selected);
+    free(host_tokens);
+    free(host_x);
+    if (!ok) {
+        fprintf(stderr, "ds4: CUDA MoE probe failed\n");
+        return 1;
+    }
+    return 0;
+#endif
+}
+
+static uint64_t cuda_probe_nonfinite_count(const uint8_t *buf, uint64_t bytes) {
+    const float *x = (const float *)buf;
+    const uint64_t n = bytes / sizeof(float);
+    uint64_t count = 0;
+    for (uint64_t i = 0; i < n; i++) {
+        if (!isfinite(x[i])) count++;
+    }
+    return count;
+}
+
+#ifndef DS4_NO_GPU
+static bool cuda_layer_probe_run(
+        ds4_gpu_graph          *g,
+        const ds4_model        *model,
+        const ds4_layer_weights *layer,
+        uint32_t                il,
+        uint32_t                n_tokens,
+        bool                    ffn_only) {
+    bool ok = ds4_gpu_begin_commands() != 0;
+    if (ok && !ffn_only) {
+        ok = metal_graph_encode_layer_attention_batch(g, model, layer, il, 0, n_tokens);
+    }
+    if (ok) {
+        ok = metal_graph_encode_layer_ffn_batch(g, model, layer, il, 0, n_tokens);
+    }
+    if (ok) {
+        ok = ds4_gpu_end_commands() != 0;
+    } else {
+        (void)ds4_gpu_synchronize();
+    }
+    if (ok) ok = ds4_gpu_synchronize() != 0;
+    return ok;
+}
+#endif
+
+int ds4_engine_cuda_layer_probe(ds4_engine *e, uint32_t il, uint32_t n_tokens, uint32_t iterations, bool ffn_only) {
+#ifdef DS4_NO_GPU
+    (void)e;
+    (void)il;
+    (void)n_tokens;
+    (void)iterations;
+    (void)ffn_only;
+    fprintf(stderr, "ds4: CUDA layer probe requested but this build has no graph backend support\n");
+    return 1;
+#else
+    if (!e || e->backend != DS4_BACKEND_CUDA || !e->metal_ready) {
+        fprintf(stderr, "ds4: CUDA layer probe requires an initialized CUDA backend\n");
+        return 1;
+    }
+    if (il >= DS4_N_LAYER || n_tokens == 0 || iterations == 0 || n_tokens > 4096u) {
+        fprintf(stderr, "ds4: invalid CUDA layer probe arguments layer=%u tokens=%u iterations=%u\n",
+                il, n_tokens, iterations);
+        return 1;
+    }
+    const ds4_model *model = &e->model;
+    const ds4_weights *weights = &e->weights;
+    const ds4_layer_weights *layer = &weights->layer[il];
+    if (!layer->ffn_gate_inp || !layer->ffn_gate_exps || !layer->ffn_up_exps || !layer->ffn_down_exps ||
+        !layer->ffn_gate_shexp || !layer->ffn_up_shexp || !layer->ffn_down_shexp) {
+        fprintf(stderr, "ds4: CUDA layer probe layer %u is missing FFN tensors\n", il);
+        return 1;
+    }
+    if (!ffn_only && (!layer->attn_q_a || !layer->attn_q_b || !layer->attn_kv ||
+                      !layer->attn_output_a || !layer->attn_output_b)) {
+        fprintf(stderr, "ds4: CUDA layer probe layer %u is missing attention tensors\n", il);
+        return 1;
+    }
+    const uint32_t ctx_size = n_tokens > DS4_N_SWA ? n_tokens : DS4_N_SWA;
+    const uint32_t raw_cap = ffn_only ? DS4_N_SWA : metal_graph_raw_cap_for_context((int)ctx_size, n_tokens);
+    const uint64_t hc_dim = (uint64_t)DS4_N_HC * DS4_N_EMBD;
+    const uint64_t hc_bytes = (uint64_t)n_tokens * hc_dim * sizeof(float);
+    float *host_hc = xmalloc((size_t)hc_bytes);
+    int32_t *host_tokens = xmalloc((size_t)n_tokens * sizeof(host_tokens[0]));
+    uint8_t *host_out = xmalloc((size_t)hc_bytes);
+    cuda_moe_probe_fill(host_hc, host_tokens, n_tokens, (uint32_t)hc_dim);
+    ds4_gpu_graph g;
+    bool ok = metal_graph_alloc_raw_cap(&g, weights, layer, raw_cap, ctx_size, n_tokens, false);
+    if (ok) ok = ds4_gpu_tensor_write(g.batch_cur_hc, 0, host_hc, hc_bytes) != 0;
+    if (ok) ok = ds4_gpu_tensor_write(g.batch_after_attn_hc, 0, host_hc, hc_bytes) != 0;
+    if (ok) ok = ds4_gpu_tensor_write(g.prefill_tokens, 0, host_tokens, (uint64_t)n_tokens * sizeof(int32_t)) != 0;
+    if (ok) ok = ds4_gpu_synchronize() != 0;
+    double total_ms = 0.0;
+    double best_ms = 0.0;
+    for (uint32_t it = 0; ok && it < iterations; it++) {
+        const double t0 = now_sec();
+        ok = cuda_layer_probe_run(&g, model, layer, il, n_tokens, ffn_only);
+        const double t1 = now_sec();
+        const double ms = (t1 - t0) * 1000.0;
+        if (ok) {
+            total_ms += ms;
+            if (it == 0 || ms < best_ms) best_ms = ms;
+            fprintf(stderr,
+                    "ds4: CUDA %s probe iter=%u ms=%.3f\n",
+                    ffn_only ? "ffn" : "layer",
+                    it,
+                    ms);
+        }
+    }
+    uint64_t out_hash = 0;
+    uint64_t out_nonfinite = 0;
+    if (ok) {
+        ok = ds4_gpu_tensor_read(g.batch_next_hc, 0, host_out, hc_bytes) != 0;
+        if (ok) {
+            out_hash = hash_bytes(host_out, hc_bytes);
+            out_nonfinite = cuda_probe_nonfinite_count(host_out, hc_bytes);
+        }
+    }
+    if (ok) {
+        const double avg_ms = total_ms / (double)iterations;
+        printf("{\"cuda_layer_probe\":true,\"part\":\"%s\",\"layer\":%u,\"tokens\":%u,\"iterations\":%u,\"raw_cap\":%u,\"ctx_size\":%u,\"avg_ms\":%.3f,\"best_ms\":%.3f,\"best_tokens_per_s\":%.3f,\"out_fnv64\":\"%016" PRIx64 "\",\"out_nonfinite\":%" PRIu64 "}\n",
+               ffn_only ? "ffn" : "layer",
+               il,
+               n_tokens,
+               iterations,
+               raw_cap,
+               ctx_size,
+               avg_ms,
+               best_ms,
+               best_ms > 0.0 ? (double)n_tokens * 1000.0 / best_ms : 0.0,
+               out_hash,
+               out_nonfinite);
+    }
+    metal_graph_free(&g);
+    free(host_out);
+    free(host_tokens);
+    free(host_hc);
+    if (!ok) {
+        fprintf(stderr, "ds4: CUDA layer probe failed\n");
+        return 1;
+    }
+    return 0;
+#endif
+}
