+static void cuda_moe_probe_fill(float *x, int32_t *tokens, uint32_t n_tokens, uint32_t n_dim) {
+    for (uint32_t t = 0; t < n_tokens; t++) {
+        tokens[t] = (int32_t)(17u + ((t * 131u) % 32000u));
+        for (uint32_t i = 0; i < n_dim; i++) {
+            uint32_t v = (t * 1103515245u) ^ (i * 2654435761u) ^ 0x9e3779b9u;
+            x[(uint64_t)t * n_dim + i] = ((float)(int32_t)(v & 1023u) - 511.5f) * (1.0f / 8192.0f);
+        }
+    }
+}
+
+static void cuda_probe_fill_f32(float *x, uint64_t n, uint32_t seed) {
+    for (uint64_t i = 0; i < n; i++) {
+        uint32_t v = ((uint32_t)i * 2654435761u) ^ (seed * 1103515245u) ^ 0x7f4a7c15u;
+        x[i] = ((float)(int32_t)(v & 2047u) - 1023.5f) * (1.0f / 16384.0f);
+    }
+}
+
+static bool cuda_probe_seed_tensor(ds4_gpu_tensor *t, uint64_t n_f32, uint32_t seed) {
+    if (!t || ds4_gpu_tensor_bytes(t) < n_f32 * sizeof(float)) return false;
+    float *host = xmalloc((size_t)(n_f32 * sizeof(host[0])));
+    cuda_probe_fill_f32(host, n_f32, seed);
+    const bool ok = ds4_gpu_tensor_write(t, 0, host, n_f32 * sizeof(host[0])) != 0;
+    free(host);
+    return ok;
+}
