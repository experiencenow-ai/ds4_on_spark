+int ds4_engine_cuda_decode_stack_probe(ds4_engine *e, uint32_t pos, uint32_t iterations) {
+#ifdef DS4_NO_GPU
+    (void)e;
+    (void)pos;
+    (void)iterations;
+    fprintf(stderr, "ds4: CUDA decode stack probe requested but this build has no graph backend support\n");
+    return 1;
+#else
+    if (!e || e->backend != DS4_BACKEND_CUDA || !e->metal_ready) {
+        fprintf(stderr, "ds4: CUDA decode stack probe requires an initialized CUDA backend\n");
+        return 1;
+    }
+    if (iterations == 0 || pos > 1048576u) {
+        fprintf(stderr, "ds4: invalid CUDA decode stack probe arguments pos=%u iterations=%u\n",
+                pos, iterations);
+        return 1;
+    }
+    const ds4_model *model = &e->model;
+    const ds4_weights *weights = &e->weights;
+    const uint32_t ctx_size = pos + 1u;
+    const uint32_t raw_cap = DS4_N_SWA;
+    const uint64_t hc_dim = (uint64_t)DS4_N_HC * DS4_N_EMBD;
+    const uint64_t hc_bytes = hc_dim * sizeof(float);
+    const uint64_t logits_bytes = (uint64_t)weights->output->dim[1] * sizeof(float);
+    uint8_t *host_hc = xmalloc((size_t)hc_bytes);
+    uint8_t *host_logits = xmalloc((size_t)logits_bytes);
+    uint32_t n_comp_base[DS4_N_LAYER];
+    uint32_t n_index_base[DS4_N_LAYER];
+    ds4_gpu_graph g;
+    bool ok = metal_graph_alloc_raw_cap(&g, weights, &weights->layer[0], raw_cap, ctx_size, 1, false);
+    if (ok) ok = cuda_stack_probe_reset_compressor_state(&g);
+    if (ok) ok = cuda_decode_stack_probe_seed(&g, pos, n_comp_base, n_index_base);
+    if (ok) ok = ds4_gpu_synchronize() != 0;
+    double total_ms = 0.0;
+    double best_ms = 0.0;
+    for (uint32_t it = 0; ok && it < iterations; it++) {
+        if (ok) ok = cuda_stack_probe_reset_compressor_state(&g);
+        if (ok) ok = cuda_decode_stack_probe_seed(&g, pos, n_comp_base, n_index_base);
+        if (ok) ok = ds4_gpu_synchronize() != 0;
+        const double t0 = now_sec();
+        ok = cuda_decode_stack_probe_run(&g, model, weights, pos, n_comp_base, n_index_base);
+        const double t1 = now_sec();
+        const double ms = (t1 - t0) * 1000.0;
+        if (ok) {
+            total_ms += ms;
+            if (it == 0 || ms < best_ms) best_ms = ms;
+            fprintf(stderr, "ds4: CUDA decode stack probe iter=%u ms=%.3f\n", it, ms);
+        }
+    }
+    uint64_t hc_hash = 0;
+    uint64_t logits_hash = 0;
+    uint64_t hc_nonfinite = 0;
+    uint64_t logits_nonfinite = 0;
+    const bool include_head = cuda_stack_probe_include_head();
+    if (ok) {
+        ok = ds4_gpu_tensor_read(g.cur_hc, 0, host_hc, hc_bytes) != 0;
+        if (ok && include_head) ok = ds4_gpu_tensor_read(g.logits, 0, host_logits, logits_bytes) != 0;
+        if (ok) {
+            hc_hash = hash_bytes(host_hc, hc_bytes);
+            hc_nonfinite = cuda_probe_nonfinite_count(host_hc, hc_bytes);
+            if (include_head) {
+                logits_hash = hash_bytes(host_logits, logits_bytes);
+                logits_nonfinite = cuda_probe_nonfinite_count(host_logits, logits_bytes);
+            }
+        }
+    }
+    if (ok) {
+        const double avg_ms = total_ms / (double)iterations;
+        printf("{\"cuda_decode_stack_probe\":true,\"layers\":%u,\"pos\":%u,\"iterations\":%u,\"raw_cap\":%u,\"includes_output_head\":%s,\"avg_ms\":%.3f,\"best_ms\":%.3f,\"best_tokens_per_s\":%.3f,\"hc_fnv64\":\"%016" PRIx64 "\",\"hc_nonfinite\":%" PRIu64 ",\"logits_fnv64\":\"%016" PRIx64 "\",\"logits_nonfinite\":%" PRIu64 "}\n",
+               (uint32_t)DS4_N_LAYER,
+               pos,
+               iterations,
+               raw_cap,
+               include_head ? "true" : "false",
+               avg_ms,
+               best_ms,
+               best_ms > 0.0 ? 1000.0 / best_ms : 0.0,
+               hc_hash,
+               hc_nonfinite,
+               logits_hash,
+               logits_nonfinite);
+    }
+    metal_graph_free(&g);
+    free(host_logits);
+    free(host_hc);
+    if (!ok) {
+        fprintf(stderr, "ds4: CUDA decode stack probe failed\n");
+        return 1;
+    }
+    return 0;
+#endif
+}
