 }
+
+extern "C" int ds4_gpu_preload_model_range(const void *model_map, uint64_t model_size, uint64_t offset, uint64_t bytes, const char *label, uint64_t chunk_bytes, uint32_t sleep_us) {
+    if (!model_map || bytes == 0) return 1;
+    if (offset > model_size || bytes > model_size - offset) return 0;
+    if (cuda_model_range_is_cached(model_map, offset, bytes)) return 1;
+    const char *what = label ? label : "model_tensor";
+    const uint64_t limit = cuda_model_cache_limit_bytes();
+    if (g_model_range_bytes > limit || bytes > limit - g_model_range_bytes) {
+        fprintf(stderr, "ds4: CUDA explicit preload budget exhausted for %s %.2f MiB (cache %.2f/%.2f GiB)\n",
+                what,
+                (double)bytes / 1048576.0,
+                (double)g_model_range_bytes / 1073741824.0,
+                (double)limit / 1073741824.0);
+        return 0;
+    }
+    if (chunk_bytes < 1048576ull) chunk_bytes = 1048576ull;
+    if (chunk_bytes > 256ull * 1048576ull) chunk_bytes = 256ull * 1048576ull;
+    char *dev = cuda_model_arena_alloc(bytes, what);
+    if (!dev) return 0;
+    const uint64_t stage_align = cuda_model_direct_align_for_map(model_map);
+    const uint64_t stage_bytes = chunk_bytes + stage_align;
+    if (!cuda_model_stage_pool_alloc(stage_bytes, stage_align)) return 0;
+    uint64_t copied = 0;
+    while (copied < bytes) {
+        const uint64_t n = (bytes - copied < chunk_bytes) ? (bytes - copied) : chunk_bytes;
+        const char *payload = NULL;
+        if (!cuda_model_stage_read(model_map, g_model_stage[0], g_model_stage_bytes, offset + copied, n, &payload)) {
+            fprintf(stderr, "ds4: CUDA explicit preload read failed for %s at %.2f/%.2f MiB: %s\n",
+                    what,
+                    (double)copied / 1048576.0,
+                    (double)bytes / 1048576.0,
+                    strerror(errno));
+            return 0;
+        }
+        cudaError_t err = cudaMemcpy(dev + copied, payload, (size_t)n, cudaMemcpyHostToDevice);
+        if (err != cudaSuccess) {
+            fprintf(stderr, "ds4: CUDA explicit preload copy failed for %s at %.2f/%.2f MiB: %s\n",
+                    what,
+                    (double)copied / 1048576.0,
+                    (double)bytes / 1048576.0,
+                    cudaGetErrorString(err));
+            (void)cudaGetLastError();
+            return 0;
+        }
+        err = cudaDeviceSynchronize();
+        if (err != cudaSuccess) {
+            fprintf(stderr, "ds4: CUDA explicit preload sync failed for %s at %.2f/%.2f MiB: %s\n",
+                    what,
+                    (double)(copied + n) / 1048576.0,
+                    (double)bytes / 1048576.0,
+                    cudaGetErrorString(err));
+            (void)cudaGetLastError();
+            return 0;
+        }
+        cuda_model_drop_file_pages(model_map, offset + copied, n);
+        cuda_model_discard_source_pages(model_map, model_size, offset + copied, n);
+        copied += n;
+        cuda_model_load_progress_note(g_model_range_bytes + copied);
+        if (sleep_us > 0) usleep((useconds_t)sleep_us);
+    }
+    g_model_ranges.push_back({model_map, offset, bytes, dev, NULL, NULL, 0, 0, 1});
+    {
+        auto key = cuda_model_offset_key{model_map, cuda_model_fd_for_map(model_map), offset};
+        auto it = g_model_range_by_key.find(key);
+        if (it == g_model_range_by_key.end() || g_model_ranges[it->second].bytes < bytes) {
+            g_model_range_by_key[key] = g_model_ranges.size() - 1u;
+        }
+    }
+    g_model_range_bytes += bytes;
+    cuda_model_load_progress_note(g_model_range_bytes);
+    if (getenv("DS4_CUDA_WEIGHT_CACHE_VERBOSE")) {
+        fprintf(stderr, "ds4: CUDA explicit preloaded %s %.2f MiB in %.2f MiB chunks (total %.2f GiB)\n",
+                what,
+                (double)bytes / 1048576.0,
+                (double)chunk_bytes / 1048576.0,
+                (double)g_model_range_bytes / 1073741824.0);
+    }
+    return cuda_model_range_is_cached(model_map, offset, bytes);
+}
 
