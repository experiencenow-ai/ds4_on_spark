+/* Exact K=2 target suffix verifier for MTP.
+ *
+ * This is the architecture reset hook: callers ask for one strict suffix
+ * verification over two draft positions, and the implementation owns target
+ * state staging, top1 comparison, continuation logits, and KV commit/restore
+ * semantics.  The first implementation deliberately delegates to the existing
+ * decode2 verifier, so invocation accounting proves whether the path is still
+ * serial.  A real speed path must replace this body with one target suffix pass.
+ */
+static bool target_suffix_verify_k2(
+        ds4_gpu_graph          *g,
+        const ds4_model        *model,
+        const ds4_weights      *weights,
+        int32_t                 draft0,
+        int32_t                 draft1,
+        uint32_t                start_pos,
+        ds4_mtp_suffix2_result *out,
+        float                  *continuation_logits,
+        ds4_mtp_decode2_stats  *stats)
+{
+    int32_t row0_top;
+    if (g == NULL || model == NULL || weights == NULL || out == NULL || continuation_logits == NULL)
+        return false;
+    memset(out,0,sizeof(*out));
+    out->draft_tokens[0] = draft0;
+    out->draft_tokens[1] = draft1;
+    if (!metal_graph_verify_decode2_exact(g,model,weights,draft0,draft1,start_pos,&row0_top,NULL,continuation_logits,stats))
+        return false;
+    out->target_top1_pos1 = row0_top;
+    out->target_top1_pos2 = -1;
+    out->accepted_count = (row0_top == draft1) ? 2 : 1;
+    out->has_continuation_logits = true;
+    out->staged_kv_ready = false;
+    return true;
+}
+
+/* Exact N=2 target verifier for MTP.
