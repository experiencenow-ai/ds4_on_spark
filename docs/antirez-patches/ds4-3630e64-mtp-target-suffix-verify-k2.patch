+static bool metal_graph_decode2_fused_output_head(
+        ds4_gpu_graph *g,
+        const ds4_model *model,
+        const ds4_weights *weights,
+        ds4_gpu_tensor *cur0,
+        ds4_gpu_tensor *cur1,
+        int *top0,
+        float *logits1,
+        ds4_mtp_decode2_stats *stats) {
+    if (!g || !cur0 || !cur1 || !top0 || !logits1 || !g->spec_logits) return false;
+    const uint64_t hc_dim = (uint64_t)DS4_N_HC * DS4_N_EMBD;
+    const uint64_t hc_bytes = hc_dim * sizeof(float);
+    const double head_t0 = stats ? now_sec() : 0.0;
+    bool ok = true;
+    ok = ds4_gpu_tensor_copy(g->batch_cur_hc, 0, cur0, 0, hc_bytes) != 0;
+    if (ok) ok = ds4_gpu_tensor_copy(g->batch_cur_hc, hc_bytes, cur1, 0, hc_bytes) != 0;
+    if (ok) ok = ds4_gpu_begin_commands() != 0;
+    if (ok) ok = metal_graph_encode_output_head_batch(g, model, weights, 2, weights->output->dim[1]);
+    if (ok) ok = ds4_gpu_indexer_topk_tensor(g->comp_selected,
+                                               g->spec_logits,
+                                               DS4_N_VOCAB,
+                                               1,
+                                               1) != 0;
+    if (ok) ok = ds4_gpu_end_commands() != 0;
+    else {
+        (void)ds4_gpu_synchronize();
+        if (stats) stats->cuda_sync_count++;
+    }
+    if (stats) {
+        stats->output_head_call_count++;
+        stats->output_head_rows += 2;
+        stats->full_vocab_logits_rows++;
+        stats->top1_only_rows++;
+        stats->output_head_ms += (now_sec() - head_t0) * 1000.0;
+    }
+    if (ok) ok = ds4_gpu_tensor_read(g->comp_selected, 0, top0, sizeof(*top0)) != 0;
+    if (ok) ok = metal_graph_read_spec_logits_row(g, 1, logits1);
+    return ok;
+}
