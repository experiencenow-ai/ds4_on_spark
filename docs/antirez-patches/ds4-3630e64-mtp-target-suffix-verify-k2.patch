+__global__ static void matmul_q8_0_top1_candidates_kernel(
+        float *candidate_vals,
+        uint32_t *candidate_idxs,
+        const unsigned char *w,
+        const int8_t *xq,
+        const float *xscale,
+        uint64_t in_dim,
+        uint64_t out_dim,
+        uint64_t blocks,
+        int use_dp4a) {
+    uint32_t warp = threadIdx.x >> 5u;
+    uint32_t lane = threadIdx.x & 31u;
+    uint64_t row = (uint64_t)blockIdx.x * 8u + warp;
+    float acc = -INFINITY;
+    if (warp < 8u && row < out_dim) {
+        const unsigned char *wr = w + row * blocks * 34;
+        acc = 0.0f;
+        for (uint64_t b = lane; b < blocks; b += 32u) {
+            uint64_t i0 = b * 32;
+            uint64_t bn = in_dim - i0 < 32 ? in_dim - i0 : 32;
+            const __half *scale_h = (const __half *)(wr + b * 34);
+            const int8_t *qs = (const int8_t *)(wr + b * 34 + 2);
+            const int8_t *xqb = xq + b * 32;
+            int dot = dot_i8_block(qs, xqb, bn, use_dp4a);
+            acc += __half2float(*scale_h) * xscale[b] * (float)dot;
+        }
+        acc = warp_sum_f32(acc);
+    }
+    __shared__ float vals[8];
+    __shared__ uint32_t idxs[8];
+    if (lane == 0 && warp < 8u) {
+        vals[warp] = acc;
+        idxs[warp] = row < out_dim ? (uint32_t)row : UINT32_MAX;
+    }
+    __syncthreads();
+    if (threadIdx.x == 0) {
+        float best = vals[0];
+        uint32_t best_idx = idxs[0];
+        for (uint32_t i = 1; i < 8u; i++) {
+            if (vals[i] > best || (vals[i] == best && idxs[i] < best_idx)) {
+                best = vals[i];
+                best_idx = idxs[i];
+            }
+        }
+        candidate_vals[blockIdx.x] = best;
+        candidate_idxs[blockIdx.x] = best_idx;
+    }
+}
+
+__global__ static void matmul_q8_0_top1_reduce_kernel(
+        uint32_t *selected,
+        const float *candidate_vals,
+        const uint32_t *candidate_idxs,
+        uint32_t candidate_count) {
+    if (threadIdx.x != 0 || blockIdx.x != 0 || candidate_count == 0) return;
+    float best = candidate_vals[0];
+    uint32_t best_idx = candidate_idxs[0];
+    for (uint32_t i = 1; i < candidate_count; i++) {
+        uint32_t idx = candidate_idxs[i];
+        float v = candidate_vals[i];
+        if (v > best || (v == best && idx < best_idx)) {
+            best = v;
+            best_idx = idx;
+        }
+    }
+    selected[0] = best_idx;
+}
