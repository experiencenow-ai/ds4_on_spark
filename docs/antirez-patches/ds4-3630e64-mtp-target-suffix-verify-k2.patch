+static bool metal_graph_encode_output_head_suffix2_top1(
+        ds4_gpu_graph *g,
+        const ds4_model       *model,
+        const ds4_weights     *weights,
+        uint64_t               vocab_dim) {
+    if (!g->spec_logits) return false;
+
+    const uint64_t hc_dim = (uint64_t)DS4_N_HC * DS4_N_EMBD;
+    ds4_gpu_tensor *output_pre = NULL;
+    ds4_gpu_tensor *output_weights = NULL;
+    ds4_gpu_tensor *output_embd = NULL;
+    ds4_gpu_tensor *output_norm = NULL;
+    ds4_gpu_tensor *row0_norm = NULL;
+    ds4_gpu_tensor *row1_norm = NULL;
+    ds4_gpu_tensor *row1_logits = NULL;
+
+    bool ok = true;
+    output_pre = ds4_gpu_tensor_view(g->batch_hc_mix, 0, 2ull * DS4_N_HC * sizeof(float));
+    output_weights = ds4_gpu_tensor_view(g->batch_hc_split, 0, 2ull * DS4_N_HC * sizeof(float));
+    output_embd = ds4_gpu_tensor_view(g->batch_ffn_cur, 0, 2ull * DS4_N_EMBD * sizeof(float));
+    output_norm = ds4_gpu_tensor_view(g->batch_ffn_norm, 0, 2ull * DS4_N_EMBD * sizeof(float));
+    row0_norm = ds4_gpu_tensor_view(g->batch_ffn_norm, 0, (uint64_t)DS4_N_EMBD * sizeof(float));
+    row1_norm = ds4_gpu_tensor_view(g->batch_ffn_norm, (uint64_t)DS4_N_EMBD * sizeof(float), (uint64_t)DS4_N_EMBD * sizeof(float));
+    row1_logits = ds4_gpu_tensor_view(g->spec_logits, vocab_dim * sizeof(float), vocab_dim * sizeof(float));
+    ok = output_pre && output_weights && output_embd && output_norm && row0_norm && row1_norm && row1_logits;
+
+    if (ok) ok = ds4_gpu_rms_norm_plain_rows_tensor(g->batch_flat_hc,
+                                                      g->batch_cur_hc,
+                                                      (uint32_t)hc_dim,
+                                                      2,
+                                                      DS4_RMS_EPS) != 0;
+    if (ok) ok = ds4_gpu_matmul_f16_tensor(output_pre,
+                                             model->map,
+                                             model->size,
+                                             weights->output_hc_fn->abs_offset,
+                                             hc_dim,
+                                             DS4_N_HC,
+                                             g->batch_flat_hc,
+                                             2) != 0;
+    if (ok) ok = ds4_gpu_output_hc_weights_tensor(output_weights,
+                                                    output_pre,
+                                                    model->map,
+                                                    model->size,
+                                                    weights->output_hc_scale->abs_offset,
+                                                    weights->output_hc_base->abs_offset,
+                                                    DS4_N_HC,
+                                                    DS4_HC_EPS) != 0;
+    if (ok) ok = ds4_gpu_hc_weighted_sum_tensor(output_embd,
+                                                  g->batch_cur_hc,
+                                                  output_weights,
+                                                  DS4_N_EMBD,
+                                                  DS4_N_HC) != 0;
+    if (ok) ok = ds4_gpu_rms_norm_weight_rows_tensor(output_norm,
+                                                       output_embd,
+                                                       model->map,
+                                                       model->size,
+                                                       weights->output_norm->abs_offset,
+                                                       DS4_N_EMBD,
+                                                       2,
+                                                       DS4_RMS_EPS) != 0;
+    if (ok) ok = ds4_gpu_matmul_q8_0_top1_tensor(g->comp_selected,
+                                                   model->map,
+                                                   model->size,
+                                                   weights->output->abs_offset,
+                                                   DS4_N_EMBD,
+                                                   vocab_dim,
+                                                   row0_norm) != 0;
+    if (ok) ok = ds4_gpu_matmul_q8_0_tensor(row1_logits,
+                                              model->map,
+                                              model->size,
+                                              weights->output->abs_offset,
+                                              DS4_N_EMBD,
+                                              vocab_dim,
+                                              row1_norm,
+                                              1) != 0;
+
+    ds4_gpu_tensor_free(row1_logits);
+    ds4_gpu_tensor_free(row1_norm);
+    ds4_gpu_tensor_free(row0_norm);
+    ds4_gpu_tensor_free(output_norm);
+    ds4_gpu_tensor_free(output_embd);
+    ds4_gpu_tensor_free(output_weights);
+    ds4_gpu_tensor_free(output_pre);
+    return ok;
+}
