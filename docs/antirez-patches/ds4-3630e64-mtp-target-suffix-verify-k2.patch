+static int metal_graph_try_mtp_suffix2_direct(
+        ds4_gpu_graph       *g,
+        const ds4_model     *model,
+        const ds4_weights   *weights,
+        const ds4_model     *mtp_model,
+        const ds4_mtp_weights *mtp_weights,
+        int                  eos_id,
+        token_vec           *checkpoint,
+        int                  first_token,
+        int                  max_extra,
+        int                 *accepted,
+        int                  accepted_cap,
+        float               *logits,
+        ds4_direct_mtp_stats *stats) {
+    if (max_extra <= 0 || !mtp_weights || !checkpoint || !accepted || accepted_cap <= 0 || !logits)
+        return 0;
+    const bool mtp_timing = getenv("DS4_MTP_TIMING") != NULL;
+    const bool row0_top1_head = getenv("DS4_MTP_ROW0_FULL_LOGITS") == NULL;
+    const double t0 = mtp_timing ? now_sec() : 0.0;
+    const int pos0 = checkpoint->len;
+    if (!metal_graph_eval_token_raw_swa(g, model, weights, (uint32_t)first_token, (uint32_t)pos0, logits))
+        return -1;
+    token_vec_push(checkpoint, first_token);
+    accepted[0] = first_token;
+    if (stats) {
+        stats->first_target_calls++;
+        stats->target_positions++;
+        stats->head_calls++;
+        stats->head_rows++;
+        stats->full_vocab_rows++;
+        stats->emitted++;
+    }
+    const double t_after_first = mtp_timing ? now_sec() : 0.0;
+    if (stats) stats->first_eval_ms += (t_after_first - t0) * 1000.0;
+    if (max_extra <= 1 || accepted_cap <= 1)
+        return 1;
+    const uint32_t mtp_base_raw = g->mtp_n_raw;
+    int drafts[2] = {-1,-1};
+    const double t_draft0 = mtp_timing ? now_sec() : 0.0;
+    if (!metal_graph_eval_mtp_draft(g, model, weights, mtp_model, mtp_weights,
+                                    first_token, (uint32_t)pos0, NULL, &drafts[0]))
+        return 1;
+    if (stats) stats->draft_calls++;
+    if (sample_argmax(logits, DS4_N_VOCAB) != drafts[0] || drafts[0] == eos_id)
+        return 1;
+    if (!metal_graph_eval_mtp_draft_from_hc(g, model, weights, mtp_model, mtp_weights,
+                                            g->mtp_state_hc, g->mtp_next_hc,
+                                            drafts[0], (uint32_t)checkpoint->len,
+                                            NULL, &drafts[1]))
+        return 1;
+    if (stats) stats->draft_calls++;
+    const double t_after_draft = mtp_timing ? now_sec() : 0.0;
+    if (stats) stats->draft_ms += (t_after_draft - t_draft0) * 1000.0;
+    if (drafts[1] == eos_id)
+        return 1;
+    const int start = checkpoint->len;
+    token_vec_push(checkpoint, drafts[0]);
+    token_vec_push(checkpoint, drafts[1]);
+    int row_tops[2] = {-1,-1};
+    const double t_suffix0 = mtp_timing ? now_sec() : 0.0;
+    bool ok = metal_graph_verify_suffix_tops(g, model, weights, checkpoint,
+                                             (uint32_t)start, 2, true,
+                                             row_tops, NULL);
+    const double t_suffix1 = mtp_timing ? now_sec() : 0.0;
+    if (stats) {
+        stats->suffix_target_calls++;
+        stats->target_positions += 2;
+        stats->head_calls++;
+        stats->head_rows += 2;
+        stats->full_vocab_rows += row0_top1_head ? 1 : 2;
+        stats->top1_rows += row0_top1_head ? 1 : 0;
+        stats->suffix_ms += (t_suffix1 - t_suffix0) * 1000.0;
+    }
+    if (!ok) {
+        checkpoint->len = start;
+        return 1;
+    }
+    if (row_tops[0] == drafts[1] && max_extra >= 3 && accepted_cap >= 3) {
+        if (!metal_graph_read_spec_logits_row(g, 1, logits)) {
+            checkpoint->len = start;
+            return -1;
+        }
+        if (stats) stats->emitted += 2;
+        accepted[1] = drafts[0];
+        accepted[2] = drafts[1];
+        if (mtp_timing) {
+            fprintf(stderr,
+                    "ds4: mtp timing suffix2 drafted=2 committed=2 first_eval=%.3f ms draft=%.3f ms snapshot=0.000 ms verify=%.3f ms target=%.3f ms head=0.000 ms verifier_calls=2 target_positions=3 target_calls=2 head_calls=2 head_rows=3 full_vocab_rows=%d top1_rows=%d draft_calls=2 replay_calls=0 rewind_calls=0 cache_sync_calls=0 cuda_sync_calls=0 emitted=3 total=%.3f ms\n",
+                    (t_after_first - t0) * 1000.0,
+                    (t_after_draft - t_draft0) * 1000.0,
+                    (t_suffix1 - t_suffix0) * 1000.0,
+                    (t_suffix1 - t_suffix0) * 1000.0,
+                    row0_top1_head ? 2 : 3,
+                    row0_top1_head ? 1 : 0,
+                    (now_sec() - t0) * 1000.0);
+        }
+        uint32_t keep = mtp_base_raw + 2u;
+        if (keep > g->raw_window) keep = g->raw_window;
+        g->mtp_n_raw = keep;
+        return 3;
+    }
+    const double t_prefix0 = mtp_timing ? now_sec() : 0.0;
+    ok = spec_frontier_commit_prefix1_graph(g);
+    const double t_prefix1 = mtp_timing ? now_sec() : 0.0;
+    if (stats) stats->prefix_ms += (t_prefix1 - t_prefix0) * 1000.0;
+    checkpoint->len = start;
+    if (!ok)
+        return -1;
+    if (!metal_graph_read_suffix_logits_or_top1(g, model, weights, 0, logits))
+        return -1;
+    if (stats && row0_top1_head) {
+        stats->head_calls++;
+        stats->head_rows++;
+        stats->full_vocab_rows++;
+    }
+    token_vec_push(checkpoint, drafts[0]);
+    if (stats) stats->emitted++;
+    accepted[1] = drafts[0];
+    if (mtp_timing) {
+        fprintf(stderr,
+                "ds4: mtp timing suffix2 drafted=2 committed=1 first_eval=%.3f ms draft=%.3f ms snapshot=0.000 ms verify=%.3f ms prefix=%.3f ms target=%.3f ms head=0.000 ms verifier_calls=2 target_positions=3 target_calls=2 head_calls=%d head_rows=%d full_vocab_rows=%d top1_rows=%d draft_calls=2 replay_calls=0 rewind_calls=0 cache_sync_calls=0 cuda_sync_calls=0 emitted=2 total=%.3f ms\n",
+                (t_after_first - t0) * 1000.0,
+                (t_after_draft - t_draft0) * 1000.0,
+                (t_suffix1 - t_suffix0) * 1000.0,
+                (t_prefix1 - t_prefix0) * 1000.0,
+                (t_suffix1 - t_suffix0) * 1000.0,
+                row0_top1_head ? 3 : 2,
+                row0_top1_head ? 4 : 3,
+                3,
+                row0_top1_head ? 1 : 0,
+                (now_sec() - t0) * 1000.0);
+    }
+    uint32_t keep = mtp_base_raw + 1u;
+    if (keep > g->raw_window) keep = g->raw_window;
+    g->mtp_n_raw = keep;
+    return 2;
+}
