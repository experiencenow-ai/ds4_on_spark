diff --git a/ds4.c b/ds4.c
index f0f8cc1..2b1cb0d 100644
--- a/ds4.c
+++ b/ds4.c
@@ -17291,12 +17291,92 @@ int ds4_session_eval_speculative_argmax(ds4_session *s, int first_token,
     }

     /*
-     * The useful N=2 verifier is the tiny batch path: it verifies two target
-     * positions in one layer-major pass and commits prefix-1 directly on a
-     * partial accept.  Like the rest of the non-quality Metal path, it may pick
-     * a different greedy token when batched reductions perturb nearly-tied
-     * logits.  --quality / DS4_MTP_STRICT selects the exact decode verifier,
-     * which preserves the one-token target stream but is not a speed win.
+     * Proper K=2 target suffix verification: append the drafted suffix to a
+     * staged checkpoint, run the target graph over both suffix positions as one
+     * verifier job, compare row0 top-1 against draft[1], and commit either the
+     * whole staged target KV or the captured prefix-1 target KV.
+     */
+    const bool use_target_suffix2 =
+        draft_n == 2 && getenv("DS4_MTP_SERIAL_SUFFIX") == NULL;
+    if (use_target_suffix2) {
+        int row_tops[2] = {-1,-1};
+        float *row_logits = xmalloc((size_t)DS4_N_VOCAB * sizeof(row_logits[0]));
+        const int start = s->checkpoint.len;
+        const double snapshot_t0 = mtp_timing ? now_sec() : 0.0;
+        const double snapshot_done = snapshot_t0;
+        const double target_t0 = mtp_timing ? now_sec() : 0.0;
+        bool ok = true;
+        token_vec_push(&s->checkpoint, drafts[0]);
+        token_vec_push(&s->checkpoint, drafts[1]);
+        ok = metal_graph_verify_suffix_tops(&s->graph,
+                                            &e->model,
+                                            &e->weights,
+                                            &s->checkpoint,
+                                            (uint32_t)start,
+                                            2,
+                                            true,
+                                            row_tops,
+                                            NULL);
+        const double verify_done = mtp_timing ? now_sec() : 0.0;
+        const double target_ms = (verify_done - target_t0) * 1000.0;
+        if (ok && row_tops[0] == drafts[1]) {
+            ok = metal_graph_read_spec_logits_row(&s->graph, 1, row_logits);
+            if (ok) {
+                memcpy(s->logits, row_logits, (size_t)DS4_N_VOCAB * sizeof(s->logits[0]));
+                accepted[n_accept++] = drafts[0];
+                if (n_accept < accepted_cap) accepted[n_accept++] = drafts[1];
+                s->checkpoint_valid = true;
+                s->mtp_draft_valid = false;
+                DS4_MTP_KEEP_ACCEPTED(2);
+                if (mtp_timing) {
+                    fprintf(stderr,
+                            "ds4: mtp timing suffix2 drafted=2 committed=2 draft=%.3f ms snapshot=%.3f ms verify=%.3f ms target=%.3f ms head=0.000 ms verifier_calls=1 target_positions=2 target_calls=1 head_calls=1 head_rows=2 full_vocab_rows=2 top1_rows=0 draft_calls=1 replay_calls=0 rewind_calls=0 cache_sync_calls=0 cuda_sync_calls=0 emitted=3 total=%.3f ms\n",
+                            (mtp_t_after_draft - mtp_t0) * 1000.0,
+                            (snapshot_done - snapshot_t0) * 1000.0,
+                            (verify_done - snapshot_done) * 1000.0,
+                            target_ms,
+                            (now_sec() - mtp_t0) * 1000.0);
+                }
+                free(row_logits);
+                return n_accept;
+            }
+        }
+        if (ok) {
+            s->checkpoint.len = start;
+            ok = spec_frontier_commit_prefix1(s);
+        }
+        if (ok) ok = metal_graph_read_spec_logits_row(&s->graph, 0, row_logits);
+        if (ok) {
+            memcpy(s->logits, row_logits, (size_t)DS4_N_VOCAB * sizeof(s->logits[0]));
+            token_vec_push(&s->checkpoint, drafts[0]);
+            accepted[n_accept++] = drafts[0];
+            s->checkpoint_valid = true;
+            s->mtp_draft_valid = false;
+            DS4_MTP_KEEP_ACCEPTED(1);
+            if (mtp_timing) {
+                const double done = now_sec();
+                fprintf(stderr,
+                        "ds4: mtp timing suffix2 drafted=2 committed=1 draft=%.3f ms snapshot=%.3f ms verify=%.3f ms prefix=%.3f ms target=%.3f ms head=0.000 ms verifier_calls=1 target_positions=2 target_calls=1 head_calls=1 head_rows=2 full_vocab_rows=2 top1_rows=0 draft_calls=1 replay_calls=0 rewind_calls=0 cache_sync_calls=0 cuda_sync_calls=0 emitted=2 total=%.3f ms\n",
+                        (mtp_t_after_draft - mtp_t0) * 1000.0,
+                        (snapshot_done - snapshot_t0) * 1000.0,
+                        (verify_done - snapshot_done) * 1000.0,
+                        (done - verify_done) * 1000.0,
+                        target_ms,
+                        (done - mtp_t0) * 1000.0);
+            }
+            free(row_logits);
+            return n_accept;
+        }
+        s->checkpoint.len = start;
+        s->checkpoint_valid = false;
+        free(row_logits);
+        snprintf(err, errlen, "MTP suffix2 verifier failed");
+        return -1;
+    }
+
+    /*
+     * Diagnostic serial verifier. It preserves the one-token target stream but
+     * should not be selected for speed-path MTP.
      */
     const bool use_decode2_exact =
         draft_n == 2 && strict_mtp && getenv("DS4_MTP_BATCH_VERIFY") == NULL;
