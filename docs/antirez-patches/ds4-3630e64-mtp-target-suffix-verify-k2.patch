-/* Exact N=2 target verifier for MTP.
+static bool mtp_kv_checkpoint_begin(ds4_gpu_graph *g,uint32_t start_pos,ds4_mtp_kv_checkpoint *cp)
+{
+    if ( g == NULL || cp == NULL )
+        return false;
+    memset(cp,0,sizeof(*cp));
+    cp->start_pos = start_pos;
+    cp->saved_cur_hc = g->cur_hc;
+    cp->saved_after_ffn_hc = g->after_ffn_hc;
+    cp->saved_capture_prefix1 = g->spec_capture_prefix1;
+    cp->active = true;
