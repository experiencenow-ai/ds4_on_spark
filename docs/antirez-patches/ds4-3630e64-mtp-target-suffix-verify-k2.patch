+static bool metal_graph_read_suffix_logits_or_top1(
+        ds4_gpu_graph       *g,
+        const ds4_model     *model,
+        const ds4_weights   *weights,
+        uint32_t             row,
+        float               *logits) {
+    if (getenv("DS4_MTP_ROW0_FULL_LOGITS") == NULL && row == 0) {
+        if (!metal_graph_materialize_suffix_logits_row(g, model, weights, row, weights->output->dim[1]))
+            return false;
+    }
+    return metal_graph_read_spec_logits_row(g, row, logits);
+}
