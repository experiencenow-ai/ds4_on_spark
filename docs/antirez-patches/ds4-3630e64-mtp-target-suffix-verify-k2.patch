+extern "C" int ds4_gpu_matmul_q8_0_top1_tensor(
+        ds4_gpu_tensor *selected,
+        const void *model_map,
+        uint64_t model_size,
+        uint64_t weight_offset,
+        uint64_t in_dim,
+        uint64_t out_dim,
+        const ds4_gpu_tensor *x) {
+    if (!selected || !x || !model_map || in_dim == 0 || out_dim == 0) return 0;
+    uint64_t blocks = (in_dim + 31) / 32;
+    if (weight_offset > model_size || out_dim > UINT64_MAX / (blocks * 34)) return 0;
+    uint64_t weight_bytes = out_dim * blocks * 34;
+    if (weight_bytes > model_size - weight_offset ||
+        x->bytes < in_dim * sizeof(float) ||
+        selected->bytes < sizeof(uint32_t)) return 0;
+    const char *wptr = cuda_model_range_ptr(model_map, weight_offset, weight_bytes, "q8_0_top1");
+    if (!wptr) return 0;
+    const uint64_t xq_bytes = blocks * 32u;
+    const uint64_t scale_offset = (xq_bytes + 15u) & ~15ull;
+    const uint64_t candidate_count = (out_dim + 7u) / 8u;
+    if (candidate_count > UINT64_MAX / (sizeof(float) + sizeof(uint32_t))) return 0;
+    const uint64_t vals_offset = scale_offset + blocks * sizeof(float);
+    const uint64_t idxs_offset = vals_offset + candidate_count * sizeof(float);
+    const uint64_t tmp_bytes = idxs_offset + candidate_count * sizeof(uint32_t);
+    void *tmp = cuda_tmp_alloc(tmp_bytes, "q8_0 top1");
+    if (!tmp) return 0;
+    int8_t *xq = (int8_t *)tmp;
+    float *xscale = (float *)((char *)tmp + scale_offset);
+    float *candidate_vals = (float *)((char *)tmp + vals_offset);
+    uint32_t *candidate_idxs = (uint32_t *)((char *)tmp + idxs_offset);
+    const int use_dp4a = cuda_q8_use_dp4a();
+    quantize_q8_0_f32_kernel<<<(unsigned)blocks, 32>>>(xq, xscale, (const float *)x->ptr, in_dim, blocks);
+    if (!cuda_ok(cudaGetLastError(), "matmul_q8_0 top1 quantize launch")) return 0;
+    matmul_q8_0_top1_candidates_kernel<<<(unsigned)candidate_count, 256>>>(
+            candidate_vals,
+            candidate_idxs,
+            reinterpret_cast<const unsigned char *>(wptr),
+            xq,
+            xscale,
+            in_dim,
+            out_dim,
+            blocks,
+            use_dp4a);
+    if (!cuda_ok(cudaGetLastError(), "matmul_q8_0 top1 candidates launch")) return 0;
+    matmul_q8_0_top1_reduce_kernel<<<1, 1>>>((uint32_t *)selected->ptr,
+                                             candidate_vals,
+                                             candidate_idxs,
+                                             (uint32_t)candidate_count);
