+    return true;
+}
+
+static void mtp_kv_checkpoint_restore(ds4_gpu_graph *g,ds4_mtp_kv_checkpoint *cp)
+{
+    if ( g == NULL || cp == NULL || cp->active == false )
+        return;
+    g->cur_hc = cp->saved_cur_hc;
+    g->after_ffn_hc = cp->saved_after_ffn_hc;
+    g->spec_capture_prefix1 = cp->saved_capture_prefix1;
+    cp->active = false;
+}
+
+static bool mtp_kv_checkpoint_commit_suffix2(ds4_gpu_graph *g,ds4_mtp_kv_checkpoint *cp,uint32_t accepted_count)
+{
+    if ( g == NULL || cp == NULL || cp->active == false )
+        return false;
+    if ( accepted_count == 0 || accepted_count > 2 )
+        return false;
+    /*
+     * The suffix graph writes staged KV for pos=start and pos=start+1 while
+     * leaving the live session frontier untouched.  Commit only the accepted
+     * prefix; failed suffix rows are discarded by restoring graph pointers.
+     */
+    g->spec_kv_commit_start = cp->start_pos;
+    g->spec_kv_commit_count = accepted_count;
+    if ( metal_graph_commit_staged_kv(g) == false )
+        return false;
+    mtp_kv_checkpoint_restore(g,cp);
+    return true;
+}
