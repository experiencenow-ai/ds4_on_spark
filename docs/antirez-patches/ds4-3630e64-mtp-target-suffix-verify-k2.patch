+static bool metal_graph_materialize_suffix_logits_row(
+        ds4_gpu_graph *g,
+        const ds4_model       *model,
+        const ds4_weights     *weights,
+        uint32_t               row,
+        uint64_t               vocab_dim) {
+    if (!g->spec_logits || row >= g->prefill_cap) return false;
+    ds4_gpu_tensor *row_norm = ds4_gpu_tensor_view(g->batch_ffn_norm,
+                                                     (uint64_t)row * DS4_N_EMBD * sizeof(float),
+                                                     (uint64_t)DS4_N_EMBD * sizeof(float));
+    ds4_gpu_tensor *row_logits = ds4_gpu_tensor_view(g->spec_logits,
+                                                       (uint64_t)row * vocab_dim * sizeof(float),
+                                                       vocab_dim * sizeof(float));
+    bool ok = row_norm && row_logits;
+    if (ok) ok = ds4_gpu_begin_commands() != 0;
+    if (ok) ok = ds4_gpu_matmul_q8_0_tensor(row_logits,
+                                              model->map,
+                                              model->size,
+                                              weights->output->abs_offset,
+                                              DS4_N_EMBD,
+                                              vocab_dim,
+                                              row_norm,
+                                              1) != 0;
+    if (ok) ok = ds4_gpu_end_commands() != 0;
+    else (void)ds4_gpu_synchronize();
+    ds4_gpu_tensor_free(row_logits);
+    ds4_gpu_tensor_free(row_norm);
+    return ok;
+}
