+static bool metal_graph_eval_target_suffix_k2_staged(
+        ds4_gpu_graph     *g,
+        const ds4_model   *model,
+        const ds4_weights *weights,
+        int32_t            draft0,
+        int32_t            draft1,
+        uint32_t           start_pos,
+        ds4_gpu_tensor   **cur0_out,
+        ds4_gpu_tensor   **cur1_out)
+{
+    ds4_gpu_tensor *cur0,*cur1,*next0,*next1,*tmp;
+    bool ok = true;
+    if ( g == NULL || model == NULL || weights == NULL || cur0_out == NULL || cur1_out == NULL )
+        return false;
+    cur0 = metal_graph_staged_suffix_hc_row(g,0);
+    cur1 = metal_graph_staged_suffix_hc_row(g,1);
+    next0 = metal_graph_staged_suffix_next_row(g,0);
+    next1 = metal_graph_staged_suffix_next_row(g,1);
+    if ( cur0 == NULL || cur1 == NULL || next0 == NULL || next1 == NULL )
+        return false;
+    ok = ds4_gpu_begin_commands() != 0;
+    if ( ok )
+        ok = metal_graph_embed_token_hc(g,model,weights,draft0,start_pos,cur0);
+    if ( ok )
+        ok = metal_graph_embed_token_hc(g,model,weights,draft1,start_pos + 1,cur1);
+    for (uint32_t il=0; ok && il<DS4_N_LAYER; il++)
+    {
+        ok = metal_graph_encode_decode_layer(g,model,weights,il,start_pos,cur0,next0);
+        if ( ok )
+            ok = metal_graph_encode_decode_layer(g,model,weights,il,start_pos + 1,cur1,next1);
+        tmp = cur0; cur0 = next0; next0 = tmp;
+        tmp = cur1; cur1 = next1; next1 = tmp;
+    }
+    if ( ok )
+        ok = ds4_gpu_end_commands() != 0;
+    else
+        (void)ds4_gpu_synchronize();
+    if ( ok == false )
+        return false;
+    *cur0_out = cur0;
+    *cur1_out = cur1;
+    return true;
+}
+
+/* Exact K=2 target suffix verifier for MTP.
+ *
+ * This is the DeepSeek-style economics reset: one verifier invocation owns two
+ * target positions, row0 only materializes top1 for the accept check, row1
+ * materializes continuation logits, and KV/cache writes stay staged until the
+ * caller commits the accepted prefix.  It must not call the serial decode2
+ * verifier; doing that recreates target-only decode cost token-for-token.
+ */
+static bool target_suffix_verify_k2(
+        ds4_gpu_graph          *g,
+        const ds4_model        *model,
+        const ds4_weights      *weights,
+        int32_t                 draft0,
+        int32_t                 draft1,
+        uint32_t                start_pos,
+        ds4_mtp_suffix2_result *out,
+        float                  *continuation_logits,
+        ds4_mtp_decode2_stats  *stats)
+{
+    ds4_gpu_tensor *cur0,*cur1;
+    double target_t0;
+    int32_t row0_top;
+    bool ok;
+    if ( g == NULL || model == NULL || weights == NULL || out == NULL || continuation_logits == NULL )
+        return false;
+    memset(out,0,sizeof(*out));
+    out->draft_tokens[0] = draft0;
+    out->draft_tokens[1] = draft1;
+    if ( mtp_kv_checkpoint_begin(g,start_pos,&out->checkpoint) == false )
+        return false;
+    target_t0 = stats != NULL ? now_sec() : 0.0;
+    ok = metal_graph_eval_target_suffix_k2_staged(g,model,weights,draft0,draft1,start_pos,&cur0,&cur1);
+    if ( stats != NULL )
+    {
+        stats->target_verifier_invocation_count++;
+        stats->target_eval_call_count++;
+        stats->target_positions_verified += 2;
+        stats->target_eval_ms += (now_sec() - target_t0) * 1000.0;
+    }
+    if ( ok == false )
+    {
+        mtp_kv_checkpoint_restore(g,&out->checkpoint);
+        return false;
+    }
+    ok = metal_graph_decode2_fused_output_head(g,model,weights,cur0,cur1,&row0_top,continuation_logits,stats);
+    if ( ok == false )
+    {
+        mtp_kv_checkpoint_restore(g,&out->checkpoint);
+        return false;
+    }
+    out->target_top1_pos1 = row0_top;
+    out->target_top1_pos2 = -1;
+    out->accepted_count = (row0_top == draft1) ? 2 : 1;
+    out->has_continuation_logits = true;
+    out->staged_kv_ready = true;
+    return true;
+}
