+static int cuda_moe_prepare_counted_expert_slices(
+        const void *model_map,
+        uint64_t model_size,
+        uint64_t gate_offset,
+        uint64_t up_offset,
+        uint64_t down_offset,
+        uint64_t gate_expert_bytes,
+        uint64_t down_expert_bytes,
+        const uint32_t *counts,
+        uint32_t n_routed_experts,
+        const char ***gate_slices_out,
+        const char ***up_slices_out,
+        const char ***down_slices_out,
+        uint32_t *active_experts_out) {
+    if (!model_map || !counts || !gate_slices_out || !up_slices_out || !down_slices_out ||
+        n_routed_experts == 0u || n_routed_experts > 256u ||
+        gate_expert_bytes == 0u || down_expert_bytes == 0u) {
+        return 0;
+    }
+    uint32_t host_counts[256] = {0};
+    const char *host_ptrs[768] = {NULL};
+    const uint64_t counts_bytes = (uint64_t)n_routed_experts * sizeof(uint32_t);
+    if (!cuda_ok(cudaMemcpy(host_counts, counts, (size_t)counts_bytes, cudaMemcpyDeviceToHost),
+                 "routed_moe batched expert counts copy")) {
+        return 0;
+    }
+    uint32_t active = 0;
+    for (uint32_t expert = 0; expert < n_routed_experts; expert++) {
+        if (host_counts[expert] == 0u) continue;
+        const uint64_t expert64 = (uint64_t)expert;
+        const uint64_t gate_slice_offset = gate_offset + expert64 * gate_expert_bytes;
+        const uint64_t up_slice_offset = up_offset + expert64 * gate_expert_bytes;
+        const uint64_t down_slice_offset = down_offset + expert64 * down_expert_bytes;
+        if (gate_slice_offset < gate_offset ||
+            up_slice_offset < up_offset ||
+            down_slice_offset < down_offset ||
+            gate_slice_offset > model_size || gate_expert_bytes > model_size - gate_slice_offset ||
+            up_slice_offset > model_size || gate_expert_bytes > model_size - up_slice_offset ||
+            down_slice_offset > model_size || down_expert_bytes > model_size - down_slice_offset) {
+            return 0;
+        }
+        host_ptrs[expert] = cuda_model_range_ptr(model_map, gate_slice_offset, gate_expert_bytes, "moe_gate_expert_batched");
+        host_ptrs[n_routed_experts + expert] = cuda_model_range_ptr(model_map, up_slice_offset, gate_expert_bytes, "moe_up_expert_batched");
+        host_ptrs[2u * n_routed_experts + expert] = cuda_model_range_ptr(model_map, down_slice_offset, down_expert_bytes, "moe_down_expert_batched");
+        if (!host_ptrs[expert] ||
+            !host_ptrs[n_routed_experts + expert] ||
+            !host_ptrs[2u * n_routed_experts + expert]) {
+            return 0;
+        }
+        active++;
+    }
+    const uint64_t ptr_count = 3ull * n_routed_experts;
+    const uint64_t ptr_bytes = ptr_count * sizeof(const char *);
+    const char **dev_ptrs = (const char **)cuda_tmp_alloc(ptr_bytes, "routed_moe batched expert slice pointers");
+    if (!dev_ptrs) return 0;
+    if (!cuda_ok(cudaMemcpy(dev_ptrs, host_ptrs, (size_t)ptr_bytes, cudaMemcpyHostToDevice),
+                 "routed_moe batched expert slice pointer copy")) {
+        return 0;
+    }
+    *gate_slices_out = dev_ptrs;
+    *up_slices_out = dev_ptrs + n_routed_experts;
+    *down_slices_out = dev_ptrs + 2u * n_routed_experts;
+    if (active_experts_out) *active_experts_out = active;
+    if (getenv("DS4_CUDA_MOE_EXPERT_SLICE_VERBOSE") != NULL) {
+        fprintf(stderr, "ds4: CUDA MoE batched expert slice cache prepared %u/%u active experts (%.2f MiB)\n",
+                active, n_routed_experts,
+                (double)(active * (2ull * gate_expert_bytes + down_expert_bytes)) / 1048576.0);
+    }
+    return 1;
+}
