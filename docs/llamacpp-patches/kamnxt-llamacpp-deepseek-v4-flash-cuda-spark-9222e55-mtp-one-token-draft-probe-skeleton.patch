+
+	s->ffn_gate_shexp = ggml_get_tensor(ctx, "mtp.0.ffn_gate_shexp.weight");
+	if (s->ffn_gate_shexp == nullptr) {
+		if (err != nullptr) *err = "missing tensor: mtp.0.ffn_gate_shexp.weight";
+		return false;
+	}
+	if (s->ffn_gate_shexp->type != GGML_TYPE_Q8_0) {
+		if (err != nullptr) *err = "tensor has unexpected type: mtp.0.ffn_gate_shexp.weight";
+		return false;
