--- /dev/null
+++ b/examples/ds4-mtp-one-token-draft-probe/ds4-mtp-one-token-draft-probe.cpp
@@ -0,0 +1,360 @@
+#include "deepseek4_mtp_sidecar.hpp"
+
+#include "ggml-backend.h"
+#include "gguf.h"
+#include "llama.h"
+
+#include <algorithm>
+#include <clocale>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+static void usage(const char * prog) {
+    std::fprintf(stderr, "usage: %s --model <trunk.gguf> --sidecar <mtp_sidecar.gguf> [--prompt <text>] [--seed N] [--json]\n", prog);
+}
+
+static std::string json_escape(const std::string & s) {
+    std::string out;
+    out.reserve(s.size() + 8);
+    for (const char c : s) {
+        switch (c) {
+            case '\\': out += "\\\\"; break;
+            case '"':  out += "\\\""; break;
+            case '\n': out += "\\n"; break;
+            case '\r': out += "\\r"; break;
+            case '\t': out += "\\t"; break;
+            default: out += c; break;
+        }
+    }
+    return out;
+}
+
+static int32_t argmax_f32(const float * logits, int32_t n) {
+    if (logits == nullptr || n <= 0) {
+        return -1;
+    }
+
+    int32_t best = 0;
+    float best_v = logits[0];
+    for (int32_t i = 1; i < n; i++) {
+        if (logits[i] > best_v) {
+            best_v = logits[i];
+            best = i;
+        }
+    }
+
+    return best;
+}
+
+static std::string token_to_piece(const llama_vocab * vocab, llama_token tok) {
+    if (vocab == nullptr) {
+        return std::string();
+    }
+
+    char buf[256];
+    const int n = llama_token_to_piece(vocab, tok, buf, sizeof(buf), 0, true);
+    if (n <= 0) {
+        return std::string();
+    }
+    return std::string(buf, (size_t) n);
+}
+
+struct pre_hc_head_capture {
+    bool got = false;
+    ggml_type type = GGML_TYPE_F32;
+    int64_t ne0 = 0;
+    int64_t ne1 = 0;
+    int64_t ne2 = 0;
+    int64_t ne3 = 0;
+    std::vector<uint8_t> bytes;
+};
+
+static uint64_t fnv1a64(const uint8_t *p, size_t n) {
+    uint64_t h = 14695981039346656037ull;
+    for (size_t i = 0; i < n; i++) {
+        h ^= (uint64_t) p[i];
+        h *= 1099511628211ull;
+    }
+    return h;
+}
+
+static std::string hex_u64(uint64_t v) {
+    char buf[17];
+    std::snprintf(buf, sizeof(buf), "%016llx", (unsigned long long) v);
+    return std::string(buf);
+}
+
+static bool capture_pre_hc_head(struct ggml_tensor * t, bool ask, void * user_data) {
+    if (t == nullptr || user_data == nullptr) {
+        return false;
+    }
+    if (std::strcmp(t->name, "result_pre_hc_head") != 0) {
+        return false;
+    }
+    if (ask) {
+        return true;
+    }
+
+    auto * cap = (pre_hc_head_capture *) user_data;
+    const size_t n_bytes = ggml_nbytes(t);
+
+    cap->bytes.resize(n_bytes);
+    ggml_backend_tensor_get(t, cap->bytes.data(), 0, n_bytes);
+    cap->type = t->type;
+    cap->ne0 = t->ne[0];
+    cap->ne1 = t->ne[1];
+    cap->ne2 = t->ne[2];
+    cap->ne3 = t->ne[3];
+    cap->got = true;
+
+    return true;
+}
+
+static void print_probe_json(
+        const std::string & trunk_path,
+        const std::string & sidecar_path,
+        const std::string & prompt,
+        int32_t seed,
+        int32_t base_next_token_id,
+        const std::string & base_next_token,
+        int32_t mtp_draft_token_id,
+        const std::string & mtp_draft_token,
+        const pre_hc_head_capture & trunk_pre_hc_head,
+        bool ok,
+        const std::vector<std::string> & errors) {
+    std::printf("{\n");
+    std::printf("  \"runtime_repo\": \"%s\",\n", "https://github.com/kamnxt/llama.cpp-deepseek-v4-flash-cuda-spark");
+    std::printf("  \"runtime_commit\": \"%s\",\n", "9222e55");
+    std::printf("  \"trunk_gguf_path\": \"%s\",\n", json_escape(trunk_path).c_str());
+    std::printf("  \"mtp_sidecar_path\": \"%s\",\n", json_escape(sidecar_path).c_str());
+    std::printf("  \"prompt\": \"%s\",\n", json_escape(prompt).c_str());
+
+    if (trunk_pre_hc_head.got) {
+        std::printf("  \"trunk_pre_hc_head_fnv64\": \"%s\",\n",
+                hex_u64(fnv1a64(trunk_pre_hc_head.bytes.data(), trunk_pre_hc_head.bytes.size())).c_str());
+        std::printf("  \"trunk_pre_hc_head_nbytes\": %zu,\n", trunk_pre_hc_head.bytes.size());
+        std::printf("  \"trunk_pre_hc_head_shape\": [%lld, %lld, %lld],\n",
+                (long long) trunk_pre_hc_head.ne0,
+                (long long) trunk_pre_hc_head.ne1,
+                (long long) trunk_pre_hc_head.ne2);
+    } else {
+        std::printf("  \"trunk_pre_hc_head_fnv64\": null,\n");
+        std::printf("  \"trunk_pre_hc_head_nbytes\": null,\n");
+        std::printf("  \"trunk_pre_hc_head_shape\": null,\n");
+    }
+
+    std::printf("  \"seed\": %d,\n", (int) seed);
+    std::printf("  \"temperature\": 0.0,\n");
+    std::printf("  \"top_k\": 1,\n");
+    std::printf("  \"top_p\": 1.0,\n");
+    std::printf("  \"verify_step_idx\": 0,\n");
+    std::printf("  \"base_next_token_id\": %d,\n", (int) base_next_token_id);
+    std::printf("  \"base_next_token\": \"%s\",\n", json_escape(base_next_token).c_str());
+    std::printf("  \"mtp_draft_token_id\": %d,\n", (int) mtp_draft_token_id);
+    std::printf("  \"mtp_draft_token\": \"%s\",\n", json_escape(mtp_draft_token).c_str());
+    std::printf("  \"mtp_params\": {\n");
+    std::printf("    \"n_embd\": 4096,\n");
+    std::printf("    \"n_head\": 64,\n");
+    std::printf("    \"n_head_dim\": 512,\n");
+    std::printf("    \"n_hc\": 4,\n");
+    std::printf("    \"n_lora_q\": 1024,\n");
+    std::printf("    \"n_out_group\": 8,\n");
+    std::printf("    \"n_lora_o\": 1024,\n");
+    std::printf("    \"n_expert\": 256,\n");
+    std::printf("    \"n_ff_exp\": 2048\n");
+    std::printf("  },\n");
+    std::printf("  \"ok\": %s,\n", ok ? "true" : "false");
+    std::printf("  \"errors\": [\n");
+    for (size_t i = 0; i < errors.size(); i++) {
+        std::printf("    \"%s\"%s\n", json_escape(errors[i]).c_str(), (i + 1 < errors.size()) ? "," : "");
+    }
+    std::printf("  ]\n");
+    std::printf("}\n");
+}
+
+
+int main(int argc, char ** argv) {
+    std::setlocale(LC_NUMERIC, "C");
+
+    std::string trunk_path;
+    std::string sidecar_path;
+    std::string prompt = "Hello.";
+    int32_t seed = 1234;
+    bool json = false;
+
+    for (int i = 1; i < argc; i++) {
+        if (std::strcmp(argv[i], "--model") == 0) {
+            if (i + 1 >= argc) {
+                usage(argv[0]);
+                return 1;
+            }
+            trunk_path = argv[++i];
+        } else if (std::strcmp(argv[i], "--sidecar") == 0) {
+            if (i + 1 >= argc) {
+                usage(argv[0]);
+                return 1;
+            }
+            sidecar_path = argv[++i];
+        } else if (std::strcmp(argv[i], "--prompt") == 0) {
+            if (i + 1 >= argc) {
+                usage(argv[0]);
+                return 1;
+            }
+            prompt = argv[++i];
+        } else if (std::strcmp(argv[i], "--seed") == 0) {
+            if (i + 1 >= argc) {
+                usage(argv[0]);
+                return 1;
+            }
+            seed = (int32_t) std::strtol(argv[++i], nullptr, 10);
+        } else if (std::strcmp(argv[i], "--json") == 0) {
+            json = true;
+        } else {
+            usage(argv[0]);
+            return 1;
+        }
+    }
+
+    if (trunk_path.empty() || sidecar_path.empty()) {
+        usage(argv[0]);
+        return 1;
+    }
+
+    std::vector<std::string> errors;
+
+    pre_hc_head_capture pre_hc_head;
+
+    ggml_backend_load_all();
+
+    llama_model_params model_params = llama_model_default_params();
+    model_params.n_gpu_layers = 99;
+
+    llama_model * model = llama_model_load_from_file(trunk_path.c_str(), model_params);
+    if (model == nullptr) {
+        errors.push_back("failed to load trunk model");
+        if (json) {
+            print_probe_json(trunk_path, sidecar_path, prompt, seed, -1, "", -1, "", pre_hc_head, false, errors);
+        }
+        return 2;
+    }
+
+    const llama_vocab * vocab = llama_model_get_vocab(model);
+
+    const int32_t n_prompt = -llama_tokenize(vocab, prompt.c_str(), (int) prompt.size(), nullptr, 0, true, true);
+    if (n_prompt <= 0) {
+        errors.push_back("failed to tokenize prompt");
+        if (json) {
+            print_probe_json(trunk_path, sidecar_path, prompt, seed, -1, "", -1, "", pre_hc_head, false, errors);
+        }
+        llama_model_free(model);
+        return 3;
+    }
+
+    std::vector<llama_token> prompt_tokens((size_t) n_prompt);
+    if (llama_tokenize(vocab, prompt.c_str(), (int) prompt.size(), prompt_tokens.data(), (int) prompt_tokens.size(), true, true) < 0) {
+        errors.push_back("failed to tokenize prompt (2nd pass)");
+        if (json) {
+            print_probe_json(trunk_path, sidecar_path, prompt, seed, -1, "", -1, "", pre_hc_head, false, errors);
+        }
+        llama_model_free(model);
+        return 4;
+    }
+
+    llama_context_params ctx_params = llama_context_default_params();
+    ctx_params.n_ctx = (uint32_t) (prompt_tokens.size() + 8);
+    ctx_params.n_batch = (uint32_t) prompt_tokens.size();
+    ctx_params.n_ubatch = ctx_params.n_batch;
+    ctx_params.no_perf = true;
+    ctx_params.cb_eval = capture_pre_hc_head;
+    ctx_params.cb_eval_user_data = &pre_hc_head;
+
+    llama_context * ctx = llama_init_from_model(model, ctx_params);
+    if (ctx == nullptr) {
+        errors.push_back("failed to init llama_context");
+        if (json) {
+            print_probe_json(trunk_path, sidecar_path, prompt, seed, -1, "", -1, "", pre_hc_head, false, errors);
+        }
+        llama_model_free(model);
+        return 5;
+    }
+
+    llama_batch batch = llama_batch_get_one(prompt_tokens.data(), prompt_tokens.size());
+    if (llama_decode(ctx, batch) != 0) {
+        errors.push_back("llama_decode failed for prompt");
+        if (json) {
+            print_probe_json(trunk_path, sidecar_path, prompt, seed, -1, "", -1, "", pre_hc_head, false, errors);
+        }
+        llama_free(ctx);
+        llama_model_free(model);
+        return 6;
+    }
+
+    const int32_t n_vocab = llama_vocab_n_tokens(vocab);
+    const float * logits = llama_get_logits_ith(ctx, -1);
+    const int32_t base_next_token_id = argmax_f32(logits, n_vocab);
+    const std::string base_next_token = token_to_piece(vocab, (llama_token) base_next_token_id);
+
+    pre_hc_head.got = false;
+    pre_hc_head.bytes.clear();
+
+    llama_token base_token = (llama_token) base_next_token_id;
+    llama_batch base_batch = llama_batch_get_one(&base_token, 1);
+    if (llama_decode(ctx, base_batch) != 0) {
+        errors.push_back("llama_decode failed for base_next_token_id commit");
+    }
+
+    struct ggml_context * sidecar_ctx = nullptr;
+    struct gguf_init_params params = {
+        /*no_alloc=*/ true,
+        /*ctx=*/ &sidecar_ctx,
+    };
+
+    struct gguf_context * sidecar_gguf = gguf_init_from_file(sidecar_path.c_str(), params);
+    if (sidecar_gguf == nullptr || sidecar_ctx == nullptr) {
+        errors.push_back("failed to open sidecar GGUF (metadata-only)");
+        if (json) {
+            print_probe_json(trunk_path, sidecar_path, prompt, seed, base_next_token_id, base_next_token, -1, "", pre_hc_head, false, errors);
+        }
+        if (sidecar_gguf) {
+            gguf_free(sidecar_gguf);
+        }
+        if (sidecar_ctx) {
+            ggml_free(sidecar_ctx);
+        }
+        llama_free(ctx);
+        llama_model_free(model);
+        return 7;
+    }
+
+    const int64_t arch_kid = gguf_find_key(sidecar_gguf, "general.architecture");
+    if (arch_kid < 0) {
+        errors.push_back("sidecar missing key: general.architecture");
+    } else if (std::strcmp(gguf_get_val_str(sidecar_gguf, arch_kid), "deepseek4_mtp_support") != 0) {
+        errors.push_back("sidecar general.architecture != deepseek4_mtp_support");
+    }
+
+    ds4::deepseek4_mtp_sidecar sidecar;
+    std::string bind_err;
+    const bool bind_ok = ds4::bind_deepseek4_mtp_sidecar(&sidecar, sidecar_ctx, &bind_err);
+    if (!bind_ok) {
+        errors.push_back(std::string("sidecar bind failed: ") + bind_err);
+    }
+
+    gguf_free(sidecar_gguf);
+    ggml_free(sidecar_ctx);
+
+    errors.push_back("TODO: implement gamma=1 MTP draft compute using sidecar weights + pre-hc_head hidden buffer");
+
+    if (json) {
+        print_probe_json(trunk_path, sidecar_path, prompt, seed, base_next_token_id, base_next_token, -1, "", pre_hc_head, false, errors);
+    }
+
+    llama_free(ctx);
+    llama_model_free(model);
+
+    return 0;
+}
