+
+	s->ffn_down_shexp = ggml_get_tensor(ctx, "mtp.0.ffn_down_shexp.weight");
+	if (s->ffn_down_shexp == nullptr) {
+		if (err != nullptr) *err = "missing tensor: mtp.0.ffn_down_shexp.weight";
