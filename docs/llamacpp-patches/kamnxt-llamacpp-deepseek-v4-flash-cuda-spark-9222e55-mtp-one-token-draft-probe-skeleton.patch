+	if (!(s->ffn_gate_shexp->n_dims == 2 && s->ffn_gate_shexp->ne[0] == 4096 && s->ffn_gate_shexp->ne[1] == 2048)) {
+		if (err != nullptr) *err = "tensor has unexpected dims: mtp.0.ffn_gate_shexp.weight";
