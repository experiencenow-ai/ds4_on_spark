+	if (!(s->ffn_down_exps->n_dims == 3 && s->ffn_down_exps->ne[0] == 2048 && s->ffn_down_exps->ne[1] == 4096 && s->ffn_down_exps->ne[2] == 256)) {
+		if (err != nullptr) *err = "tensor has unexpected dims: mtp.0.ffn_down_exps.weight";
