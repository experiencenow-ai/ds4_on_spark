+
+	s->ffn_down_exps = ggml_get_tensor(ctx, "mtp.0.ffn_down_exps.weight");
+	if (s->ffn_down_exps == nullptr) {
+		if (err != nullptr) *err = "missing tensor: mtp.0.ffn_down_exps.weight";
