+		return false;
+	}
+	if (!(s->ffn_up_exps->n_dims == 3 && s->ffn_up_exps->ne[0] == 4096 && s->ffn_up_exps->ne[1] == 2048 && s->ffn_up_exps->ne[2] == 256)) {
+		if (err != nullptr) *err = "tensor has unexpected dims: mtp.0.ffn_up_exps.weight";
