@@ -0,0 +1,584 @@
+#include "gguf.h"
+#include "ggml.h"
+
+#include <algorithm>
+#include <cinttypes>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <cstdint>
+#include <string>
+#include <unordered_set>
+#include <vector>
+
+static void usage(const char * prog) {
+    std::fprintf(stderr, "usage: %s --path <mtp_sidecar.gguf> [--json] [--payload-sample-bytes N] [--load-weights]\n", prog);
+}
+
+static std::string json_escape(const std::string & s) {
+    std::string out;
+    out.reserve(s.size() + 8);
+    for (const char c : s) {
+        switch (c) {
+            case '\\': out += "\\\\"; break;
+            case '"':  out += "\\\""; break;
+            case '\n': out += "\\n"; break;
+            case '\r': out += "\\r"; break;
+            case '\t': out += "\\t"; break;
+            default: out += c; break;
+        }
+    }
+    return out;
+}
+
+static uint64_t fnv1a64(const uint8_t * data, size_t len) {
+    uint64_t h = 1469598103934665603ULL;
+    for (size_t i = 0; i < len; i++) {
+        h ^= (uint64_t) data[i];
+        h *= 1099511628211ULL;
+    }
+    return h;
+}
+
+static bool read_file_bytes(FILE * fp, size_t offs, uint8_t * dst, size_t len) {
+    if (fp == nullptr || dst == nullptr) {
+        return false;
+    }
+    if (std::fseek(fp, (long) offs, SEEK_SET) != 0) {
+        return false;
+    }
+    return std::fread(dst, 1, len, fp) == len;
+}
+
+static bool tensor_dims_eq(const ggml_tensor * t, const std::vector<int64_t> & want) {
+    if (t == nullptr) {
+        return false;
+    }
+    if (t->n_dims != (int) want.size()) {
+        return false;
+    }
+    for (int i = 0; i < t->n_dims; i++) {
+        if (t->ne[i] != want[i]) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool tensor_is_1d_len(const ggml_tensor * t, int64_t n) {
+    return tensor_dims_eq(t, { n });
+}
+
+static bool tensor_is_2d(const ggml_tensor * t, int64_t a, int64_t b) {
+    return tensor_dims_eq(t, { a, b });
+}
+
+static bool tensor_is_3d(const ggml_tensor * t, int64_t a, int64_t b, int64_t c) {
+    return tensor_dims_eq(t, { a, b, c });
+}
+
+static const std::vector<std::string> & expected_tensor_names() {
+    static const std::vector<std::string> k = {
+        "mtp.0.attn_kv.weight",
+        "mtp.0.attn_kv_a_norm.weight",
+        "mtp.0.attn_norm.weight",
+        "mtp.0.attn_output_a.weight",
+        "mtp.0.attn_output_b.weight",
+        "mtp.0.attn_q_a.weight",
+        "mtp.0.attn_q_a_norm.weight",
+        "mtp.0.attn_q_b.weight",
+        "mtp.0.attn_sinks.weight",
+        "mtp.0.e_proj.weight",
+        "mtp.0.enorm.weight",
+        "mtp.0.exp_probs_b.bias",
+        "mtp.0.ffn_down_exps.weight",
+        "mtp.0.ffn_down_shexp.weight",
+        "mtp.0.ffn_gate_exps.weight",
+        "mtp.0.ffn_gate_inp.weight",
+        "mtp.0.ffn_gate_shexp.weight",
+        "mtp.0.ffn_norm.weight",
+        "mtp.0.ffn_up_exps.weight",
+        "mtp.0.ffn_up_shexp.weight",
+        "mtp.0.h_proj.weight",
+        "mtp.0.hc_attn_base.weight",
+        "mtp.0.hc_attn_fn.weight",
+        "mtp.0.hc_attn_scale.weight",
+        "mtp.0.hc_ffn_base.weight",
+        "mtp.0.hc_ffn_fn.weight",
+        "mtp.0.hc_ffn_scale.weight",
+        "mtp.0.hc_head_base.weight",
+        "mtp.0.hc_head_fn.weight",
+        "mtp.0.hc_head_scale.weight",
+        "mtp.0.hnorm.weight",
+        "mtp.0.norm.weight",
+    };
+
+    return k;
+}
+
+int main(int argc, char ** argv) {
+    std::string path;
+    bool json = false;
+    bool load_weights = false;
+    int payload_sample_bytes = 0;
+
+    for (int i = 1; i < argc; i++) {
+        const char * arg = argv[i];
+
+        if ((std::strcmp(arg, "--path") == 0 || std::strcmp(arg, "-p") == 0) && i + 1 < argc) {
+            path = argv[++i];
+            continue;
+        }
+
+        if (std::strcmp(arg, "--json") == 0) {
+            json = true;
+            continue;
+        }
+
+        if (std::strcmp(arg, "--payload-sample-bytes") == 0 && i + 1 < argc) {
+            payload_sample_bytes = std::atoi(argv[++i]);
+            if (payload_sample_bytes < 0) {
+                std::fprintf(stderr, "payload-sample-bytes must be >= 0\n");
+                return 2;
+            }
+            continue;
+        }
+
+        if (std::strcmp(arg, "--load-weights") == 0) {
+            load_weights = true;
+            continue;
+        }
+
+        if (std::strcmp(arg, "-h") == 0 || std::strcmp(arg, "--help") == 0) {
+            usage(argv[0]);
+            return 0;
+        }
+
+        std::fprintf(stderr, "unknown arg: %s\n", arg);
+        usage(argv[0]);
+        return 2;
+    }
+
+    if (path.empty()) {
+        usage(argv[0]);
+        return 2;
+    }
+
+    std::vector<std::string> errors;
+
+    ggml_context * ctx_meta = nullptr;
+    gguf_init_params params = {
+        /*.no_alloc =*/ !load_weights,
+        /*.ctx      =*/ &ctx_meta,
+    };
+
+    gguf_context * ctx_gguf = gguf_init_from_file(path.c_str(), params);
+
+    if (ctx_gguf == nullptr) {
+        std::fprintf(stderr, "failed to open gguf: %s\n", path.c_str());
+        return 1;
+    }
+
+    std::string arch;
+    {
+        const int kid = gguf_find_key(ctx_gguf, "general.architecture");
+        if (kid < 0 || gguf_get_kv_type(ctx_gguf, kid) != GGUF_TYPE_STRING) {
+            errors.push_back("missing metadata key general.architecture");
+        } else {
+            arch = gguf_get_val_str(ctx_gguf, kid);
+            if (arch != "deepseek4_mtp_support") {
+                errors.push_back("general.architecture is '" + arch + "', expected 'deepseek4_mtp_support'");
+            }
+        }
+    }
+
+    const int64_t n_tensors = gguf_get_n_tensors(ctx_gguf);
+
+    // verify expected tensor set
+    std::unordered_set<std::string> expected;
+    expected.reserve(expected_tensor_names().size());
+    for (const auto & n : expected_tensor_names()) {
+        expected.insert(n);
+    }
+
+    std::vector<std::string> missing;
+    for (const auto & n : expected_tensor_names()) {
+        if (gguf_find_tensor(ctx_gguf, n.c_str()) < 0) {
+            missing.push_back(n);
+        }
+    }
+
+    std::vector<std::string> extra;
+    for (int64_t i = 0; i < n_tensors; i++) {
+        const char * n = gguf_get_tensor_name(ctx_gguf, i);
+        if (n == nullptr) {
+            continue;
+        }
+        if (expected.find(std::string(n)) == expected.end()) {
+            extra.push_back(n);
+        }
+    }
+
+    if (!missing.empty()) {
+        errors.push_back("missing expected mtp.0.* tensors (see missing[])");
+    }
+
+    if (!extra.empty()) {
+        errors.push_back("unexpected extra tensors present (see extra[])");
+    }
+
+    if (load_weights) {
+        if (ctx_meta == nullptr) {
+            errors.push_back("internal error: missing ggml weights context");
+        } else {
+            for (const auto & name : expected_tensor_names()) {
+                const ggml_tensor * t = ggml_get_tensor(ctx_meta, name.c_str());
+                if (t == nullptr) {
+                    errors.push_back("load weights: missing tensor '" + name + "'");
+                    continue;
+                }
+                if (t->data == nullptr) {
+                    errors.push_back("load weights: tensor has null data pointer '" + name + "'");
+                }
+            }
+        }
+    }
+
+    // light self-consistency checks (derived only from the 32 tensor shapes)
+    int64_t n_embd = -1;
+    int64_t n_head = -1;
+    int64_t n_head_dim = -1;
+    int64_t n_lora_q = -1;
+    int64_t q_dim = -1;
+    int64_t n_expert = -1;
+    int64_t n_ff_exp = -1;
+    int64_t n_hc = -1;
+
+    if (ctx_meta != nullptr) {
+        const ggml_tensor * t_norm = ggml_get_tensor(ctx_meta, "mtp.0.norm.weight");
+        if (t_norm != nullptr && t_norm->n_dims == 1) {
+            n_embd = t_norm->ne[0];
+        }
+
+        const ggml_tensor * t_sinks = ggml_get_tensor(ctx_meta, "mtp.0.attn_sinks.weight");
+        if (t_sinks != nullptr && t_sinks->n_dims == 1) {
+            n_head = t_sinks->ne[0];
+        }
+
+        const ggml_tensor * t_kv = ggml_get_tensor(ctx_meta, "mtp.0.attn_kv.weight");
+        if (t_kv != nullptr && t_kv->n_dims == 2) {
+            n_head_dim = t_kv->ne[1];
+        }
+
+        const ggml_tensor * t_q_a = ggml_get_tensor(ctx_meta, "mtp.0.attn_q_a.weight");
+        if (t_q_a != nullptr && t_q_a->n_dims == 2) {
+            n_lora_q = t_q_a->ne[1];
+        }
+
+        const ggml_tensor * t_q_b = ggml_get_tensor(ctx_meta, "mtp.0.attn_q_b.weight");
+        if (t_q_b != nullptr && t_q_b->n_dims == 2) {
+            q_dim = t_q_b->ne[1];
+        }
+
+        const ggml_tensor * t_exp_bias = ggml_get_tensor(ctx_meta, "mtp.0.exp_probs_b.bias");
+        if (t_exp_bias != nullptr && t_exp_bias->n_dims == 1) {
+            n_expert = t_exp_bias->ne[0];
+        }
+
+        const ggml_tensor * t_up_exps = ggml_get_tensor(ctx_meta, "mtp.0.ffn_up_exps.weight");
+        if (t_up_exps != nullptr && t_up_exps->n_dims == 3) {
+            n_ff_exp = t_up_exps->ne[1];
+        }
+
+        const ggml_tensor * t_hc_head_base = ggml_get_tensor(ctx_meta, "mtp.0.hc_head_base.weight");
+        if (t_hc_head_base != nullptr && t_hc_head_base->n_dims == 1) {
+            n_hc = t_hc_head_base->ne[0];
+        }
+
+        if (n_embd > 0) {
+            const ggml_tensor * t_attn_norm = ggml_get_tensor(ctx_meta, "mtp.0.attn_norm.weight");
+            const ggml_tensor * t_ffn_norm = ggml_get_tensor(ctx_meta, "mtp.0.ffn_norm.weight");
+            const ggml_tensor * t_enorm = ggml_get_tensor(ctx_meta, "mtp.0.enorm.weight");
+            const ggml_tensor * t_hnorm = ggml_get_tensor(ctx_meta, "mtp.0.hnorm.weight");
+            const ggml_tensor * t_norm2 = ggml_get_tensor(ctx_meta, "mtp.0.norm.weight");
+
+            if (!tensor_is_1d_len(t_attn_norm, n_embd)) errors.push_back("shape mismatch: mtp.0.attn_norm.weight");
+            if (!tensor_is_1d_len(t_ffn_norm,  n_embd)) errors.push_back("shape mismatch: mtp.0.ffn_norm.weight");
+            if (!tensor_is_1d_len(t_enorm,     n_embd)) errors.push_back("shape mismatch: mtp.0.enorm.weight");
+            if (!tensor_is_1d_len(t_hnorm,     n_embd)) errors.push_back("shape mismatch: mtp.0.hnorm.weight");
+            if (!tensor_is_1d_len(t_norm2,     n_embd)) errors.push_back("shape mismatch: mtp.0.norm.weight");
+
+            const ggml_tensor * t_eproj = ggml_get_tensor(ctx_meta, "mtp.0.e_proj.weight");
+            const ggml_tensor * t_hproj = ggml_get_tensor(ctx_meta, "mtp.0.h_proj.weight");
+            if (!tensor_is_2d(t_eproj, n_embd, n_embd)) errors.push_back("shape mismatch: mtp.0.e_proj.weight");
+            if (!tensor_is_2d(t_hproj, n_embd, n_embd)) errors.push_back("shape mismatch: mtp.0.h_proj.weight");
+
+            const ggml_tensor * t_attn_out_a = ggml_get_tensor(ctx_meta, "mtp.0.attn_output_a.weight");
+            const ggml_tensor * t_attn_out_b = ggml_get_tensor(ctx_meta, "mtp.0.attn_output_b.weight");
+            if (t_attn_out_a && t_attn_out_a->n_dims == 2) {
+                if (t_attn_out_a->ne[0] != n_embd) errors.push_back("shape mismatch: mtp.0.attn_output_a.weight");
+            }
+            if (t_attn_out_b && t_attn_out_b->n_dims == 2) {
+                if (t_attn_out_b->ne[1] != n_embd) errors.push_back("shape mismatch: mtp.0.attn_output_b.weight");
+            }
+            if (t_attn_out_a && t_attn_out_a->n_dims == 2 && t_attn_out_b && t_attn_out_b->n_dims == 2) {
+                if (t_attn_out_a->ne[1] != t_attn_out_b->ne[0]) errors.push_back("shape mismatch: mtp.0.attn_output_{a,b}.weight");
+            }
+        }
+
+        if (n_lora_q > 0) {
+            const ggml_tensor * t_q_a_norm = ggml_get_tensor(ctx_meta, "mtp.0.attn_q_a_norm.weight");
+            if (!tensor_is_1d_len(t_q_a_norm, n_lora_q)) errors.push_back("shape mismatch: mtp.0.attn_q_a_norm.weight");
+        }
+
+        if (n_embd > 0 && n_lora_q > 0) {
+            const ggml_tensor * t_q_a = ggml_get_tensor(ctx_meta, "mtp.0.attn_q_a.weight");
+            if (!tensor_is_2d(t_q_a, n_embd, n_lora_q)) errors.push_back("shape mismatch: mtp.0.attn_q_a.weight");
+        }
+
+        if (n_embd > 0 && n_head_dim > 0) {
+            const ggml_tensor * t_kv = ggml_get_tensor(ctx_meta, "mtp.0.attn_kv.weight");
+            if (!tensor_is_2d(t_kv, n_embd, n_head_dim)) errors.push_back("shape mismatch: mtp.0.attn_kv.weight");
+        }
+
+        if (n_head_dim > 0) {
+            const ggml_tensor * t_kv_a_norm = ggml_get_tensor(ctx_meta, "mtp.0.attn_kv_a_norm.weight");
+            if (!tensor_is_1d_len(t_kv_a_norm, n_head_dim)) errors.push_back("shape mismatch: mtp.0.attn_kv_a_norm.weight");
+        }
+
+        if (n_head > 0 && n_head_dim > 0 && n_lora_q > 0) {
+            const ggml_tensor * t_q_b = ggml_get_tensor(ctx_meta, "mtp.0.attn_q_b.weight");
+            const int64_t want_out = n_head * n_head_dim;
+            if (t_q_b && t_q_b->n_dims == 2) {
+                if (t_q_b->ne[0] != n_lora_q || t_q_b->ne[1] != want_out) {
+                    errors.push_back("shape mismatch: mtp.0.attn_q_b.weight");
+                }
+            }
+        }
+
+        if (n_embd > 0 && n_expert > 0 && n_ff_exp > 0) {
+            const ggml_tensor * t_gate_exps = ggml_get_tensor(ctx_meta, "mtp.0.ffn_gate_exps.weight");
+            const ggml_tensor * t_up_exps   = ggml_get_tensor(ctx_meta, "mtp.0.ffn_up_exps.weight");
+            const ggml_tensor * t_down_exps = ggml_get_tensor(ctx_meta, "mtp.0.ffn_down_exps.weight");
+
+            if (!tensor_is_3d(t_gate_exps, n_embd, n_ff_exp, n_expert)) errors.push_back("shape mismatch: mtp.0.ffn_gate_exps.weight");
+            if (!tensor_is_3d(t_up_exps,   n_embd, n_ff_exp, n_expert)) errors.push_back("shape mismatch: mtp.0.ffn_up_exps.weight");
+            if (!tensor_is_3d(t_down_exps, n_ff_exp, n_embd, n_expert)) errors.push_back("shape mismatch: mtp.0.ffn_down_exps.weight");
+
+            const ggml_tensor * t_gate_inp = ggml_get_tensor(ctx_meta, "mtp.0.ffn_gate_inp.weight");
+            if (!tensor_is_2d(t_gate_inp, n_embd, n_expert)) errors.push_back("shape mismatch: mtp.0.ffn_gate_inp.weight");
+
+            const ggml_tensor * t_gate_shexp = ggml_get_tensor(ctx_meta, "mtp.0.ffn_gate_shexp.weight");
+            const ggml_tensor * t_up_shexp   = ggml_get_tensor(ctx_meta, "mtp.0.ffn_up_shexp.weight");
+            const ggml_tensor * t_down_shexp = ggml_get_tensor(ctx_meta, "mtp.0.ffn_down_shexp.weight");
+            if (!tensor_is_2d(t_gate_shexp, n_embd, n_ff_exp)) errors.push_back("shape mismatch: mtp.0.ffn_gate_shexp.weight");
+            if (!tensor_is_2d(t_up_shexp,   n_embd, n_ff_exp)) errors.push_back("shape mismatch: mtp.0.ffn_up_shexp.weight");
+            if (!tensor_is_2d(t_down_shexp, n_ff_exp, n_embd)) errors.push_back("shape mismatch: mtp.0.ffn_down_shexp.weight");
+        }
+
+        if (n_hc > 0) {
+            const int64_t hc_dim = (n_embd > 0 ? n_embd * n_hc : -1);
+            const int64_t hc_mix_dim = (2 * n_hc) + (n_hc * n_hc);
+
+            const ggml_tensor * t_hc_attn_scale = ggml_get_tensor(ctx_meta, "mtp.0.hc_attn_scale.weight");
+            const ggml_tensor * t_hc_ffn_scale  = ggml_get_tensor(ctx_meta, "mtp.0.hc_ffn_scale.weight");
+            const ggml_tensor * t_hc_head_scale = ggml_get_tensor(ctx_meta, "mtp.0.hc_head_scale.weight");
+
+            if (!tensor_is_1d_len(t_hc_attn_scale, 3)) errors.push_back("shape mismatch: mtp.0.hc_attn_scale.weight");
+            if (!tensor_is_1d_len(t_hc_ffn_scale,  3)) errors.push_back("shape mismatch: mtp.0.hc_ffn_scale.weight");
+            if (!tensor_is_1d_len(t_hc_head_scale, 1)) errors.push_back("shape mismatch: mtp.0.hc_head_scale.weight");
+
+            const ggml_tensor * t_hc_head_base = ggml_get_tensor(ctx_meta, "mtp.0.hc_head_base.weight");
+            const ggml_tensor * t_hc_head_fn   = ggml_get_tensor(ctx_meta, "mtp.0.hc_head_fn.weight");
+            if (!tensor_is_1d_len(t_hc_head_base, n_hc)) errors.push_back("shape mismatch: mtp.0.hc_head_base.weight");
+            if (hc_dim > 0) {
+                if (!tensor_is_2d(t_hc_head_fn, hc_dim, n_hc)) errors.push_back("shape mismatch: mtp.0.hc_head_fn.weight");
+            }
+
+            if (hc_dim > 0) {
+                const ggml_tensor * t_hc_attn_fn   = ggml_get_tensor(ctx_meta, "mtp.0.hc_attn_fn.weight");
+                const ggml_tensor * t_hc_attn_base = ggml_get_tensor(ctx_meta, "mtp.0.hc_attn_base.weight");
+                const ggml_tensor * t_hc_ffn_fn    = ggml_get_tensor(ctx_meta, "mtp.0.hc_ffn_fn.weight");
+                const ggml_tensor * t_hc_ffn_base  = ggml_get_tensor(ctx_meta, "mtp.0.hc_ffn_base.weight");
+
+                if (!tensor_is_2d(t_hc_attn_fn, hc_dim, hc_mix_dim)) errors.push_back("shape mismatch: mtp.0.hc_attn_fn.weight");
+                if (!tensor_is_1d_len(t_hc_attn_base, hc_mix_dim)) errors.push_back("shape mismatch: mtp.0.hc_attn_base.weight");
+                if (!tensor_is_2d(t_hc_ffn_fn, hc_dim, hc_mix_dim)) errors.push_back("shape mismatch: mtp.0.hc_ffn_fn.weight");
+                if (!tensor_is_1d_len(t_hc_ffn_base, hc_mix_dim)) errors.push_back("shape mismatch: mtp.0.hc_ffn_base.weight");
+            }
+        }
+    }
+
+    struct payload_sample_entry {
+        std::string name;
+        uint64_t hash = 0;
+        size_t n = 0;
+    };
+
+    std::vector<payload_sample_entry> payload_samples;
+    if (payload_sample_bytes > 0) {
+        FILE * fp = std::fopen(path.c_str(), "rb");
+        if (fp == nullptr) {
+            errors.push_back("failed to open file for payload sampling");
+        } else if (ctx_meta == nullptr) {
+            errors.push_back("internal error: missing ggml metadata context");
+        } else {
+            payload_samples.reserve(expected_tensor_names().size());
+            std::vector<uint8_t> buf((size_t) payload_sample_bytes);
+
+            for (const auto & name : expected_tensor_names()) {
+                const int64_t tid = gguf_find_tensor(ctx_gguf, name.c_str());
+                if (tid < 0) {
+                    continue;
+                }
+
+                const ggml_tensor * t = ggml_get_tensor(ctx_meta, name.c_str());
+                if (t == nullptr) {
+                    errors.push_back("payload sample: missing tensor meta for '" + name + "'");
+                    continue;
+                }
+
+                const size_t nbytes = (size_t) ggml_nbytes(t);
+                const size_t nread = std::min(nbytes, (size_t) payload_sample_bytes);
+                const size_t offs = gguf_get_data_offset(ctx_gguf) + gguf_get_tensor_offset(ctx_gguf, tid);
+
+                if (!read_file_bytes(fp, offs, buf.data(), nread)) {
+                    errors.push_back("payload sample: failed to read '" + name + "'");
+                    continue;
+                }
+
+                payload_sample_entry e;
+                e.name = name;
+                e.n = nread;
+                e.hash = fnv1a64(buf.data(), nread);
+                payload_samples.push_back(std::move(e));
+            }
+        }
+
+        if (fp != nullptr) {
+            std::fclose(fp);
+        }
+    }
+
+    const bool ok = errors.empty() && missing.empty() && extra.empty();
+
+    if (!json) {
+        if (ok) {
+            std::printf("ok=true\n");
+            std::printf("architecture=%s\n", arch.empty() ? "(missing)" : arch.c_str());
+            std::printf("tensor_count=%" PRId64 "\n", n_tensors);
+            if (payload_sample_bytes > 0) {
+                std::printf("payload_sample_bytes=%d\n", payload_sample_bytes);
+                for (const auto & e : payload_samples) {
+                    std::printf("payload_sample=%s:%016" PRIx64 ":%zu\n", e.name.c_str(), e.hash, e.n);
+                }
+            }
+        } else {
+            std::printf("ok=false\n");
+            for (const auto & e : errors) {
+                std::printf("error=%s\n", e.c_str());
+            }
+            if (!missing.empty()) {
+                std::printf("missing=%zu\n", missing.size());
+                for (const auto & n : missing) {
+                    std::printf("missing_tensor=%s\n", n.c_str());
+                }
+            }
+            if (!extra.empty()) {
+                std::printf("extra=%zu\n", extra.size());
+                for (const auto & n : extra) {
+                    std::printf("extra_tensor=%s\n", n.c_str());
+                }
+            }
+        }
+    } else {
+        std::printf("{\n");
+        std::printf("  \"ok\": %s,\n", ok ? "true" : "false");
+        std::printf("  \"path\": \"%s\",\n", json_escape(path).c_str());
+        std::printf("  \"architecture\": \"%s\",\n", json_escape(arch).c_str());
+        std::printf("  \"tensor_count\": %" PRId64 ",\n", n_tensors);
+        std::printf("  \"payload_sample_bytes\": %d,\n", payload_sample_bytes);
+        std::printf("  \"load_weights\": %s,\n", load_weights ? "true" : "false");
+
+        std::printf("  \"derived_params\": {");
+        std::printf("\"n_embd\":%" PRId64 ",", (n_embd > 0 ? n_embd : 0));
+        std::printf("\"n_head\":%" PRId64 ",", (n_head > 0 ? n_head : 0));
+        std::printf("\"n_head_dim\":%" PRId64 ",", (n_head_dim > 0 ? n_head_dim : 0));
+        std::printf("\"n_hc\":%" PRId64 ",", (n_hc > 0 ? n_hc : 0));
+        std::printf("\"n_lora_q\":%" PRId64 ",", (n_lora_q > 0 ? n_lora_q : 0));
+        std::printf("\"q_dim\":%" PRId64 ",", (q_dim > 0 ? q_dim : 0));
+        std::printf("\"n_expert\":%" PRId64 ",", (n_expert > 0 ? n_expert : 0));
+        std::printf("\"n_ff_exp\":%" PRId64 "", (n_ff_exp > 0 ? n_ff_exp : 0));
+        std::printf("},\n");
+
+        std::printf("  \"tensors\": [");
+        const auto & want = expected_tensor_names();
+        for (size_t i = 0; i < want.size(); i++) {
+            if (i) std::printf(", ");
+            const std::string & name = want[i];
+            const int64_t tid = gguf_find_tensor(ctx_gguf, name.c_str());
+            const ggml_tensor * t = (ctx_meta != nullptr) ? ggml_get_tensor(ctx_meta, name.c_str()) : nullptr;
+
+            std::printf("{\"name\":\"%s\"", json_escape(name).c_str());
+            std::printf(",\"present\":%s", (tid >= 0 && t != nullptr) ? "true" : "false");
+
+            if (tid >= 0 && t != nullptr) {
+                const size_t offs = gguf_get_data_offset(ctx_gguf) + gguf_get_tensor_offset(ctx_gguf, tid);
+
+                std::printf(",\"type\":%d", (int) t->type);
+                std::printf(",\"n_dims\":%d", t->n_dims);
+                std::printf(",\"dims\":[");
+                for (int d = 0; d < t->n_dims; d++) {
+                    if (d) std::printf(",");
+                    std::printf("%" PRId64, t->ne[d]);
+                }
+                std::printf("]");
+                std::printf(",\"nbytes\":%zu", (size_t) ggml_nbytes(t));
+                std::printf(",\"offset\":%zu", offs);
+                std::printf(",\"has_data\":%s", t->data != nullptr ? "true" : "false");
+            }
+
+            std::printf("}");
+        }
+        std::printf("],\n");
+
+        std::printf("  \"missing\": [");
+        for (size_t i = 0; i < missing.size(); i++) {
+            if (i) std::printf(", ");
+            std::printf("\"%s\"", json_escape(missing[i]).c_str());
+        }
+        std::printf("],\n");
+
+        std::printf("  \"extra\": [");
+        for (size_t i = 0; i < extra.size(); i++) {
+            if (i) std::printf(", ");
+            std::printf("\"%s\"", json_escape(extra[i]).c_str());
+        }
+        std::printf("],\n");
+
+        std::printf("  \"errors\": [");
+        for (size_t i = 0; i < errors.size(); i++) {
+            if (i) std::printf(", ");
+            std::printf("\"%s\"", json_escape(errors[i]).c_str());
+        }
+        std::printf("],\n");
+
+        std::printf("  \"payload_samples\": [");
+        for (size_t i = 0; i < payload_samples.size(); i++) {
+            if (i) std::printf(", ");
+            std::printf("{\"name\":\"%s\",\"fnv1a64\":\"%016" PRIx64 "\",\"n\":%zu}",
+                json_escape(payload_samples[i].name).c_str(),
+                payload_samples[i].hash,
+                payload_samples[i].n);
+        }
+        std::printf("]\n");
+        std::printf("}\n");
+    }
+
+    gguf_free(ctx_gguf);
+    if (ctx_meta != nullptr) {
+        ggml_free(ctx_meta);
+    }
+
+    return ok ? 0 : 3;
+}
