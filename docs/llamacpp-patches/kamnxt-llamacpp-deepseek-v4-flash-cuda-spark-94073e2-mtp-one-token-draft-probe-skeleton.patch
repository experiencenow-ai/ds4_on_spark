+int main(int argc, char ** argv) {
+    std::setlocale(LC_NUMERIC, "C");
+
+    std::string trunk_path;
+    std::string sidecar_path;
+    std::string prompt = "Hello.";
+    int32_t seed = 1234;
+    bool json = false;
+    bool load_sidecar_weights = false;
+
+    for (int i = 1; i < argc; i++) {
+        if (std::strcmp(argv[i], "--model") == 0) {
+            if (i + 1 >= argc) {
+                usage(argv[0]);
+                return 1;
+            }
+            trunk_path = argv[++i];
+        } else if (std::strcmp(argv[i], "--sidecar") == 0) {
+            if (i + 1 >= argc) {
+                usage(argv[0]);
+                return 1;
+            }
+            sidecar_path = argv[++i];
+        } else if (std::strcmp(argv[i], "--prompt") == 0) {
+            if (i + 1 >= argc) {
+                usage(argv[0]);
+                return 1;
+            }
+            prompt = argv[++i];
+        } else if (std::strcmp(argv[i], "--seed") == 0) {
+            if (i + 1 >= argc) {
+                usage(argv[0]);
+                return 1;
+            }
+            seed = (int32_t) std::strtol(argv[++i], nullptr, 10);
+        } else if (std::strcmp(argv[i], "--json") == 0) {
+            json = true;
+        } else if (std::strcmp(argv[i], "--load-sidecar-weights") == 0) {
+            load_sidecar_weights = true;
+        } else {
+            usage(argv[0]);
+            return 1;
+        }
+    }
+
+    if (trunk_path.empty() || sidecar_path.empty()) {
+        usage(argv[0]);
+        return 1;
+    }
+
+    std::vector<std::string> errors;
+
+    probe_captures caps;
+    mtp_stub_input_hc_captures stub_input_hc;
+    tensor_capture stub_head_norm;
+
+    ggml_backend_load_all();
+
+    llama_model_params model_params = llama_model_default_params();
+    model_params.n_gpu_layers = 99;
+
+    static llama_model_tensor_buft_override tensor_overrides[] = {
+        { "output\\.weight", ggml_backend_cpu_buffer_type() },
+        { nullptr, nullptr },
+    };
+    model_params.tensor_buft_overrides = tensor_overrides;
+
+    llama_model * model = llama_model_load_from_file(trunk_path.c_str(), model_params);
+    if (model == nullptr) {
+        errors.push_back("failed to load trunk model");
+        if (json) {
+            print_probe_json(trunk_path, sidecar_path, prompt, seed, -1, "", -1, "", caps.token_embd, caps.pre_hc_head, stub_input_hc, stub_head_norm, false, errors);
+        }
+        return 2;
+    }
+
+    const llama_vocab * vocab = llama_model_get_vocab(model);
+
+    const int32_t n_prompt = -llama_tokenize(vocab, prompt.c_str(), (int) prompt.size(), nullptr, 0, true, true);
+    if (n_prompt <= 0) {
+        errors.push_back("failed to tokenize prompt");
+        if (json) {
+            print_probe_json(trunk_path, sidecar_path, prompt, seed, -1, "", -1, "", caps.token_embd, caps.pre_hc_head, stub_input_hc, stub_head_norm, false, errors);
+        }
+        llama_model_free(model);
+        return 3;
+    }
+
+    std::vector<llama_token> prompt_tokens((size_t) n_prompt);
+    if (llama_tokenize(vocab, prompt.c_str(), (int) prompt.size(), prompt_tokens.data(), (int) prompt_tokens.size(), true, true) < 0) {
+        errors.push_back("failed to tokenize prompt (2nd pass)");
+        if (json) {
+            print_probe_json(trunk_path, sidecar_path, prompt, seed, -1, "", -1, "", caps.token_embd, caps.pre_hc_head, stub_input_hc, stub_head_norm, false, errors);
+        }
+        llama_model_free(model);
+        return 4;
+    }
+
+    llama_context_params ctx_params = llama_context_default_params();
+    ctx_params.n_ctx = (uint32_t) (prompt_tokens.size() + 8);
+    ctx_params.n_batch = (uint32_t) prompt_tokens.size();
+    ctx_params.n_ubatch = ctx_params.n_batch;
+    ctx_params.no_perf = true;
+    ctx_params.cb_eval = capture_probe_tensors;
+    ctx_params.cb_eval_user_data = &caps;
+
+    llama_context * ctx = llama_init_from_model(model, ctx_params);
+    if (ctx == nullptr) {
+        errors.push_back("failed to init llama_context");
+        if (json) {
+            print_probe_json(trunk_path, sidecar_path, prompt, seed, -1, "", -1, "", caps.token_embd, caps.pre_hc_head, stub_input_hc, stub_head_norm, false, errors);
+        }
+        llama_model_free(model);
+        return 5;
+    }
+
+    llama_batch batch = llama_batch_get_one(prompt_tokens.data(), prompt_tokens.size());
+    if (llama_decode(ctx, batch) != 0) {
+        errors.push_back("llama_decode failed for prompt");
+        if (json) {
+            print_probe_json(trunk_path, sidecar_path, prompt, seed, -1, "", -1, "", caps.token_embd, caps.pre_hc_head, stub_input_hc, stub_head_norm, false, errors);
+        }
+        llama_free(ctx);
+        llama_model_free(model);
+        return 6;
+    }
+
+    const int32_t n_vocab = llama_vocab_n_tokens(vocab);
+    const float * logits = llama_get_logits_ith(ctx, -1);
+    const int32_t base_next_token_id = argmax_f32(logits, n_vocab);
+    const std::string base_next_token = token_to_piece(vocab, (llama_token) base_next_token_id);
+
+    caps.enable = true;
+    caps.token_embd = tensor_capture();
+    caps.pre_hc_head = tensor_capture();
+
+    llama_token base_token = (llama_token) base_next_token_id;
+    llama_batch base_batch = llama_batch_get_one(&base_token, 1);
+    if (llama_decode(ctx, base_batch) != 0) {
+        errors.push_back("llama_decode failed for base_next_token_id commit");
+    }
+
+    caps.enable = false;
+
+    struct ggml_context * sidecar_ctx = nullptr;
+    struct gguf_init_params params = {
+        /*no_alloc=*/ !load_sidecar_weights,
+        /*ctx=*/ &sidecar_ctx,
+    };
+
+    struct gguf_context * sidecar_gguf = gguf_init_from_file(sidecar_path.c_str(), params);
+    if (sidecar_gguf == nullptr || sidecar_ctx == nullptr) {
+        errors.push_back("failed to open sidecar GGUF (metadata-only)");
+        if (json) {
+            print_probe_json(trunk_path, sidecar_path, prompt, seed, base_next_token_id, base_next_token, -1, "", caps.token_embd, caps.pre_hc_head, stub_input_hc, stub_head_norm, false, errors);
+        }
+        if (sidecar_gguf) {
+            gguf_free(sidecar_gguf);
+        }
+        if (sidecar_ctx) {
+            ggml_free(sidecar_ctx);
+        }
+        llama_free(ctx);
+        llama_model_free(model);
+        return 7;
+    }
+
+    const int64_t arch_kid = gguf_find_key(sidecar_gguf, "general.architecture");
+    if (arch_kid < 0) {
+        errors.push_back("sidecar missing key: general.architecture");
+    } else if (std::strcmp(gguf_get_val_str(sidecar_gguf, arch_kid), "deepseek4_mtp_support") != 0) {
+        errors.push_back("sidecar general.architecture != deepseek4_mtp_support");
+    }
+
+    ds4::deepseek4_mtp_sidecar sidecar;
+    std::string bind_err;
+    const bool bind_ok = ds4::bind_deepseek4_mtp_sidecar(&sidecar, sidecar_ctx, &bind_err);
+    if (!bind_ok) {
+        errors.push_back(std::string("sidecar bind failed: ") + bind_err);
+    }
+
+    int32_t mtp_stub_token_id = -1;
+    std::string mtp_stub_token;
+
+    if (load_sidecar_weights && bind_ok) {
+        std::string stub_err;
+        if (!compute_stub_mtp_input_hc(caps.token_embd, caps.pre_hc_head, sidecar, model->hparams, &stub_input_hc, &stub_err)) {
+            errors.push_back(std::string("stub mtp input_hc compute failed: ") + stub_err);
+        }
+        if (!compute_stub_mtp_output_head_norm(caps.pre_hc_head, sidecar, model->hparams, &stub_head_norm, &stub_err)) {
+            errors.push_back(std::string("stub output head compute failed: ") + stub_err);
+        }
+        if (stub_head_norm.got) {
+            if (!compute_argmax_logits_from_output(stub_head_norm, model, &mtp_stub_token_id, &stub_err)) {
+                errors.push_back(std::string("stub head-only draft token failed: ") + stub_err);
+            } else {
+                mtp_stub_token = token_to_piece(vocab, (llama_token) mtp_stub_token_id);
+            }
+        }
+    } else {
+        errors.push_back("stub mtp compute skipped (requires --load-sidecar-weights + successful bind)");
+    }
+
+    gguf_free(sidecar_gguf);
+    ggml_free(sidecar_ctx);
+
+    errors.push_back("TODO: implement gamma=1 MTP draft compute using sidecar weights + MTP KV/raw-cache state");
+
+    if (json) {
+        print_probe_json(trunk_path, sidecar_path, prompt, seed, base_next_token_id, base_next_token, mtp_stub_token_id, mtp_stub_token, caps.token_embd, caps.pre_hc_head, stub_input_hc, stub_head_norm, false, errors);
+    }
+
+    llama_free(ctx);
