+static bool capture_probe_tensors(struct ggml_tensor * t, bool ask, void * user_data) {
+    if (t == nullptr || user_data == nullptr) {
+        return false;
+    }
+
+    auto * caps = (probe_captures *) user_data;
+    const bool want_token_embd = std::strcmp(t->name, "result_token_embd") == 0;
+    const bool want_pre_hc_head = std::strcmp(t->name, "result_pre_hc_head") == 0;
+    if (!want_token_embd && !want_pre_hc_head) {
+        return ask ? false : true;
+    }
+
+    if (ask) {
+        return caps->enable;
+    }
+    if (!caps->enable) {
+        return true;
+    }
+
+    tensor_capture * cap = want_token_embd ? &caps->token_embd : &caps->pre_hc_head;
+    const size_t n_bytes = ggml_nbytes(t);
+
+    cap->bytes.resize(n_bytes);
+    ggml_backend_tensor_get(t, cap->bytes.data(), 0, n_bytes);
+    cap->type = t->type;
+    cap->ne0 = t->ne[0];
+    cap->ne1 = t->ne[1];
+    cap->ne2 = t->ne[2];
+    cap->ne3 = t->ne[3];
+    cap->got = true;
+
+    return true;
+}
