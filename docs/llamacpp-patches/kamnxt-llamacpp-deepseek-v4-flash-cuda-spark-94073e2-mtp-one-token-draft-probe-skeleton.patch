+    if (prompt.rfind(bos, 0) == 0) {
+        return prompt;
+    }
+    std::string rendered;
+    rendered.reserve(prompt.size() + 96);
+    rendered += bos;
+    rendered += "You are a helpful assistant";
+    rendered += "<｜User｜>";
+    rendered += prompt;
+    rendered += "<｜Assistant｜><think>";
