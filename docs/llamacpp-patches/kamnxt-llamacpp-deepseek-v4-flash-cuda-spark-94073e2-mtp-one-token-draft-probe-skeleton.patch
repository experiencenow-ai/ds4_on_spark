+static bool compute_stub_mtp_input_hc(
+        const tensor_capture & trunk_token_embd,
+        const tensor_capture & trunk_pre_hc_head,
+        const ds4::deepseek4_mtp_sidecar & sidecar,
+        const llama_hparams & hparams,
+        mtp_stub_input_hc_captures * out,
+        std::string * err) {
+    if (out == nullptr) {
+        if (err != nullptr) *err = "null out";
+        return false;
+    }
+    *out = mtp_stub_input_hc_captures();
+
+    if (!trunk_token_embd.got) {
+        if (err != nullptr) *err = "missing trunk token_embd capture";
+        return false;
+    }
+    if (!trunk_pre_hc_head.got) {
+        if (err != nullptr) *err = "missing trunk pre_hc_head capture";
+        return false;
+    }
+    if (trunk_token_embd.type != GGML_TYPE_F32) {
+        if (err != nullptr) *err = "trunk token_embd is not f32";
+        return false;
+    }
+    if (trunk_pre_hc_head.type != GGML_TYPE_F32) {
+        if (err != nullptr) *err = "trunk pre_hc_head is not f32";
+        return false;
+    }
+    if (!(trunk_token_embd.ne0 == 4096 && trunk_token_embd.ne1 == 1 && trunk_token_embd.ne2 == 1)) {
+        if (err != nullptr) *err = "trunk token_embd has unexpected shape";
+        return false;
+    }
+    if (!(trunk_pre_hc_head.ne0 == 4096 && trunk_pre_hc_head.ne1 == 4 && trunk_pre_hc_head.ne2 == 1)) {
+        if (err != nullptr) *err = "trunk pre_hc_head has unexpected shape";
+        return false;
+    }
+
+    ggml_init_params ip = {};
+    ip.mem_size = 512 * 1024 * 1024;
+    ip.mem_buffer = nullptr;
+    ip.no_alloc = false;
+
+    ggml_context * ctx = ggml_init(ip);
+    if (ctx == nullptr) {
+        if (err != nullptr) *err = "ggml_init failed";
+        return false;
+    }
+
+    ggml_tensor * tok = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 4096, 1);
+    if (tok == nullptr || tok->data == nullptr) {
+        if (err != nullptr) *err = "failed to alloc stub tok";
+        ggml_free(ctx);
+        return false;
+    }
+    if (trunk_token_embd.bytes.size() != ggml_nbytes(tok)) {
+        if (err != nullptr) *err = "trunk token_embd nbytes mismatch";
+        ggml_free(ctx);
+        return false;
+    }
+    std::memcpy(tok->data, trunk_token_embd.bytes.data(), trunk_token_embd.bytes.size());
+
+    ggml_tensor * prev = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 4096, 4);
+    if (prev == nullptr || prev->data == nullptr) {
+        if (err != nullptr) *err = "failed to alloc stub prev";
+        ggml_free(ctx);
+        return false;
+    }
+    if (trunk_pre_hc_head.bytes.size() != ggml_nbytes(prev)) {
+        if (err != nullptr) *err = "trunk pre_hc_head nbytes mismatch (prev)";
+        ggml_free(ctx);
+        return false;
+    }
+    std::memcpy(prev->data, trunk_pre_hc_head.bytes.data(), trunk_pre_hc_head.bytes.size());
+
+    ggml_tensor * mtp_enorm = ggml_rms_norm(ctx, tok, hparams.f_norm_rms_eps);
+    mtp_enorm = ggml_mul(ctx, mtp_enorm, sidecar.enorm);
+    mtp_enorm = ggml_cont(ctx, mtp_enorm);
+
+    ggml_tensor * mtp_eproj = ggml_mul_mat(ctx, sidecar.e_proj, mtp_enorm); // [n_embd, 1]
+    mtp_eproj = ggml_cont(ctx, mtp_eproj);
+
+    ggml_tensor * mtp_eproj_hc = ggml_repeat(ctx, mtp_eproj, prev); // [n_embd, n_hc]
+    mtp_eproj_hc = ggml_cont(ctx, mtp_eproj_hc);
+
+    ggml_tensor * mtp_hnorm_hc = ggml_rms_norm(ctx, prev, hparams.f_norm_rms_eps);
+    mtp_hnorm_hc = ggml_mul(ctx, mtp_hnorm_hc, sidecar.hnorm);
+    mtp_hnorm_hc = ggml_cont(ctx, mtp_hnorm_hc);
+
+    ggml_tensor * mtp_hproj_hc = ggml_mul_mat(ctx, sidecar.h_proj, mtp_hnorm_hc); // [n_embd, n_hc]
+    mtp_hproj_hc = ggml_cont(ctx, mtp_hproj_hc);
+
+    ggml_tensor * mtp_input_hc = ggml_add(ctx, mtp_eproj_hc, mtp_hproj_hc);
+    mtp_input_hc = ggml_cont(ctx, mtp_input_hc);
+    mtp_input_hc = ggml_reshape_3d(ctx, mtp_input_hc, 4096, 4, 1);
+
+    ggml_cgraph * gf = ggml_new_graph(ctx);
+    ggml_build_forward_expand(gf, mtp_input_hc);
+    ggml_graph_compute_with_ctx(ctx, gf, 1);
+
+    if (!capture_tensor_host_bytes(mtp_enorm, &out->mtp_enorm)
+            || !capture_tensor_host_bytes(mtp_eproj, &out->mtp_eproj)
+            || !capture_tensor_host_bytes(mtp_eproj_hc, &out->mtp_eproj_hc)
+            || !capture_tensor_host_bytes(mtp_hnorm_hc, &out->mtp_hnorm_hc)
+            || !capture_tensor_host_bytes(mtp_hproj_hc, &out->mtp_hproj_hc)
+            || !capture_tensor_host_bytes(mtp_input_hc, &out->mtp_input_hc)) {
+        if (err != nullptr) *err = "failed to capture stub mtp_input_hc intermediates";
+        ggml_free(ctx);
+        return false;
+    }
+
+    ggml_free(ctx);
+    return true;
+}
