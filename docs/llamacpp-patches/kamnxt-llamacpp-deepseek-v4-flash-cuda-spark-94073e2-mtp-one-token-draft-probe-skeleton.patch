+static ggml_tensor * dsv4_grouped_out(
+        ggml_context * ctx,
+        ggml_tensor  * o,
+        ggml_tensor  * wo_a,
+        ggml_tensor  * wo_b,
+        int64_t        n_embd_head,
+        int64_t        n_head,
+        int64_t        n_groups,
+        int64_t        o_lora_rank,
+        int64_t        n_tokens) {
+    const int64_t group_heads = n_head / n_groups;
+    const int64_t group_dim = n_embd_head * group_heads;
+    o = ggml_cont(ctx, o);
+    o = ggml_reshape_3d(ctx, o, group_dim, n_groups, n_tokens);
+    ggml_tensor * wo_a_g = ggml_reshape_3d(ctx, wo_a, group_dim, o_lora_rank, n_groups);
+    ggml_tensor * ids = ggml_arange(ctx, 0.0f, float(n_groups), 1.0f);
+    ids = ggml_cast(ctx, ids, GGML_TYPE_I32);
+    ids = ggml_repeat_4d(ctx, ids, n_groups, n_tokens, 1, 1);
+    ggml_tensor * low = ggml_mul_mat_id(ctx, wo_a_g, o, ids);
+    low = ggml_reshape_2d(ctx, low, o_lora_rank * n_groups, n_tokens);
+    return ggml_mul_mat(ctx, wo_b, low);
+}
+
+static ggml_tensor * dsv4_attn_mha_one(
+        ggml_context * ctx,
+        ggml_tensor  * q,
+        ggml_tensor  * k,
+        ggml_tensor  * v,
+        ggml_tensor  * sinks,
+        const llama_hparams & hparams,
+        float          kq_scale) {
+    const bool v_trans = v->nb[1] > v->nb[2];
+    q = ggml_view_4d(ctx, q, q->ne[0], q->ne[1], q->ne[2], 1, q->nb[1], q->nb[2], q->nb[3], 0);
+    q = ggml_permute(ctx, q, 0, 2, 1, 3);
+    k = ggml_permute(ctx, k, 0, 2, 1, 3);
+    v = ggml_permute(ctx, v, 0, 2, 1, 3);
+    ggml_tensor * kq = ggml_mul_mat(ctx, k, q);
+    ggml_mul_mat_set_prec(kq, GGML_PREC_F32);
+    if (hparams.attn_soft_cap) {
+        kq = ggml_scale(ctx, kq, 1.0f / hparams.f_attn_logit_softcapping);
+        kq = ggml_tanh(ctx, kq);
+        kq = ggml_scale(ctx, kq, hparams.f_attn_logit_softcapping);
+    }
+    kq = ggml_soft_max_ext(ctx, kq, nullptr, kq_scale, hparams.f_max_alibi_bias);
+    ggml_soft_max_add_sinks(kq, sinks);
+    if (!v_trans) {
+        v = ggml_cont(ctx, ggml_transpose(ctx, v));
+    }
+    ggml_tensor * kqv = ggml_mul_mat(ctx, v, kq);
+    ggml_tensor * cur = ggml_permute(ctx, kqv, 0, 2, 1, 3);
+    return ggml_cont_2d(ctx, cur, cur->ne[0] * cur->ne[1], cur->ne[2] * cur->ne[3]);
+}
+
+static float dsv4_swiglu_limit(const llama_hparams & hparams) {
+    for (float v : hparams.swiglu_clamp_exp) {
+        if (v > 1.0e-6f) {
+            return v;
+        }
+    }
+    return 10.0f;
+}
+
+static ggml_tensor * dsv4_moe_ffn_one(
+        ggml_context * ctx,
+        ggml_tensor  * cur,
+        const ds4::deepseek4_mtp_sidecar & sidecar,
+        const llama_hparams & hparams) {
+    const int64_t n_embd = 4096;
+    const int64_t n_tokens = 1;
+    const int64_t n_expert = hparams.n_expert > 0 ? hparams.n_expert : 256;
+    const int64_t n_expert_used = hparams.n_expert_used > 0 ? hparams.n_expert_used : 8;
+    ggml_tensor * logits = ggml_mul_mat(ctx, sidecar.ffn_gate_inp, cur);
+    ggml_tensor * probs = ggml_sigmoid(ctx, logits);
+    ggml_tensor * selection_probs = ggml_add(ctx, probs, sidecar.exp_probs_b_bias);
+    ggml_tensor * selected = ggml_argsort_top_k(ctx, selection_probs, n_expert_used);
+    ggml_tensor * probs3 = ggml_reshape_3d(ctx, probs, 1, n_expert, n_tokens);
+    ggml_tensor * weights = ggml_get_rows(ctx, probs3, selected);
+    weights = ggml_reshape_2d(ctx, weights, n_expert_used, n_tokens);
+    ggml_tensor * weights_sum = ggml_sum_rows(ctx, weights);
+    weights_sum = ggml_clamp(ctx, weights_sum, 6.103515625e-5, INFINITY);
+    weights = ggml_div(ctx, weights, weights_sum);
+    if (hparams.expert_weights_scale != 0.0f && hparams.expert_weights_scale != 1.0f) {
+        weights = ggml_scale(ctx, weights, hparams.expert_weights_scale);
+    }
+    weights = ggml_reshape_3d(ctx, weights, 1, n_expert_used, n_tokens);
+    cur = ggml_reshape_3d(ctx, cur, n_embd, 1, n_tokens);
+    ggml_tensor * up = ggml_mul_mat_id(ctx, sidecar.ffn_up_exps, cur, selected);
+    ggml_tensor * gate = ggml_mul_mat_id(ctx, sidecar.ffn_gate_exps, cur, selected);
+    const float limit = dsv4_swiglu_limit(hparams);
+    gate = ggml_clamp(ctx, gate, -INFINITY, limit);
+    gate = ggml_silu(ctx, gate);
+    up = ggml_clamp(ctx, up, -limit, limit);
+    cur = ggml_mul(ctx, gate, up);
+    cur = ggml_mul(ctx, cur, weights);
+    ggml_tensor * experts = ggml_mul_mat_id(ctx, sidecar.ffn_down_exps, cur, selected);
+    ggml_tensor * out = ggml_view_2d(ctx, experts, n_embd, n_tokens, experts->nb[2], 0);
+    for (int64_t i = 1; i < n_expert_used; i++) {
+        ggml_tensor * v = ggml_view_2d(ctx, experts, n_embd, n_tokens, experts->nb[2], i * experts->nb[1]);
+        out = ggml_add(ctx, out, v);
+    }
+    return out;
+}
+
+static ggml_tensor * dsv4_shared_ffn_one(
+        ggml_context * ctx,
+        ggml_tensor  * cur,
+        const ds4::deepseek4_mtp_sidecar & sidecar) {
+    ggml_tensor * gate = ggml_mul_mat(ctx, sidecar.ffn_gate_shexp, cur);
+    ggml_tensor * up = ggml_mul_mat(ctx, sidecar.ffn_up_shexp, cur);
+    cur = ggml_swiglu_split(ctx, gate, up);
+    return ggml_mul_mat(ctx, sidecar.ffn_down_shexp, cur);
+}
+
+static bool compute_mtp_gamma1_block(
+        const tensor_capture & mtp_input_hc,
+        const ds4::deepseek4_mtp_sidecar & sidecar,
+        const llama_hparams & hparams,
+        int32_t position,
+        tensor_capture * block_out_hc,
+        tensor_capture * head_norm,
+        std::string * err) {
+    if (!mtp_input_hc.got) {
+        if (err != nullptr) *err = "missing mtp input_hc";
+        return false;
+    }
+    if (!(mtp_input_hc.ne0 == 4096 && mtp_input_hc.ne1 == 4 && mtp_input_hc.ne2 == 1)) {
+        if (err != nullptr) *err = "mtp input_hc has unexpected shape";
+        return false;
+    }
+    ggml_init_params ip = {};
+    ip.mem_size = 1024ull * 1024ull * 1024ull;
+    ip.mem_buffer = nullptr;
+    ip.no_alloc = false;
+    ggml_context * ctx = ggml_init(ip);
+    if (ctx == nullptr) {
+        if (err != nullptr) *err = "ggml_init failed";
+        return false;
+    }
+    ggml_tensor * pos = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, 1);
+    if (pos == nullptr || pos->data == nullptr) {
+        if (err != nullptr) *err = "failed to alloc pos";
+        ggml_free(ctx);
+        return false;
+    }
+    ((int32_t *) pos->data)[0] = position;
+    ggml_tensor * inp = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, 4096, 4, 1);
+    if (inp == nullptr || inp->data == nullptr) {
+        if (err != nullptr) *err = "failed to alloc input_hc";
+        ggml_free(ctx);
+        return false;
+    }
+    if (mtp_input_hc.bytes.size() != ggml_nbytes(inp)) {
+        if (err != nullptr) *err = "mtp input_hc nbytes mismatch";
+        ggml_free(ctx);
+        return false;
+    }
+    std::memcpy(inp->data, mtp_input_hc.bytes.data(), mtp_input_hc.bytes.size());
+    const int64_t n_embd = 4096;
+    const int64_t n_hc = 4;
+    const int64_t n_tokens = 1;
+    const int64_t n_head = 64;
+    const int64_t n_embd_head = 512;
+    const int64_t n_lora_o = 1024;
+    const int64_t n_out_group = 8;
+    const int64_t n_rot = hparams.n_rot();
+    const int rope_type = (int) hparams.rope_type;
+    const float freq_base = hparams.rope_freq_base_train;
+    const float kq_scale = 1.0f / std::sqrt((float) n_embd_head);
+    ggml_tensor * residual = inp;
+    dsv4_hc_mix mix = dsv4_hc_pre(ctx, inp, sidecar.hc_attn_fn, sidecar.hc_attn_scale, sidecar.hc_attn_base, n_embd, n_hc, n_tokens, hparams.f_norm_rms_eps, hparams.hc_sinkhorn_iters, hparams.hc_eps);
+    ggml_tensor * cur = ggml_rms_norm(ctx, mix.x, hparams.f_norm_rms_eps);
+    cur = ggml_mul(ctx, cur, sidecar.attn_norm);
+    ggml_tensor * qr = ggml_mul_mat(ctx, sidecar.attn_q_a, cur);
+    qr = ggml_rms_norm(ctx, qr, hparams.f_norm_rms_eps);
+    qr = ggml_mul(ctx, qr, sidecar.attn_q_a_norm);
+    ggml_tensor * q = ggml_mul_mat(ctx, sidecar.attn_q_b, qr);
+    q = ggml_reshape_3d(ctx, q, n_embd_head, n_head, n_tokens);
+    q = ggml_rms_norm(ctx, q, hparams.f_norm_rms_eps);
+    q = dsv4_apply_rope_tail(ctx, q, pos, n_embd_head, n_head, n_tokens, n_rot, rope_type, freq_base, false);
+    ggml_tensor * kv = ggml_mul_mat(ctx, sidecar.attn_kv, cur);
+    kv = ggml_rms_norm(ctx, kv, hparams.f_norm_rms_eps);
+    kv = ggml_mul(ctx, kv, sidecar.attn_kv_a_norm);
+    kv = ggml_reshape_3d(ctx, kv, n_embd_head, 1, n_tokens);
+    kv = dsv4_apply_rope_tail(ctx, kv, pos, n_embd_head, 1, n_tokens, n_rot, rope_type, freq_base, false);
+    cur = dsv4_attn_mha_one(ctx, q, kv, kv, sidecar.attn_sinks, hparams, kq_scale);
+    cur = ggml_reshape_3d(ctx, cur, n_embd_head, n_head, n_tokens);
+    cur = dsv4_apply_rope_tail(ctx, cur, pos, n_embd_head, n_head, n_tokens, n_rot, rope_type, freq_base, true);
+    cur = dsv4_grouped_out(ctx, cur, sidecar.attn_output_a, sidecar.attn_output_b, n_embd_head, n_head, n_out_group, n_lora_o, n_tokens);
+    ggml_tensor * after_attn = dsv4_hc_post(ctx, cur, residual, mix.post, mix.comb);
+    residual = after_attn;
+    mix = dsv4_hc_pre(ctx, after_attn, sidecar.hc_ffn_fn, sidecar.hc_ffn_scale, sidecar.hc_ffn_base, n_embd, n_hc, n_tokens, hparams.f_norm_rms_eps, hparams.hc_sinkhorn_iters, hparams.hc_eps);
+    cur = ggml_rms_norm(ctx, mix.x, hparams.f_norm_rms_eps);
+    cur = ggml_mul(ctx, cur, sidecar.ffn_norm);
+    ggml_tensor * moe = dsv4_moe_ffn_one(ctx, cur, sidecar, hparams);
+    ggml_tensor * shexp = dsv4_shared_ffn_one(ctx, cur, sidecar);
+    cur = ggml_add(ctx, moe, shexp);
+    ggml_tensor * block = dsv4_hc_post(ctx, cur, residual, mix.post, mix.comb);
+    ggml_tensor * head = dsv4_hc_head(ctx, block, sidecar.hc_head_fn, sidecar.hc_head_scale, sidecar.hc_head_base, n_embd, n_hc, n_tokens, hparams.f_norm_rms_eps, hparams.hc_eps);
+    head = ggml_rms_norm(ctx, head, hparams.f_norm_rms_eps);
+    head = ggml_mul(ctx, head, sidecar.norm);
+    ggml_cgraph * gf = ggml_new_graph(ctx);
+    ggml_build_forward_expand(gf, head);
+    ggml_graph_compute_with_ctx(ctx, gf, 4);
+    bool ok = capture_graph_tensor(block, block_out_hc, err);
+    if (ok) {
+        ok = capture_graph_tensor(head, head_norm, err);
+    }
+    ggml_free(ctx);
+    return ok;
+}
+
+static bool compute_stub_mtp_input_hc(
+        const tensor_capture & trunk_token_embd,
+        const tensor_capture & trunk_pre_hc_head,
+        const ds4::deepseek4_mtp_sidecar & sidecar,
+        const llama_hparams & hparams,
+        tensor_capture * out,
+        std::string * err) {
+    if (out == nullptr) {
+        if (err != nullptr) *err = "null out";
+        return false;
+    }
+    *out = tensor_capture();
+
+    if (!trunk_token_embd.got) {
+        if (err != nullptr) *err = "missing trunk token_embd capture";
+        return false;
+    }
+    if (!trunk_pre_hc_head.got) {
+        if (err != nullptr) *err = "missing trunk pre_hc_head capture";
+        return false;
+    }
+    if (trunk_token_embd.type != GGML_TYPE_F32) {
+        if (err != nullptr) *err = "trunk token_embd is not f32";
+        return false;
+    }
+    if (trunk_pre_hc_head.type != GGML_TYPE_F32) {
+        if (err != nullptr) *err = "trunk pre_hc_head is not f32";
+        return false;
+    }
+    if (!(trunk_token_embd.ne0 == 4096 && trunk_token_embd.ne1 == 1 && trunk_token_embd.ne2 == 1)) {
+        if (err != nullptr) *err = "trunk token_embd has unexpected shape";
+        return false;
+    }
+    if (!(trunk_pre_hc_head.ne0 == 4096 && trunk_pre_hc_head.ne1 == 4 && trunk_pre_hc_head.ne2 == 1)) {
+        if (err != nullptr) *err = "trunk pre_hc_head has unexpected shape";
+        return false;
+    }
+
+    ggml_init_params ip = {};
+    ip.mem_size = 512 * 1024 * 1024;
+    ip.mem_buffer = nullptr;
+    ip.no_alloc = false;
+
+    ggml_context * ctx = ggml_init(ip);
+    if (ctx == nullptr) {
+        if (err != nullptr) *err = "ggml_init failed";
+        return false;
+    }
+
+    ggml_tensor * tok = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 4096, 1);
+    if (tok == nullptr || tok->data == nullptr) {
+        if (err != nullptr) *err = "failed to alloc stub tok";
+        ggml_free(ctx);
+        return false;
+    }
+    if (trunk_token_embd.bytes.size() != ggml_nbytes(tok)) {
+        if (err != nullptr) *err = "trunk token_embd nbytes mismatch";
+        ggml_free(ctx);
+        return false;
+    }
+    std::memcpy(tok->data, trunk_token_embd.bytes.data(), trunk_token_embd.bytes.size());
+
+    ggml_tensor * prev = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 4096, 4);
+    if (prev == nullptr || prev->data == nullptr) {
+        if (err != nullptr) *err = "failed to alloc stub prev";
+        ggml_free(ctx);
+        return false;
+    }
+    if (trunk_pre_hc_head.bytes.size() != ggml_nbytes(prev)) {
+        if (err != nullptr) *err = "trunk pre_hc_head nbytes mismatch (prev)";
+        ggml_free(ctx);
+        return false;
+    }
+    std::memcpy(prev->data, trunk_pre_hc_head.bytes.data(), trunk_pre_hc_head.bytes.size());
+
+    ggml_tensor * e = ggml_rms_norm(ctx, tok, hparams.f_norm_rms_eps);
+    e = ggml_mul(ctx, e, sidecar.enorm);
+    e = ggml_mul_mat(ctx, sidecar.e_proj, e); // [n_embd, 1]
+
+    ggml_tensor * e_hc = ggml_repeat(ctx, e, prev); // [n_embd, n_hc]
+
+    ggml_tensor * h = ggml_rms_norm(ctx, prev, hparams.f_norm_rms_eps);
+    h = ggml_mul(ctx, h, sidecar.hnorm);
+    h = ggml_mul_mat(ctx, sidecar.h_proj, h); // [n_embd, n_hc]
+
+    ggml_tensor * cur = ggml_add(ctx, e_hc, h);
+    cur = ggml_reshape_3d(ctx, cur, 4096, 4, 1);
+
+    ggml_cgraph * gf = ggml_new_graph(ctx);
+    ggml_build_forward_expand(gf, cur);
+    ggml_graph_compute_with_ctx(ctx, gf, 1);
+
+    const size_t n_bytes = ggml_nbytes(cur);
+    out->bytes.resize(n_bytes);
+    std::memcpy(out->bytes.data(), cur->data, n_bytes);
+    out->type = cur->type;
+    out->ne0 = cur->ne[0];
+    out->ne1 = cur->ne[1];
+    out->ne2 = cur->ne[2];
+    out->ne3 = cur->ne[3];
+    out->got = true;
+
+    ggml_free(ctx);
+    return true;
+}
