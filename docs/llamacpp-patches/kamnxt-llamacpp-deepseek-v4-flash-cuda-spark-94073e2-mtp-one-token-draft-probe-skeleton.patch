+struct tensor_capture {
+    bool got = false;
+    ggml_type type = GGML_TYPE_F32;
+    int64_t ne0 = 0;
+    int64_t ne1 = 0;
+    int64_t ne2 = 0;
+    int64_t ne3 = 0;
