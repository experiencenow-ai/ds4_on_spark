+    std::memcpy(x->data, trunk_pre_hc_head.bytes.data(), trunk_pre_hc_head.bytes.size());
+
+    ggml_tensor * cur = dsv4_hc_head(ctx, x,
+            sidecar.hc_head_fn, sidecar.hc_head_scale, sidecar.hc_head_base,
+            4096, 4, 1, hparams.f_norm_rms_eps, hparams.hc_eps);
+    cur = ggml_rms_norm(ctx, cur, hparams.f_norm_rms_eps);
+    cur = ggml_mul(ctx, cur, sidecar.norm);
+
+    ggml_cgraph * gf = ggml_new_graph(ctx);
+    ggml_build_forward_expand(gf, cur);
+    ggml_graph_compute_with_ctx(ctx, gf, 1);
+
+    const size_t n_bytes = ggml_nbytes(cur);
+    out->bytes.resize(n_bytes);
+    std::memcpy(out->bytes.data(), cur->data, n_bytes);
+    out->type = cur->type;
+    out->ne0 = cur->ne[0];
+    out->ne1 = cur->ne[1];
+    out->ne2 = cur->ne[2];
+    out->ne3 = cur->ne[3];
+    out->got = true;
+
+    ggml_free(ctx);
+    return true;
+}
+
+static bool capture_probe_tensors(struct ggml_tensor * t, bool ask, void * user_data) {
+    if (t == nullptr || user_data == nullptr) {
+        return false;
+    }
+
+    auto * caps = (probe_captures *) user_data;
+    const bool want_token_embd = std::strcmp(t->name, "result_token_embd") == 0;
+    const bool want_pre_hc_head = std::strcmp(t->name, "result_pre_hc_head") == 0;
+    if (!want_token_embd && !want_pre_hc_head) {
+        return ask ? false : true;
+    }
+
+    if (ask) {
+        return caps->enable;
+    }
+    if (!caps->enable) {
+        return true;
+    }
+
+    tensor_capture * cap = want_token_embd ? &caps->token_embd : &caps->pre_hc_head;
+    const size_t n_bytes = ggml_nbytes(t);
+
+    cap->bytes.resize(n_bytes);
+    ggml_backend_tensor_get(t, cap->bytes.data(), 0, n_bytes);
+    cap->type = t->type;
+    cap->ne0 = t->ne[0];
+    cap->ne1 = t->ne[1];
+    cap->ne2 = t->ne[2];
+    cap->ne3 = t->ne[3];
+    cap->got = true;
+
+    return true;
+}
