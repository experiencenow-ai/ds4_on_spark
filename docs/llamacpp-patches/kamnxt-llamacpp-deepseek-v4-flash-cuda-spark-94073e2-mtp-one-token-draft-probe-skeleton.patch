+static bool compute_argmax_logits_from_output(
+        const tensor_capture & embd,
+        const llama_model * model,
+        int32_t * out_token_id,
+        std::string * err) {
+    if (out_token_id == nullptr) {
+        if (err != nullptr) *err = "null out_token_id";
+        return false;
+    }
+    *out_token_id = -1;
+
+    if (model == nullptr || model->output == nullptr) {
+        if (err != nullptr) *err = "missing model output tensor";
+        return false;
+    }
+    if (!embd.got) {
+        if (err != nullptr) *err = "missing embd capture";
+        return false;
+    }
+    if (embd.type != GGML_TYPE_F32) {
+        if (err != nullptr) *err = "embd is not f32";
+        return false;
+    }
+    if (!(embd.ne0 == (int64_t) model->hparams.n_embd && embd.ne1 == 1 && embd.ne2 == 1)) {
+        if (err != nullptr) *err = "embd has unexpected shape";
+        return false;
+    }
+
+    ggml_init_params ip = {};
+    ip.mem_size = 256 * 1024 * 1024;
+    ip.mem_buffer = nullptr;
+    ip.no_alloc = false;
+
+    ggml_context * ctx = ggml_init(ip);
+    if (ctx == nullptr) {
+        if (err != nullptr) *err = "ggml_init failed";
+        return false;
+    }
+
+    ggml_tensor * x = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, embd.ne0, 1);
+    if (x == nullptr || x->data == nullptr) {
+        if (err != nullptr) *err = "failed to alloc embd input";
+        ggml_free(ctx);
+        return false;
+    }
+    if (embd.bytes.size() != ggml_nbytes(x)) {
+        if (err != nullptr) *err = "embd nbytes mismatch";
+        ggml_free(ctx);
+        return false;
+    }
+    std::memcpy(x->data, embd.bytes.data(), embd.bytes.size());
+
+    if (model->output->data == nullptr) {
+        if (err != nullptr) *err = "model output tensor has null data (consider overriding output\\.weight to CPU buft)";
+        ggml_free(ctx);
+        return false;
+    }
+
+    ggml_tensor * logits = ggml_mul_mat(ctx, model->output, x);
+    if (logits == nullptr) {
+        if (err != nullptr) *err = "failed to build logits";
+        ggml_free(ctx);
+        return false;
+    }
+
+    ggml_cgraph * gf = ggml_new_graph(ctx);
+    ggml_build_forward_expand(gf, logits);
+    ggml_graph_compute_with_ctx(ctx, gf, 1);
+
+    if (logits->type != GGML_TYPE_F32) {
+        if (err != nullptr) *err = "logits output is not f32";
+        ggml_free(ctx);
+        return false;
+    }
+
+    const int32_t n_vocab = (int32_t) logits->ne[0];
+    if (n_vocab <= 0) {
+        if (err != nullptr) *err = "logits n_vocab <= 0";
+        ggml_free(ctx);
+        return false;
+    }
+    const float * p = (const float *) logits->data;
+    *out_token_id = argmax_f32(p, n_vocab);
+
+    ggml_free(ctx);
+    return (*out_token_id >= 0);
+}
