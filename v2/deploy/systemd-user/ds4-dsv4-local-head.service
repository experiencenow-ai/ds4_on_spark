[Unit]
Description=DS4 DSV4 local vLLM head service
After=network-online.target
Wants=network-online.target
Conflicts=ds4-dsv4-vllm.service ds4-dsv4-docker-legacy.service
StartLimitIntervalSec=1800
StartLimitBurst=2

[Service]
Type=simple
WorkingDirectory=%h/ds4_on_spark/v2
EnvironmentFile=-%h/.config/ds4/dsv4-spark45.env
ExecStart=%h/ds4_on_spark/v2/scripts/ds4_dsv4_spark45_local_vllm.sh head
Restart=on-failure
RestartSec=10
TimeoutStartSec=1200
TimeoutStopSec=120
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
