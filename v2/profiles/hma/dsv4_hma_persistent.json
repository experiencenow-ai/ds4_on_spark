{
  "connector_class": "DS4HmaPersistentConnector",
  "connector_module_path": "ds4_hma.vllm_connector",
  "cuda_visible_devices": null,
  "deployment_id": "dsv4_hma_persistent_spark4_5_experimental_v1",
  "env": {
    "DS4_HMA_EXPERIMENTAL": "1",
    "VLLM_ALLOW_LONG_MAX_MODEL_LEN": "1",
