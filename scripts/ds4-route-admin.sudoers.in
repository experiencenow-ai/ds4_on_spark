Cmnd_Alias DS4_ROUTE_ADMIN = /usr/sbin/ip route get *, /sbin/ip route get *, /usr/sbin/ip route replace *, /sbin/ip route replace *, /usr/sbin/ip route del *, /sbin/ip route del *, /usr/sbin/ip route flush cache, /sbin/ip route flush cache, /usr/sbin/ip link add ds4ring0 type dummy, /sbin/ip link add ds4ring0 type dummy, /usr/sbin/ip link set ds4ring0 up, /sbin/ip link set ds4ring0 up, /usr/sbin/ip addr replace * dev ds4ring0, /sbin/ip addr replace * dev ds4ring0, /usr/sbin/ip addr del * dev lo, /sbin/ip addr del * dev lo, /usr/sbin/sysctl -w net.ipv4.ip_forward=1, /sbin/sysctl -w net.ipv4.ip_forward=1
@DS4_USER@ ALL=(root) NOPASSWD: DS4_ROUTE_ADMIN
